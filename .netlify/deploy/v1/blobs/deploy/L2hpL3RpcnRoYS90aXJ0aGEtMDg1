/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T3528,\"])</script><script>self.__next_f.push([1,\"श्री लोद्रवा पार्श्वनाथ (सहस्त्रफणा पार्श्वनाथ). 108 पार्श्वनाथ में से 67 - श्री लोद्रवा पार्श्वनाथ।. मुलनायक:- कसौटी के पाषाण की काले रंग की पद्मासन मुद्रा में 30 इंच ऊँची व 24 इंच चौड़ी सहस्त्रफणा पार्श्वनाथ की मूर्ति। मूर्ति के सिर पर एक हजार नाग फणों का एक छत्र है, इसलिये सहस्त्रफना पार्श्वनाथ के नाम से भी जाना जाता है।. तीर्थ:- यह राजस्थान में जैसलमेर के पास लोद्रवा गांव में है।. ऐतिहासिकता:- कहा जाता है कि प्राचीन काल में यह लोद्रवपुर राजपूतों की राजधानी का एक बड़ा वैभवशाली शहर था। यहाँ भारत का प्राचीन विश्व-विद्यालय भी था। इस स्थान की विश्व में प्रतिष्ठा थी। एक समय यह राज्य सगर राजा के अधीन था। उनके श्रीधर व राजधर नामक दो पुत्र थे। इन्हिनें जैनाचार्य से प्रतिबोध पाकर जैन-धर्म अंगीकार किया था। इन्होंने यहाँ श्री चिंतामणिपार्श्वनाथ भगवान का अतिविशाल भव्य मंदिर का निर्माण करवाया था, जिसका उल्लेख विद्वान श्री सहजकीर्ति गणिवर्य द्वारा लिखित \\\"सतदल पद्मयन्त्र\\\" की प्रशस्ति में है, जो अभी भी इस मंदिर के गर्भद्वार के दाहिनी ओर स्थित है। तत्पश्चात सेठ श्री खिमसी द्वारा जीणोद्धार का कार्य प्रारम्भ होकर उनके पुत्र श्री पुनसी द्वारा सम्पूर्ण होने का उल्लेख है। कालक्रम से यहाँ के रावल भोजदेव व जैसलजी (काका-भतीजा) के बीच हुए भयंकर युद्ध के कारण पूरा शहर विध्वंस हुआ, तब इस मंदिर को भी क्षति पहुंची। विजयी जैसलजी ने अपनी नयी राजधानी बसाकर उसका नाम जैसलमेर रखा। यहाँ के राज-सम्मान प्राप्त संपन्न श्रावकों द्वारा जैसलमेर किले में मंदिरों का निर्माण करवाया गया। उस समय श्री चिंतामणि पार्श्वनाथ भगवान की प्रतिमा यहाँ से जैसलमेर ले जाकर नवनिर्मित मंदिर में पुनः प्रतिष्ठित करवायी थी, अभी भी वहां विधमान है।. दानवीर धर्मनिष्ठ सेठ श्री धीरू शाह इस प्राचीन मंदिर का पुनः जीणोद्धार का कार्य प्रारम्भ कर संघ लेकर शत्रुंजय यात्रार्थ पधारे। यात्रा से लौटे तब तक जीणोद्धार का कार्य सम्पूर्ण हो चूका था। अब वे सुन्दर, अलौकिक व अपने आप में विशिष्टता पूर्ण ऐसी प्रतिमा की खोज में थे। देवयोग से पाटण के प्रभुभक्त दो कारीगर अपने जीवनकाल की कृतियों में सर्वोत्कृष्ट कसौटी पाषाण की सहस्त्रफणा पार्श्वनाथ भगवान की अलौकिक, व अति सुन्दर दो प्रतिमाएं लेकर मुलतान जा रहे थे। तब विश्राम के लिए यहाँ रुके। रात में दैविक शक्ति से इनको स्वप्न आया कि यहाँ के सेठ धीरूशाह को ये प्रतिमाएं दे देना। उदार धीरूशाह को भी स्वप्न में इन प्रतिमाओं को लेने के लिए प्रेरणा मिली। दुसरे दिन दोनों एक दुसरे को ढूँढने निकले व मिलने पर सेठ ने दोनों प्रतिमाओं को बिना मूल्य किये प्रतिमाओं बराबर सोना देकर प्रतिमाएं प्राप्त की। इस कारण से इस प्रतिमा को \\\"अमूल्य पार्श्वनाथ\\\" भी कहते है। कारीगर लोग अत्यंत खुश हुए। जिस काष्ठ के रथ में कारीगर प्रतिमाएं लाये थे, वह अभी भी यहाँ विधमान है। जैसलमेर पंचतीर्थी का यह प्राचीनतम मुख्य तीर्थ स्थान है। यहाँ की शिल्पकला बहुत ही निराली ढंग की है। पश्चिम राजस्थान के कारीगरों ने हर स्थान पर विभिन्न ढंग की शिल्पकला का नमूना प्रस्तुत करके राजस्थान का गौरव बढाया है। प्राचीन कल्पवृक्ष के दर्शन सिर्फ यहीं पर होते है। विक्रम युग के वर्ष 1675 में इन मूर्तियों को आचार्य जिनराजगुरुजी के तत्वावधान में स्थापित किया गया था। स्थापित मूर्तियाँ आज भी वहाँ मौजूद हैं।. यह एक प्राचीन तीर्थ, जैसलमेर के पाँच पंचतीर्थों में से एक है। इस स्थान के प्रमुख चमत्कारी देवता वर्तमान में भी उपस्थित हैं और कई भाग्यशाली लोगों को धरणेंद्रदेव के दर्शन प्राप्त होते हैं। मुख्य मंदिर के चारों कोनों में छोटे चार मंदिर हैं। आदिनाथ, अजीतनाथ, सम्भवनाथ और चिंतामणि पार्श्वनाथ की मूर्तियाँ इन चार मंदिरों में स्थापित हैं। जैसा कि यह मंदिर लोद्रवा में है, इस लिए इसे \\\"लोद्रवा पार्श्वनाथ\\\" के नाम से भी जाना जाता है। इस पार्श्वनाथ को \\\"चिंतामणि पार्श्वनाथ\\\" के नाम से भी जाना जाता है। इस मंदिर का नवीनीकरण वि.स. 2034 में किया गया था। लोद्रवा पार्श्वनाथ की यह मूर्ति आकर्षक शानदार और चमत्कारी है। यहाँ कई चमत्कार होते रहते हैं। यहाँ कई बार एक 6 फीट के धरणेन्द्रदेव को देखा जाता है और कई तीर्थयात्री दर्शन प्राप्त करते हैं। भारत-पाक युद्ध के दौरान, जब पूरे युद्ध के दौरान बमबारी हो रही थी, उस दौरान धरणेन्द्रदेव को मंदिर के शिखर पर चलते हुए मन्दिर की रक्षा के लिए देखा गया था। कई लोगों ने इस घटना को देखा था।. अन्य मंदिर:- कोई अन्य मंदिर नहीं हैं, लेकिन एक दादावाड़ी है।. कला और मूर्तिकला के कार्य:- भगवान सहस्त्रफना पार्श्वनाथ ऐसी चमत्कारी और कलात्मक मूर्ति को अन्यत्र देखना कठिन है। खंभे, छत और शिखर प्रत्येक में नक्काशी कुशल शिल्प कौशल का एक ज्वलंत दृश्य प्रस्तुत करता है। धीरूशाह द्वारा निर्मित यह मंदिर कुशल शिल्प कौशल का एक सुंदर उदाहरण है। यहां की मूर्तियों को देखकर, हर किसी को लगता है कि मूर्तिकारों के बीच एक ज्वलंत सुंदरता के लिए उत्सुकता पूर्ण प्रतिस्पर्धा थी। मुख्य मेहराबदार गेट की कलात्मकता वास्तव में सुंदर है। समवसरण, अष्टापदगिरि और कल्पवृक्ष की खूबसूरत नक्काशीदार देखने लायक हैं। प्राचीन लकड़ी के रथ को भी खूबसूरती के साथ उकेरा गया है जो देखने लायक है।. दिशानिर्देश:- यहां से जैसलमेर का रेलवे स्टेशन 15 किलोमीटर की दूरी पर है। यहां पर बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं। यहाँ एक उपाश्रय भी है।. शास्त्र:- इस मंदिर का उल्लेख \\\"शतदल पद्मायंत्र\\\" और \\\"लोद्रवपुरी चिंतामणि पार्श्वनाथ स्तवन\\\" में किया गया है। लोद्रवा पार्श्वनाथ की एक मूर्ति जिरावाला तीर्थ और भीलडीयाजी तीर्थ में है। चेन्नई में वेपेरी में लोद्रवा पार्श्वनाथ का मंदिर है।. स्तुति:- आ देशनी सीमाएं विराजे देश आखो रक्षवा, तुझ मस्तके फणाने नाम तारू लोद्रवा, ज्या आवता अहनिश अहिपति भक्ति थी प्रभु भेटवा। \\\"श्री लोद्रवा पार्श्व ने भावे करूँ हुं वंदना\\\". जाप मंत्र:- \\\"ॐ ह्री अर्हम् श्री लोद्रवा पार्श्वनाथय नमः।\\\". ट्रस्ट:- श्री जैसलमेर लोद्रवपुर पार्श्वनाथ जैन श्वेताम्बर ट्रस्ट, पोस्ट: लोद्रवपुर, वाया-जैसलमेर, जिला: जैसलमेर - 345001, राजस्थान। फोन: 02992-50165, मोबाइल: 9460373142।\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/NEM6xrQ83vKJ6Czj7\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:prop