pw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"SpeakButton\\\"]\\n22:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T260f,\"])</script><script>self.__next_f.push([1,\"Shri Manmohan Parshwanath. 49. Shri Manmohan Parshwanath. Lord Manmohan Parshwanath, Kamboi, Taluka Chanasma, District Mehsana.. Main Deity: An idol of Lord Shri Manmohan Parshwanath, about 68 centimeters tall, white in color, beautifully carved with a decorative parikar, in the padmasana posture. Above the head of the idol is a canopy of 7 serpent hoods. Location: The temple is in the center of Kamboi village. Fine mirror-work has been done in the temple.. History: Kamboi is an ancient village dating from the 11th century. The village of Kamboi was gifted to Mulraj by Mulnath of Mandali, who had come from Vadiyar in Vikram Samvat 1043. The recorded history of this temple only goes back to the 17th century, but the temple itself is older than that period. A metal idol from Vikram Samvat 1638 bears the name of Kamboi village. The idols installed on either side of the Main Deity bear an inscription stating that the consecration was performed by Acharya Shri Vijaysurishwarji on the 13th day of the bright half of Vaishakh in Vikram Samvat 1659. Other idols bear the years Vikram Samvat 1504, 1505 and 1518. This striking idol of Manmohan Parshwanath was installed in the main temple in Vikram Samvat 1968. This temple has since been renovated, and the consecration ceremony was performed on the full moon day of the month of Magh in Vikram Samvat 2003. During the consecration, nectar (ami) was seen flowing from the idol of Lord Parshwanath for several hours. Thousands of people present witnessed this miracle and were spellbound. A short while later, they sensed a fragrant scent in the air and saw a fragrant rain shower outside. Even nature expressed its joy. Every year, a fair is held on the second day of the bright half of the month of Falgun. Thousands of pilgrims come from far and wide on that day. A flag is changed on the full moon day of the month of Magh. Many ancient idols continue to be found in the surrounding villages even today.. Other Temples: At present, there are no other temples here.. Art and Sculpture: This is a very ancient temple. This ancient idol of Manmohan Parshwanath is very striking, beautiful, impressive and miraculous. Based on the carving on the parikar, it is believed that this idol dates from the period of King Sampratti. The temple floor is decorated with white mirrors. The temple walls are beautifully decorated with colored mirror-work, which enhances the temple's beauty. Pilgrimage sites such as Pavapuri, Rajgir and Champapuri are beautifully and artistically depicted in framed pictures hanging on the temple walls. The ten previous births of Lord Parshwanath are also artistically depicted and are worth seeing. The scene of Muni Gajasukumal standing in kaussagga meditation, peacefully enduring fire burning atop his head while buried in the ground, must certainly be seen. Many miracles occur here. It is believed that no theft can take place in this temple. A few months after the consecration, while devotees were worshipping in the temple, they witnessed a shower of fragrant vaskshep (sacred powder) falling upon the idol of Lord Parshwanath. The same event occurred again a few months later. An incredible supernatural event occurred on the full moon day of Kartik. After the evening aarti, the temple doors were closed for the night. Suddenly, the entire temple was illuminated from outside by a divine light. People were astonished to see this and began gathering from far and wide to witness the miracle. The source of this light was unknown, and as people grew impatient to know the cause, the temple doors were opened again at 11 pm. As soon as the doors were opened, this divine light vanished. The naman (bathing water) of this impressive idol, taken or applied with faith and devotion like a medicine, cures a devotee's ailments. Once, some sadhviji maharaj sahibs were on their way to this tirtha. The sun was setting and they lost their way. It grew dark as clouds gathered in the sky. They became frightened, not knowing what to do. Suddenly they saw a light, and looking towards it, they could see the temple's flag, illuminated by this divine light. With the help of the light, they soon reached the temple. In another incident, two acharyas stayed at this temple for three consecutive days. In the afternoon there was a saffron bathing ritual. The silver leaves with which the Lord was adorned were also sprinkled with saffron. Miracles have occurred many times at this temple. At night, the sounds of music and dancing can be heard within the temple.. Directions: Kamboi is in Chanasma Taluka of Mehsana district, with a population of about 5,000. 4 Jain families live here. Kamboi lies on the Mehsana-Harij railway line. This place is 16 kilometers from Chanasma. Bus and taxi services are available. Dharmashala and bhojanshala facilities are available here. From here, Shankheshwar is 45 km, Mehsana 50 kilometers, Patan 30 km, Modhera 30 km, and Ahmedabad 200 km away.. Scripture References: Manmohan Parshwanath is mentioned in \\\"365 Shri Parshwa Naammala,\\\" \\\"108 Naamgarbhit Shri Godi Parshwanath Stavan,\\\" \\\"Parshwanath Sankhya Stavan,\\\" \\\"108 Naamgarbhit Naam Parshwanath Stavan,\\\" \\\"Shri Parshwanath Naammala,\\\" \\\"Viruddh Vijay Gyani Ras,\\\" and others.. Stuti: \\\"Whose bathing water washes away all the sorrows and pains of the faithful; whose divine radiance delights all pilgrims; whose wondrous image enchants the minds of all the devout. 'To Shri Manmohan Parshwa,' with devotion, I offer my vandana.\\\". Chanting Mantra: Om Hreem Arham Shri Manmohan Parshwanathaya Namah. 1. Bhawanipur, Kolkata has an ancient temple of Manmohan Parshwanath. 2. Khambhat has 2 temples of Manmohan Parshwanath - one in Jirlo Pado and the other in Choksi ni Dhruv. 3. Surat has 2 temples - one in Oswal Mohalla and the other in Vakil na Khancha. 4. Patan has 3 temples - Mahalakshmi na Pada, Khajuri na Pada, and Manmohan ni Sheri. 5. There are temples of Manmohan Parshwanath at Petlad, at Patoliya Pol in Vadodara, at Vorvad in Radhanpur, and in Radhanpur, Mehsana and Nandasan, Gujarat. 6. In Rajasthan, there are temples of Manmohan Parshwanath at Bali and Sanchore. 7. In Maharashtra, there are temples of Manmohan Parshwanath at Ichalkaranji, Poona (Bhawani Peth, the timber market), and Sangli. 8. There is a temple of Manmohan Parshwanath at Burhanpur and at Ladol.. Trust: Shri Manmohan Parshwanath Shwetambar Jain Tirth, Post: Kamboi - 384230, Taluka: Chanasma, District: Patan, State: Gujarat, India.. 48. Shri Manmohan Parshwanath (Nandasan). Main Deity: An idol of Lord Shri Manmohan Parshwanath, tall, white in color, about 127 cm, in the padmasana posture, is currently the Main Deity. The older, ancient idol of Lord Manmohan Parshwanath, about 33 cm tall, in the padmasana posture, is also in the temple.. Location: This is on the Mehsana highway, outside Nandasan village.. History: Nandasan is an ancient tirtha. The new temple was built under the inspiration and guidance of Acharya Shri Vijay Rajendrasuriji. The new idol of Lord Manmohan Parshwanath was consecrated in the temple on the 7th day of the bright half of the month of Vaishakh in Vikram Samvat 2051, by the revered hands of Acharya Shri Vijay Rajendrasurishwarji. The old idol of Manmohan Parshwanath was brought here by the acharya from the old village of Nandasan about 40 years earlier and enshrined at this sacred spot. This tirtha is also known as Jayartibhavan Tirth. The idol of Lord Parshwanath is magnificent, striking, enchanting and miraculous. Jains and non-Jains alike come here from distant places to pray. It is believed that if prayers are offered here with faith and devotion, the wishes of pilgrims are fulfilled. Idols of Kalikund Parshwanath, Guru Gautam Swami, Padmavati Devi, Manibhadra Devi and others are also installed here.. Other Temples: There are no other temples.. Art and Sculpture: The large and magnificent octagonal temple is splendidly decorated with intricate designs. The temple's creative work has been carved with the artistic skill of its craftsmen. The temple's walls and pillars are adorned with specimens of ancient art, and the paintings appear beautiful and magnificent. The idol has been beautifully carved from a single stone and looks very beautiful. The smiling face of Lord Manmohan Parshwanath appears very serene and tranquil. The temple is surrounded by beautiful natural scenery. The surrounding greenery and the beauty of the tirtha draw pilgrims to it.. Directions: This temple is on the Ahmedabad-Mehsana highway. The nearest railway station, Mehsana, is 25 km away, and Nandasan is 1 km away. Nandasan is well connected by road and rail to all major cities. Bus service and private vehicles are available here. Dharmashala and bhojanshala facilities are available here. There is an ayambilshala, an upashraya and a gyan bhandar. There is also a school, a pathshala, a gurukul and a medical dispensary.. Trust: Shri Jayartibhavan (Manmohan Parshwanath) Tirth Trust, Post: Nandan, Taluka: Kadi, District: Mehsana - 382705, State: Gujarat, India.. 48. Shri Manmohan Parshwanath - 2. Bali Village. Main Deity: An idol of Lord Manmohan Parshwanath, tall, white in color, about 78 cm, in the padmasana posture.. Location: This is in the center of Bali village.. History: Bali village is the heart of the Godwad region. Bali has 2 ancient temples - of Lord Adinath and Lord Manmohan Parshwanath. The idol of Lord Manmohan Parshwanath bears the inscription Vikram Samvat 1161, indicating its antiquity. According to the legend, the yakshini goddess of Lord Parshwanath appeared in a dream to a devotee named Jemji Shravak and told him that in the lake of Sela village, an idol of Lord Parshwanath... (remaining details on the next page).\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/sNN9uSQ4PouNy36C6\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:props:children:1:props:children:0:props:iconNode\\\",\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"Open in Google Maps\\\"]}],null,[\\\"$\\\",\\\"$L20\\\",null,{\\\"text\\\":\\\"$21\\\",\\\"lang\\\":\\\"en\\\",\\\"label\\\":\\\"Listen\\\",\\\"stopLabel\\\":\\\"Stop\\\"}]]}]\\n1c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-10 grid grid-cols-2 gap-2 sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"27fab324-e4dd-4259-9937-7df2cceece07\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 col-span-2 aspect-[4/3] sm:col-span-2\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_10675.jpeg\\\",\\\"alt\\\":\\\"Shri Manmohan Parshwanath फोटो 1\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"83e4d48a-4471-4aa2-ba22-19de54c3b3f1\\\",{\\\"className\