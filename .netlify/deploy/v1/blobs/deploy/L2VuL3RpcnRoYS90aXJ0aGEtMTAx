ildren\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"81. श्री वरकाणा पार्श्वनाथ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"मूलनायक: सफेद रंग की पद्मासन मुद्रा में 13 इंच ऊंची व 10 इंच चौड़ी भगवान श्री वरकाणा पार्श्वनाथ की मूर्ति। मूर्ति के सिर के ऊपर 7 नाग के फणों की छतरी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"तीर्थ: यह वारकाना गांव के केंद्र में है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"ऐतिहासिकता: प्राचीन काल में इस जगह को वांकानकपुर, वारकानगढ़ या वर्कनकनगर कहा जाता था। प्राचीन समय में वरकाना एक बड़ा और समृद्ध शहर था जिसमें कई जैन मंदिर थे। समय के चंगुल में फंसकर ये शानदार मंदिर भूमिगत दफन हो गए। वरकाणा पार्श्वनाथ की मूर्ति बहुत प्राचीन है। मूर्ति जमीन में दफन एक चरवाहे द्वारा पाई गई थी। जैन समाज ने यहां भव्य मंदिर का निर्माण किया और मूर्ति स्थापित की। इस मंदिर का उल्लेख करते हुए विक्रम युग के वर्ष 1211 का एक शिलालेख है। 16वीं शताब्दी में महाराणा कुंभा के शासनकाल के दौरान श्रीमालपुर के एक श्रेष्ठि ने 52 छोटे मंदिरों के साथ एक सुंदर मंदिर का निर्माण किया और मूर्ति स्थापित की।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"प्रतिमाजी पर कोई लेख नहीं है। दरवाजे के बहार वि.सं.1686 का एक शिलालेख है। यह प्रतिमा लगभग वि.सं.515 में प्रतिष्ठित हुई मानी जाती है। यह तीर्थ गोडवाड पंचतीर्थी का एक तीर्थ माना जाता है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"\\\\\\\"सकल तीर्थ सोत्र\\\\\\\" में इस तीर्थ का उल्लेख है। जैन साहित्य में तीर्थमालाओं में और \\\\\\\"सकल तीर्थ स्तोत्र\\\\\\\" में वरकाणा का वर्णन आता है। संस्कृत में एक स्तोत्र \\\\\\\"वरकनक शंख विद्रुम\\\\\\\" भी है जो वरकाणा का महत्त्व बताता है। रायप्रतिक्रमण (प्रातःकालीन प्रतिक्रमण) में \\\\\\\"सकल तीर्थ सूत्र\\\\\\\" के द्वारा वंदना के समय वरकाणा का महत्त्व इस प्रकार बताया गया है: \\\\\\\"सकल तीरथ वन्दु कर जोड़, जिनवर नामे मंगल कोड... अंतरिक्ष वरकानो पास, जीरावलों ने थंभण पास।\\\\\\\" इस स्तोत्र में अनेक चमत्कारिक तीर्थों की वंदना की गई है। इन तीर्थों में अंतरिक्ष पार्श्वनाथ, वरकाणा पार्श्वनाथ, जीरावाला पार्श्वनाथ, स्तंभन पार्श्वनाथ को सर्वमान्य एवं उत्कृष्ट तीर्थ बताया गया है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"संवत् 1618 विक्रम की पौष वदी सातम मंगलवार को तपागच्छाचार्य जगत गुरु हीरविजयसूरीजी ने संघ समेत अहमदाबाद से इस तीर्थ एवं पंचतीर्थी की यात्रा की थी, उन्होंने यहाँ पौष दसमी का अट्ठम तप अनुष्ठान करवाया था।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"जगदगुरु हीरविजयसूरीजी का महत्त्वपूर्ण समय वरकाणा एवं इसके पास-पड़ोस नाड़ोल एवं नारलाई में गुजरा। संवत् 1607 में नारलाई में इन्हें पंडित की पदवी प्राप्त हुई और यहीं संवत् 1607 में इन्हें वाचक उपाध्याय की पदवी प्राप्त हुई। इस मंदिर का भव्य रूप गुजरात के सोलंकी परमार कुमारपाल के समय में प्राप्त हुआ होगा, क्योंकि मंदिर का स्थापत्य एवं वास्तुरचना गुजरात की चाकुल्य शैली की है एवं कुमारपाल कालीन अन्य मंदिरों से मिलती-जुलती है। इस शैली की विशेषता यह है कि इसकी जगती एवं पीठिका धरती से लगती हुई होती है और खूब खम्भे और वे भी कोरणी से भरे हुए होते हैं। मंदिर भी निचाई पर ढका हुआ होता है और मंडप काफी ऊंचा। मेवाड़ के कुम्भाकालीन मंदिरों की पीठिका बहुत ऊँची है, जैसे राणकपुर की। विक्रमी संवत् 1200 के बाली जैन मंदिर के शिलालेख से यहाँ सोलंकियों के शासन की पुष्टि होती है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"वरकाणा का यह मंदिर आज किले-नुमा दिखाई देता है। इसे यह रूप महाराजा कुम्भा के समय में प्राप्त हुआ। मेवाड़ के महाराजाओं के कई लेख, ताम्रपट्ट व परवाने मंदिर की पेढ़ी में सुरक्षित हैं। मंदिर जी की पूर्व-उत्तरी दरवाजे व कोट महाराणा कुम्भा के समय में बने थे। उस समय की सामरिक आवश्यकतानुसार मंदिरों को किले-नुमा बना दिया गया। प्रभु प्रतिमा की कला अपना विशिष्ट स्थान रखती है। शिखरों पर बनी शिल्पकला भी अपनी अनुपम कला का उदाहरण प्रस्तुत करती है। उस समय तीर्थ यात्रियों से एकत्र किए जाने वाले तीर्थयात्रा कर को आचार्य श्री विजयदेवसूरी की सलाह पर मेवाड़ के राणा जगतसिंह ने समाप्त कर दिया था।\\\"}],\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-