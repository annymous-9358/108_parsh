\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\\\",\\\"key\\\":\\\"1r0f0z\\\"}],[\\\"circle\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"10\\\",\\\"r\\\":\\\"3\\\",\\\"key\\\":\\\"ilqhr7\\\"}]],\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"નાગપુરા, છત્તીસગઢ\\\"]}],\\\"$L1d\\\",false,\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"]}]}],\\\"$L21\\\"]\\n\"])</script><script>self.__next_f.push([1,\"22:I[48268,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/38nkbgmy2fbw2.js\\\",\\\"/_next/static/chunks/00gby0sjeqv85.js\\\"],\\\"SpeakButton\\\"]\\n24:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/38nkbgmy2fbw2.js\\\",\\\"/_next/static/chunks/00gby0sjeqv85.js\\\"],\\\"Image\\\"]\\n23:T433a,\"])</script><script>self.__next_f.push([1,\"શ્રી ઉવસાગરન પાર્શ્વનાથ. 108 पार्श्वनाथ में से 101 - श्री उवसग्गहरं पार्श्वनाथ।. स्थान: पोस्ट-नगपुर, जिला-दुर्ग (छत्तीसगढ़)।. मूलनायक: काले रंग की पद्मासन मुद्रा में 47 इंच ऊंची (लगभग 118 से.मी.) भगवान श्री उवसग्गहरं पार्श्वनाथ की मूर्ति। मूर्ति के सिर के ऊपर 7 नाग फणो की छतरी है। कुंडलित पद्मासन मुद्रा में नागराज नीचे और इस मूर्ति के पीछे दिखाई देते हैं। यह अपनी तरह की एक मूर्ति है।. तीर्थ: यह शिवनाथ नदी के पश्चिमी तट पर नगपुरा गाँव में है।. ऐतिहासिकता: यहा भगवान उवसग्गहरं की बहुत प्राचीन, आकर्षक और चमत्कारी मूर्ति है। पार्श्वनाथ की मूर्ति तब मिली जब राजा प्रदेश आचार्य श्री केशी के संपर्क में आए। केशी स्वामी जो भगवान पार्श्वनाथ के अनुयायी थे, उनके उपदेशों से प्रभावित होकर राजा प्रादेशी को भगवान पार्श्वनाथ की एक अद्भुत मूर्ति मिली। यह मूर्ति तिंदुक उद्यान में आचार्य केशी स्वामी के पूजनीय हाथों द्वारा स्थापित की गई, ऐसा माना जाता है कि यह स्थापना चरम तीर्थपति भगवान महावीर की अवधि के दौरान हुई जब वे 37 वर्ष के थे और उस समय यह मूर्ति वर्षों पुरानी थी। इस प्रभावशाली मूर्ति ने दिन-प्रतिदिन प्रसिद्धि और भव्यता प्राप्त की। समय के साथ यह प्रभावशाली और लोकप्रिय मंदिर जीर्ण-शीर्ण हो गया और इस मूर्ति के पीठासीन देवता धरणेन्द्र और पद्मावती भगवान पार्श्वनाथ की इस मूर्ति को देवलोक ले गए। यह मूर्ति लंबे समय तक देवी-देवताओं द्वारा पूजी जाती रही। इस मूर्ति का गौरवशाली इतिहास बाद के वर्षों में और अधिक शानदार हो गया। श्री गजसिंह जैन धर्म के अनुयायी थे। उनकी भक्ति से प्रसन्न होकर देवी पद्मावती ने भगवान पार्श्वनाथ की इस भव्य मूर्ति को श्रावक गजसिंह को दिया। उनकी खुशी की कोई सीमा नहीं थी और वह अपनी प्रार्थनाओं में अधिक लीन हो गए। उन्होंने सुंदर और भव्य 108 जैन मंदिर (जिनालय) बनवाए और भगवान पार्श्वनाथ की इस मूर्ति को मुलनायक के रूप में स्थापित किया। समय के साथ यह मंदिर खो गया, लेकिन यह प्रभावशाली और चमत्कारी मूर्ति भगवान पार्श्वनाथ को पृथ्वी के नीचे दफना दिया गया था। उगना गांव के ठाकुर भुवन सिंह थे। उन्होंने एक कुआ खुदवाया। जब इसे 44 फीट की गहराई तक खोदा गया, तो यह दूध से भर गया। जब नागराज (धरणेन्द्र) के साथ मिलकर इस चमत्कार के रहस्य का पता लगाने के लिए खुदाई की गई, तब भगवान पार्श्वनाथ की यह मूर्ति मिली। खेत के मालिक भुवनसिंह व ग्रामीणों ने इस मूर्ति को जैन संघ को सौंप दिया। जैन समुदाय ने उगना गांव में एक शानदार मंदिर बनाने और इस मूर्ति को उसमें स्थापित करने का निर्णय लिया। जब मंदिर का काम पूरा होने के निकट था, एक रात 7 जैन श्रावकों को एक ही सपना आया। मूर्ति के पीठासीन देवता ने संकेत दिया कि मध्य प्रदेश में दुर्ग के श्री रावतमलजी और अन्य श्रीश्री एक विशाल भवन बनाना चाहते थे और इस मूर्ति को दुर्ग के पास नागपुरा मंदिर में स्थापित किया जाना चाहिए। श्री रावतमलजी से संपर्क किया गया और उन्हें यह जानकारी दी गई। आचार्य श्री कैलाशसागरसूरीश्वरजी की सलाह पर भगवान पार्श्वनाथ की मूर्ति को नागपुरा में लाया गया। शुभ दिन उगना मंदिर में भगवान पार्श्वनाथ की एक नई मूर्ति स्थापित की गई। जब इस मंदिर की आधारशिला भिक्षु और जैन भक्तों की मौजूदगी में रखी जा रही थी, तब दूध की एक धारा निकली थी। इस मंदिर को 40 अन्य मूर्तियाँ उपहार में दी गई थीं। एक भव्य और सुंदर 3 गुंबददार मंदिर बनाया गया और मूर्तियों को स्थापित किया गया। कई चमत्कार आज भी यहां होते रहते हैं।. भक्तों की मानसिक, शारीरिक और शब्दगत परेशानियों को दूर करने वाली, पूजा और प्रार्थना करने से दूर हो जाने वाली इस मूर्ति को - यही कारण है कि भगवान की इस प्रभावशाली मूर्ति को उवसग्गहरं पार्श्वनाथ कहा जाता है। कहा जाता है कि एक बार एक गैर-जैन व्यक्ति कैंसर होने के कारण उपचार करवाने के लिए बॉम्बे जा रहा था। वह नगपुरा में उवसग्गहरं पार्श्वनाथ भगवान पर श्रद्धा, विश्वास व पक्का भरोसा रखते हुए नगपुरा में आया और भगवान की पूजा की, और उसके इलाज के लिए बॉम्बे के टाटा अस्पताल गया। जब जाँच के बाद रिपोर्ट आई तो आश्चर्य हुआ - कोई कैंसर नहीं था। भगवान में उसकी आस्था के कारण वह अपने कैंसर से ठीक हो गया था।. अन्य मंदिर: यहाँ कोई अन्य मंदिर नहीं है।. कला और मूर्तिकला के काम: मूर्ति सात नाग फणो के साथ सुंदर लग रही है, यह अद्भुत और चमत्कारी मूर्ति भक्तों को प्रभावित करती है और उन्हें भगवान में विश्वास रखने के लिए प्रेरित करती है। मुख्य आकर्षण इस मंदिर में 30 फीट ऊंचा दरवाजा है। द्वार के ऊपर भगवान पार्श्वनाथ की एक मूर्ति है।. श्री उवसग्गहरं पार्श्व तीर्थ नगपुरा समूचे विश्व के श्रद्धालुओं की गहरी आस्था का प्रतीक बना है। मंगल कल्याण आवासं की तपोभूमि के इस तीर्थ में अन्य तीर्थों के दर्शन एवं भाववाही यात्रा का लाभ मिले, श्रद्धालुओं की इस इच्छा के अनुरूप ही तीर्थ के सर्वोदय विकास के अंतर्गत तीर्थदर्शन देहरी का निर्माण कराया गया। उद्यान की इन देहरियों में श्री शंखेश्वर, गिरनार, कदंबगिरी, तलाजा, आबू, ओसियाँजी, पावापुरी आदि 25 तीर्थों की प्राकृतिक देहरी में कलात्मक तीर्थ के पट्ट के साथ तीर्थपति भगवंतों की प्रतिमाजी का निर्माण कराकर शिरोमणि साहित्योपासक पूज्यपाद आचार्य भगवंत श्रीमद् सुशील सूरीश्वर म.सा. एवं प्रखर ओजस्वी प्रवचनकार पूज्यपाद आचार्यदेव श्रीमद् जिनोत्तम सूरीश्वरजी म.सा. की पावन निश्रा में कराई गई। इस उद्यान के देवकुलिका में श्री अनंतनाथ, श्री सुमतिनाथ, श्री महावीर स्वामी प्रभु की प्राचीन प्रतिमा प्रतिष्ठित है, उद्यान के मध्य में भव्य कलात्मक श्री शाश्वता जिन मंदिर एवं श्री राजेन्द्र गुरु मंदिर निर्माण प्रगति पर है।. मणिभद्रवीर मंदिर, पद्मावती मंदिर आदि यहां के अन्य मंदिर हैं। यहाँ के मणिभद्रवीर बहुत प्रभावशाली और चमत्कारी हैं। इस ऐतिहासिक प्राचीन आस्थामयी देहरी मंदिर का, जो भव्य तीर्थोद्धार के अभाव में खंडहर होता गया था, सन् 1979 में धर्मनिष्ठ दुगड़ गोत्रीय रावलमल जैन 'मणि', दुर्ग निवासी, ने स्वप्न निर्देशानुसार जीर्णोद्धार एवं भव्य तीर्थोद्धार के कार्य का बीड़ा उठाया और आज भव्य सप्तशिखरमय मंदिरावली के साथ महाप्रभाविक श्री उवसग्गहरं पार्श्व तीर्थ देदीप्यमान कराया। संवत् 2059 (सन् 1995) में पू. आत्मकमल लब्धि-विक्रम गुरु कृपापात्र पू.आ.श्री राजयश सूरी म.सा. के मार्गदर्शन में भव्य निर्माण पूरा हुआ और पूज्यश्री की निश्रा में श्री उवसग्गहरं पार्श्व जिनालय की प्रतिष्ठा हुई।. दिशानिर्देश: निकटतम रेलवे स्टेशन दुर्ग (जंक्शन) नागपुर-हावड़ा रेलवे लाइन पर है। दुर्ग से नगपुरा तीर्थ 14 किलोमीटर की दूरी पर है। दुर्ग से नगपुरा तीर्थ तक के लिए बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं। अहमदाबाद से दुर्ग के लिए ट्रेन नं. १२८३३ अहमदाबाद हावड़ा एक्सप्रेस उपलब्ध है।. शास्त्र: इस मूर्ति की प्राचीनता का उल्लेख 'छत्तीसगढ़ वंश और संस्कृति का इतिहास - पाटनगर' पुस्तक में मिलता है। उवसग्गहरं पार्श्वनाथ का मुख्य मंदिर नगपुरा में है। उवसग्गहरं पार्श्वनाथ की एक मूर्ति करेडा (भूपालसागर, राजस्थान) व जिरावला तीर्थ में है। आंध्र प्रदेश के वारंगल में भी उवसग्गहरं पार्श्वनाथ का मंदिर है, जहां पद्मासन मुद्रा में लगभग 68 सेमी ऊंची, सुंदर, आकर्षक उवसग्गहरं पार्श्वनाथ की मूर्ति है जिसके मस्तक के ऊपर 7 नाग फणो की छतरी है। श्री जैन श्वेतांबर मंदिर, जेपी ऐनी रोड, वारंगल- 506 002, आंध्र प्रदेश।. स्तुति: केशीस्वामी के उपदेश से प्रदेशी प्रतिमा भरावता, दूधधारने धरणेन्द्र साथे जे प्रभुजी प्रकटता, उपसर्ग ने सहनार तू उपसर्ग तु सहूना हरे। 'उवसग्गहरं पार्श्व ने भावे करूँ हुं वंदना'।. जाप मंत्र: 'ॐ ही अर्हं श्री उवसग्गहरं पार्श्वनाथय नमः'. ट्रस्ट: श्री उवसग्गहरं पार्श्वनाथ श्वेतांबर जैन तीर्थ, पोस्ट: नगपुरा, जिला: दुर्ग, राज्य: छत्तीसगढ़ - 491001। फोन: 0788-2621201/2621202।\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap