2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13187.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>77. Shri Dada Parshwanath</p><p>Address: Moribeda, Taluka-Shivganj, District-Sirohi (Rajasthan). (Address noted on the temple photo: Mu. Po. Junabeda-306126, Taluka Bali, District Pali, Rajasthan.)</p><p>Main Deity: A black-colored image of Shri Dada Parshwanath, 26 inches tall and 22.25 inches wide, in the padmasana posture. Above the head of the image is a canopy of 9 serpent hoods.</p><p>Location: This is at the foot of the Aravalli hills in the old Beda village, 5 kilometers from the new Beda village.</p><p>History: Built at the foot of the Aravalli hills during the 11th century of the Vikram era, this ancient temple is very miraculous and powerful; its glory is boundless. Devotees who worship with devotion are moved and inspired by the flow of affection that seems to emanate from the body of this image of Bhagwan Parshwanath. Before this, the first Tirthankara, Shri Adinath Bhagwan, was the Mulanayak of this temple. Shri Dada Parshwanath was installed in this temple by the revered hands of Acharya Shri Hirasurishwarji, as recorded on the image, in V.S. 1644. This is the site of the spiritual practice (sadhana bhoomi) of the Adhyatmayogi Shri Bhadrankarvijayji. This is an excellent place for solitary meditation amid the atmosphere of the Aravalli hills. One day a miracle occurred -- the hand of a woman about to take diksha became fragrant with a divine scent as she went to worship the Lord in the temple, and this fragrance remained on her hand for three days. This temple came into the spotlight after the Updhan Tap and Navpad Oli Tap austerities performed here.</p><p>Other Temples: There is no other temple here, but in the new Beda village there is a 52-shrine (Bawan Jinalaya) temple of Bhagwan Sambhavnath.</p><p>Directions: This temple is 40 kilometers from Sadri and Pindwara, and 10 kilometers from the Nana Tirth of Shri Jivit Mahavir Swami. Bus service and private vehicles are available. Dharamshala and bhojanshala facilities are available here.</p><p>Scripture References: Dada Parshwanath is mentioned in &quot;365 Shri Parshwajin Nammala,&quot; &quot;Shri Parshwanath Chhand,&quot; &quot;Shri Bhatev Parshwanath Stavan,&quot; &quot;108 Naamgarbhit Shri Parshwanath Stavan,&quot; &quot;Tirthamala,&quot; &quot;Shri Parshwanath Nammala,&quot; and elsewhere.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a 