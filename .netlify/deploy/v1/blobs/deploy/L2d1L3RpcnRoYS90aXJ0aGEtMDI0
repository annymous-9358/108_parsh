ezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8126.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>21. શ્રી પદ્માવતી પાર્શ્વનાથ</p><p>મુલનાયક: પદ્માસન મુદ્રામાં લગભગ 33 સેમી ઉંચી ભગવાન પાર્શ્વનાથની સફેદ રંગની મૂર્તિ જે ભગવાન શ્રી પદ્માવતી પાર્શ્વનાથ તરીકે ઓળખાય છે. મૂર્તિના માથા પર 9 સાપના હૂડની છત્ર છે.</p><p>તીર્થ: તે અમદાવાદના નરોડા ગામની મધ્યમાં છે.</p><p>ઐતિહાસિકતા: અમદાવાદની પૂર્વમાં આવેલું નરોડા ગામ પ્રાચીન સમયમાં નિષાધનું શહેર હતું તેવા પુરાવા છે. એવું માનવામાં આવે છે કે આ રાજા નાલાનું શહેર હતું. શિખરબંધ આ ભવ્ય મંદિર શેઠ શ્રી હરિ સિંહ કેસર સિંહ દ્વારા બનાવવામાં આવ્યું હતું. આ મૂર્તિ જમીનની નીચેથી મળી આવી હતી. આ આકર્ષક અને વિસ્મયકારક પ્રતિમા અમદાવાદમાં ખૂબ પ્રખ્યાત છે. દર મહિનાની પહેલી (પ્રથમ) દિવસે અને દર મહિનાની પૂર્ણિમાના દિવસે અહીં યાત્રાળુઓ આવે છે. શ્રી પદ્માવતી પાર્શ્વનાથની આ મૂર્તિ નરોડા પાર્શ્વનાથ અને ગોડીજી પાર્શ્વનાથ તરીકે પણ ઓળખાય છે. પરંતુ અહીં દેવી પદ્માવતીની પ્રાચીન મૂર્તિ છે જે ખૂબ જ પ્રભાવશાળી અને ચમત્કારિક છે. ભગવાન પાર્શ્વનાથ દેવી પદ્માવતીની પૂજાને કારણે શ્રી પદ્માવતી પાર્શ્વનાથ તરીકે પ્રખ્યાત છે.</p><p>અન્ય મંદિરો: તાજેતરમાં બંધાયેલા, અહીં 4 વધુ મંદિરો છે.</p><p>કલા અને શિલ્પના કાર્યો: આ મંદિરમાં ભગવાન પાર્શ્વનાથની મૂર્તિ નાની હોવા છતાં, તે ખૂબ જ સુંદર, આકર્ષક અને આહલાદક છે. આ મંદિરની નજીક એક ટેકરી પર મળેલા અનેક ખંડેર દર્શાવે છે કે અહીં એક ખૂબ જ પ્રાચીન અને ભવ્ય મંદિર હતું. દેવી પદ્માવતીની ચમત્કારિક મૂર્તિ ભક્તોની મનોકામના પૂર્ણ કરે છે. શુભ પ્રસંગો પર, લોકો આદરપૂર્વક દેવી પદ્માવતીને ચુંદરી અર્પણ કરે છે. મંદિરની દિવાલો પર વિવિધ પવિત્ર સ્થળોના ચિત્રો જોઈ શકાય છે.</p><p>દિશા-નિર્દેશો: તે અમદાવાદથી 8 કિલોમીટરના અંતરે અને નરોડા રેલ્વે સ્ટેશનથી 1.5 કિલોમીટરના અંતરે નરોડા ગામની બજારની મધ્યમાં છે. પેટા આશ્રય, ધર્મશાળા અને ભોજનશાળાની સગવડો અહીં ઉપલબ્ધ છે.</p><p>108 શ્રી પદ્માવતી પાર્શ્વનાથ, નરોડા રોડ, નરોડા, અમદાવાદ, ગુજરાત - 382330.</p><p>શાસ્ત્ર:- શ્રી પદ્માવતી પાર્શ્વનાથનો ઉલ્લેખ &quot;શ્રી પાર્શ્વનાથ સપ્તતીર્થી સ્તવન&quot;, &quot;તીર્થમાલા&quot;, &quot;365 શ્રી પાર્શ્વ જીના નામમાલા&quot; વગેરેમાં છે.</p><p>સ્તુતિ:- પદ્માવતી, બહુ પ્રગટ, હ્રદયની સદા પ્રેમાળ માતા, ધ્યવતી, દરેક સંકટમાં, ભક્તો તારી પૂજા કરે, એક ધ્યાન કરનાર, નરોડા નગરીમાં રહેતા લોકો, શ્રધ્ધાંજલિ અર્પણ કરે છે. &quot;શ્રી પદ્માવતી પ્રભુ પાર્શ્વ ને ભાવે, હું પૂજા કરીશ...&quot;</p><p>મંત્રનો જાપ કરો:- &quot;ઓમ હ્રી અર્હ શ્રી પદ્માવતી પાર્શ્વનાથાય નમઃ.&quot;</p><p>ટ્રસ્ટ:- શ્રી ગોડીજી પાર્શ્વનાથ શ્વેતાંબર જૈન તીર્થ, નરોડા બજાર, પોસ્ટ: નરોડા, અમદાવાદ - 382325, ગુજરાત રાજ્ય, ભારત. ફોન: 079-22812286, 079-22831404.</p><p>મંદિર પરિસરમાં પદ્માવતી દેવીની સુંદર પ્રતિમા પણ છે.</p><p>શ્રી 108 પાર્શ્વનાથ સ્તુતિ:- આ વિશ્વના સહુ દુઃખિયા &quot;ઘિયા&quot; શરણમા આવિયા, &quot;ધર્નેંદ્ર-પાર્શ્વ&quot; એ ઓફર કરી છે, શ્રદ્ધા સુમને લવિયા, &quot;પદ્માવતી ઓ પાર્શ્વજી&quot; સાહુ ભક્તોની આશા પુરો, &quot;શંખેશ્વર&quot; પ્રભુ! વિનવનું રક્ષણ કરો! રક્ષણ !!</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-023\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી સુખસાગર પાર્શ્વનાથ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-026\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી મુહરી પાર્શ્વનાથ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>મૂળ સ્રોત: રાજેન્દ્ર કુમાર જૈન, પાર્શ્વ સદન, પાર્શ્વ નગર, ડુંગરપુર</p></div></foote