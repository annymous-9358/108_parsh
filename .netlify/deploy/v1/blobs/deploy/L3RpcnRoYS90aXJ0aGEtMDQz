ct%2Fpublic%2Ftirtha-images%2Fimg_9257.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9257.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9257.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\"><img alt=\"श्री पल्लवीया पार्श्वनाथ फोटो 2\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 640px) 33vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9102.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>(निरंतरता) ...थी। भगवान पार्श्वनाथ की एक नई मूर्ति बनाई गई और कोरंतगच्छिया आचार्य श्री कक्कासुरजी के पूज्य हाथों द्वारा मूल मंदिर में वी.स. 1274 में फाल्गुन सुद 5 (पांचवें) के दिन स्थापित की गई। इसे &quot;पल्लवी पार्श्वनाथ&quot; के नाम से जाना जाता है। मुख्य मंदिर के साथ दो अन्य मंदिर जुड़े हुए हैं जिनमें भगवान आदिनाथ और भगवान नेमिनाथ मूलनायक हैं। यह मंदिर आज भी खड़ा है।</p><p>राजा प्रहलाददान ने जैन धर्म के कई कार्य किए। वह एक महान विद्वान थे, उन्होंने कई पुस्तकें और लेख लिखे। &quot;पार्थ पराक्रम व्यायोग&quot; नामक संस्कृत नाटक उनके द्वारा लिखा गया था। यह मंदिर कुछ साल पहले पुनर्निर्मित किया गया। जब तपागच्छ आचार्य श्री देवेन्द्रसूरीश्वरजी पालनपुर आए, तो उन्होंने देखा कि पालनपुर के लोग बहुत धार्मिक थे। नगर के अन्य लोगों के साथ 84 श्रेष्ठी मोर के पंखों की छतरी से सजी अपनी पालकी में आचार्यों के प्रवचन सुनने आते थे। रोज़ मंदिर में एक मुदाक (तौलने का पुराना माप) सोलह मन चावल और सुपारी का प्रसाद चढ़ाया जाता था। श्री पल्लवी पार्श्वनाथ के मंदिर में उपाध्याय विद्यानंदगनी को आचार्य की उपाधि दी गई और नाम आचार्य श्री विद्यानंदसूरिजी रखा गया, तथा उनके छोटे भाई धर्मकीर्ति महाराज को उपाध्याय की उपाधि दी गई। उस समय वहाँ मंदिर में सुगंधित कुमकुम की वृष्टि हुई थी, जिसे देखकर पूरी सभा में बहुत खुशी हुई।</p><p>अन्य मंदिर: इसके अलावा, वर्तमान में यहां 14 मंदिर हैं।</p><p>कला और मूर्तिकला: भगवान पार्श्वनाथ की मूर्ति बहुत आकर्षक, सुंदर, प्रभावशाली और चमत्कारी है। इस मंदिर व अन्य मंदिरों में भी प्राचीन कलात्मक, उज्ज्वल और मनभावन मूर्तियाँ हैं। यहाँ देवी अंबिका देवी की मूर्ति है जिस पर वर्ष वी.स.1315 लिखा है, और गुरुदेव की मूर्ति पर वी.स.1274 लिखा है। जैन मंदिर की उत्तम नक्काशी और सुंदर वास्तुकला सांस्कृतिक विरासत को समृद्ध करती है।</p><p>दिशानिर्देश: पालनपुर बनासकांठा जिले का मुख्य शहर है, अहमदाबाद-आबू रोड मुख्य राजमार्ग पर स्थित है। रेलवे स्टेशन और बस स्टैंड मंदिर से एक किमी की दूरी पर हैं, बसें और टैक्सी उपलब्ध हैं। यहां धर्मशाला, भोजशाला, ज्ञानभंडार, उपाश्रय और पाठशाला की सुविधाएं उपलब्ध हैं।</p><p>शास्त्र: पल्लवी पार्श्वनाथ का उल्लेख &quot;नाभि नंदनोद्धर प्रभु&quot;, &quot;गुरुवली&quot;, &quot;श्री गुरुपर्व कर्म वरण&quot;, &quot;तीर्थमाला&quot;, &quot;प्रभा पञ्चशती&quot;, &quot;सोम सोभग्य पट्टावली&quot;, &quot;विक्रम चरित्र पचनदा&quot;, &quot;तपगाछप पट्टावली&quot;, &quot;हिरसोभव्य&quot;, &quot;365 श्री पार्श्वजीन नाममाला&quot;, &quot;श्री भटेव पार्श्वनाथ स्तवन&quot;, &quot;108 नामगर्भित श्री पार्श्वनाथ स्तव&quot;, &quot;श्री हिरविजयसुरी रास&quot;, &quot;श्री पार्श्वनाथ नाममाला&quot;, &quot;135 नामगर्भित श्री पार्श्वनाथ स्तवन&quot;, &quot;वृद्धी विजय गनि निरंजन भास&quot;, &quot;श्री विजयरात्नसूरी रास&quot;, &quot;सोहमकुलरत्न पट्टावली रास&quot;, &quot;श्री पल्लविय पार्श्वनाथ स्तवन&quot;, &quot;श्री पार्श्व प्रभु के 108 नाम के छंद&quot; आदि में किया गया है। मुंबई के सांताक्रूज के कलिकुंड पार्श्वनाथ मन्दिर में भी पल्लविय पार्श्वनाथ की एक मूर्ति है।</p><p>स्तुति: अति पापी प्रहलाद नृपे तुज पालव पकड्यो प्रेमथी, पल्लवित थयो तय कोढ़ गलतो देह प्रभु तुझ रहेमथी, पल्लवित करो मुझ धर्मवेली तुझ कृपा जल रेलथी, श्री &quot;पल्लवीया&quot; प्रभु पार्श्वने भावे करूं हुं वंदना...</p><p>जाप मंत्र: &quot;ॐ ह्री अर्ह श्री &quot;पल्लवीया&quot; पार्श्वनाथाय नमः&quot;</p><p>ट्रस्ट: श्री पल्लविय पार्श्वनाथ जैन श्वेतांबर मंदिर, पोस्ट: पालनपुर, जिला: बनासकांठा - 385001, राज्य: गुजरात, भारत। फोन: 02742-262731, 02742-263192।</p><p>पुरुषादानीय अर्हत पार्श्वनाथ चरित्र भाग 2 (भगवान पार्श्वनाथ की माता वामा देवी के 14 सपने): जिस रात पुरुषादानीय अर्हत पार्श्व अश्वसेन राजा की रानी वामादेवी की कुक्षि में गर्भधारण करने आए, उसी रात वामादेवी जिस भव्य राजमहल में निद्रा ले रही थी वह गर्भ ग्रह के कक्ष चित्रों से सुशोभित थे। बाहर का भाग श्वेत चिकने चूने की कली से सुशोभित था, छत पर विभिन्न प्रकार की चित्रकारी हुई थी। माता के कक्ष व आसपास कालागुरु, उत्तम कंदुरु व लोबान आदि से सुगंधित हो रहा था। शयनकक्ष में सुंदर शैय्या, मुलायम बिस्तर तथा सिर व पैरों के नीचे मुलायम तकिये रखे थे। कक्ष में सुंदर रेशमी पर्दे लगे थे, फर्श पर मुलायम मखमल का कालीन बिछा था, शयन कक्ष के आसपास सुगंधित पुष्पों से सजावट थी। उस समय माता वामादेवी अर्ध निंद्रा की अवस्था में सोई हुई थीं। रात्रि के पिछले पहर में माता ने उत्तम 14 सपने देखे तथा जागृत हो गईं।</p><p>14 स्वप्न इस प्रकार थे: 1. गज, 2. वृषभ, 3. सिंह, 4. लक्ष्मी, 5. पुष्पमाला, 6. चंद्र, 7. सूर्य, 8. ध्वजा, 9. कुंभ, 10. पद्म सरोवर, 11. क्षीर समुंद्र, 12. देव विमान, 13. रत्न राशि, 14. धुआं रहित आग।</p><p>108 पार्श्वनाथदादा का इतिहास एवं किस प्रकार पहुंचना... भाग-10: नवसारी, सुरत, रादेर के 4 एवं भरूच, गंधार के 2, डभोइ व छाणी के 3, खंभात के 4, खेडा व धोलका के 2, अहमदाबाद के 4, नरोडा, टीटोई, मोदर, बडोदा के 4, नाना पोसीना के 1, मोटा पोसीना के 1 एवं विजापुर के 1, विहार, विसनगर, मेहसाणा, सिद्धपुर, धोता सकलाणा, पालनपुर के एक-एक - कुल 32 पार्श्वनाथ प्रभु के तीर्थों की यात्रा करने के पश्चात, आगे हम भिलडियाजी, उंबरी, चारूप के एक-एक कुल 3 पार्श्वनाथ प्रभु के तीर्थ की यात्रा करेगें। इसके पश्चात पाटन में 10 पार्श्वनाथ के जिनालयों की यात्रा करेगें।</p><p>पालनपुर से भिलडीया - 13 किमी, भिलडीयाजी से उंबरी - 29 किमी, उंबरी से चारूप - 21 किमी, चारूप से पाटन - 42 किमी।</p><p>भीलडीयाजी: 34. श्री भिलडीया पार्श्वनाथ। उंबरी: 35. श्री आनंदा पार्श्वनाथ। चारूप: 36. श्री चारूप पार्श्वनाथ।</p><p>पुरुषादानीय पार्श्वनाथ भगवान का चरित्र भाग-3 (इन्द्र महाराज के द्वारा &quot;शक्रस्तव&quot; द्वारा वंदन): इंद्र महाराज अपने विपुल अवधि ज्ञान से संपूर्ण जंबूद्वीप को देख सकते थे। उसी समय वह पुरुषादानीय पार्श्व को वाराणसी नगरी में राजा अश्वसेन की रानी वामादेवी की कुक्षि में गर्भरूपे उत्पन्न होते देखते हैं और उनका हृदय परमानंदित हो जाता है। इंद्र महाराज तीर्थंकर के सम्मुख सात-आठ कदम चलकर दायां घुटना पृथ्वी पर रखकर तीन बार मस्तक को पृथ्वी पर लगाकर नमन करते हैं। उसके पश्चात खड़े होकर, कड़ा और त्रुटित से अलंकृत भुजा को सिकोड़कर 10 अंगुलियों को मस्तिष्क पर लगाकर बोलते हैं कि मेरा नमस्कार हो पुरुषादानीय अर्हत पार्श्व को, जो धर्म की प्रभावना करने वाले, 23वें तीर्थंकर हैं, जो पूर्व के तीर्थंकरों द्वारा बताई गई धर्म शिक्षा को पुनरावृत्त कर सिद्ध गति प्राप्त करने की अभिलाषा वाले हैं। इस प्रकार भावना भाते हुए इंद्र महाराज अर्हत पार्श्व को शक्रस्तव द्वारा वंदन और नमन करते हैं, फिर स्वयं के सिंहासन पर पूर्व की ओर मुंह करके बैठते हैं।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-042\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री पल्लवीया पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-044\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री भीलडिया पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>मूल स्रो