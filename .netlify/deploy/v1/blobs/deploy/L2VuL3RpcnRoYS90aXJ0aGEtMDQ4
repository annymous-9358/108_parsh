c/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/38nkbgmy2fbw2.js\\\",\\\"/_next/static/chunks/00gby0sjeqv85.js\\\"],\\\"SpeakButton\\\"]\\n24:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/38nkbgmy2fbw2.js\\\",\\\"/_next/static/chunks/00gby0sjeqv85.js\\\"],\\\"Image\\\"]\\n23:T210f,\"])</script><script>self.__next_f.push([1,\"Shri Charup (Shyamla) Parshvanath and Patan Yatra Route. श्री चारूप (श्यामला) पार्श्वनाथ मंदिर (शेष विवरण): ...में एक व्यक्ति की आध्यात्मिक शक्ति लेकिन गहन ध्यान को दर्शाया गया है। इस तरह की मूर्ति को शायद ही कहीं और देखा जा सकता है।. दिशानिर्देश: चारूप रेलवे स्टेशन 1 किमी की दूरी पर है। यहां से पाटन का निकटतम रेलवे स्टेशन 10 किलोमीटर की दूरी पर है। बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला की सुन्दर व्यवस्था है। एक अच्छा उपाश्रय भी है।. शास्त्र: इस मंदिर का उल्लेख \\\"श्री पार्श्वनाथ स्तवन\\\" में, \\\"श्री शंखेश्वर पार्श्वनाथ छंद\\\" में, \\\"श्री गोडी पार्श्वनाथ स्तवन\\\" में, \\\"तीर्थमाला\\\" में, \\\"श्री पार्श्वनाथ नाममाला\\\" आदि में किया गया है। श्री चारूप पार्श्वनाथ मूर्ति को श्यामला पार्श्वनाथ के नाम से भी जाना जाता है। श्यामला पार्श्वनाथ का मंदिर भारत के कई शहरों और कस्बों में है।. स्तुति: चारूप तीर्थे चार रुप करती प्रतिमा आपकी, जोता करे नयनो अमाश ते ठरे मोह तापणी, आषाडीना प्यारा प्रभु लागे धुन अजपाजानी। श्री \\\"चारूप\\\" पार्श्व ने भावे करूं हूं वंदना।. जाप मंत्र: \\\"ॐ ह्री अर्हम् श्री चारूप पार्श्वनाथय नमः\\\". ट्रस्ट: श्री चारुप जैन श्वेताम्बर श्री श्यामला पार्श्वनाथ महातीर्थ पेढ़ी, चारुप-384285, जिला: पाटन, गुजरात राज्य, भारत। फोन: 02766-77568, 02766-77562, मोबाइल-9978245043।. देखी मूर्ति श्री पार्श्वजिननी नेत्र मारा ठरे छे, नै हैयु मारू फरी फरी ध्यान चारू धरे छे, आत्मा मारो प्रभु तुझ खाने, आववा उल्लस