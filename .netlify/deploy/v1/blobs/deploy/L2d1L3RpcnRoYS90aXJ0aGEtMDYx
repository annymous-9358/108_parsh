F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10149.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10149.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10149.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10149.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10149.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 માંથી 44 પાર્શ્વનાથ - શ્રી મહાદેવ પાર્શ્વનાથ.</p><p>મુલનાયક:- 23 ઇંચ ઉંચી અને 19 ઇંચ પહોળી ભગવાન શ્રી મહાદેવ પાર્શ્વનાથની ઉચ્ચ સફેદ રંગની પદ્માસન મુદ્રામાં મૂર્તિ.</p><p>તીર્થયાત્રા:- તે પાટણમાં ખેતરવાસીમાં છે.</p><p>ઈતિહાસ:- પાટણ શહેર વી.એસ. તેની સ્થાપના 802 માં થઈ હતી અને તે પાટણ પર શાસન કરનારા ચાવડા રાજાઓની રાજધાની હતી. તેઓ જૈન હતા અને તેમણે પાટણમાં ઘણા મંદિરો બનાવ્યા જે આજે પણ પ્રખ્યાત છે. ત્યારબાદ ચાલુક્ય વંશમાં સિદ્ધરાજ અને મહારાજા કુમારપાલ જેવા ઘણા મહાન રાજાઓ આવ્યા. આ સમયગાળા દરમિયાન જૈન ધર્મનો વિકાસ થયો. પરંતુ અલાઉદ્દીનના કમાન્ડર મલિક ગફૂર દ્વારા વી.એસ. 1356 માં મુસ્લિમ આક્રમણ દ્વારા શહેરનો નાશ કરવામાં આવ્યો હતો. આ આક્રમણ દરમિયાન ઘણા મહાન રાજાઓ અને તેમના મંત્રીઓ દ્વારા બાંધવામાં આવેલા મોટાભાગના મંદિરોનો નાશ કરવામાં આવ્યો હતો. પાટણના ખેતરવાસી ખાતે મહાદેવ કી શેરીમાં મહાદેવ પાર્શ્વનાથનું મંદિર છે. મહાદેવ પાર્શ્વનાથની મૂર્તિ ખૂબ જ પ્રાચીન, મનમોહક અને ખૂબ જ સુંદર છે. મંદિરની પ્રાચીનતા જાણીતી નથી. દર વર્ષે વૈશાખી મહિનાના શુક્લ પક્ષની 10મી તારીખે ધ્વજ પરિવર્તન કરવામાં આવે છે. ત્રણ ગર્ભગૃહ ધરાવતા આ મંદિરમાં મુલનાયક (મુખ્ય દેવ)ના રૂપમાં શ્રી મહાદેવ પાર્શ્વનાથની 23 ઇંચની મૂર્તિ છે. ત્યાં એક સારી છત્ર (છત્રીના આકારમાં આશ્રય) છે. ગર્ભગૃહની બંને બાજુએ શ્રી નેમિનાથ અને શ્રી વાસુપૂજ્યની મૂર્તિઓ છે. આરસની પાંચ મૂર્તિઓ અને 29 ધાતુની મૂર્તિઓ છે. નાનો હોવા છતાં રંગમંડપ આકર્ષક છે. શત્રુંજય અને ગિરનારના પ્રાંગણ, દિવાલો પર પેઇન્ટ-વર્ક, ફ્લોર પર વિશાળ અરીસાઓ અને આરસની ડિઝાઇન જિનાલયની કૃપામાં વધારો કરે છે, એક જગ્યાએ પાદુકાઓ (પથ્થરમાં પગની છાપ) ની પૂજા કરવામાં આવે છે - મુનિશ્રી કીર્તિવિજયજી અને મનીષી માણિક્યવિજયજી આચર્યના માર્ગદર્શક ભગવાનની પાદુકાઓ પર. તે 1892 ચિહ્નિત થયેલ છે.</p><p>અન્ય મંદિરો:- અહીં ઘણા મંદિરો છે. 108 પાર્શ્વનાથ મંદિરોમાંથી 10 પાર્શ્વનાથ મંદિરો પાટણમાં છે, આ વિશેની માહિતી પાછલા પૃષ્ઠ પર આપવામાં આવી છે.</p><p>દિશા-નિર્દેશો:- પાટણ શહેર રોડ અને રેલ દ્વારા સારી રીતે જોડાયેલ છે. બસો અને ખાનગી વાહનો અહીં ઉપલબ્ધ છે. અહીં ઘણી ધર્મશાળાઓ છે, જેમાંથી કોટવાલની ધર્મશાળા, અષ્ટપદની ધર્મશાળા, શ્રી મોહનલાલ ઉત્તમચંદની ધર્મશાળા પ્રખ્યાત છે. અહીં રેસ્ટોરાં પણ છે. પાટણ સારી રીતે સ્થાપિત જ્ઞાન આધાર ધરાવે છે. આ જિનાલયનું સંચાલન શ્રી કીર્તિભાઈ વાલચંદ શાહ, શ્રી ચિનુભાઈ નેમચંદ શાહ, શ્રી પ્રફુલ્લભાઈ જયંતિલાલ (જાંભાવાળા) કરે છે.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-060\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી ચંપા પાર્શ્વનાથ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-062\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી મહાદેવ પાર્શ્વનાથ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"current