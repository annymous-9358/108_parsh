m728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"SpeakButton\\\"]\\n22:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T4c98,\"])</script><script>self.__next_f.push([1,\"શ્રી અવંતિ પાર્શ્વનાથ. 96. શ્રી અવંતિ પાર્શ્વનાથ. મુલનાયક: કાળા રંગની 37 ઇંચ ઊંચી અને 30 ઇંચ પહોળી ભગવાન શ્રી અવંતિ પાર્શ્વનાથની પદ્માસનની મુદ્રામાં મૂર્તિ. મૂર્તિના માથા પર 7 સાપના હૂડની છત્ર છે.. તીર્થ: તે ક્ષિપ્રા નદી પાસે ઉજ્જૈન શહેરમાં છે. આ મંદિર 2,300 વર્ષ જૂનું છે.. ઐતિહાસિકતા: આ શહેરના પ્રાચીન નામ અવંતિકા, પુષ્કર્ણી અને વિશાલા હતા. તે માલવાની પ્રાચીન રાજધાની હતી. રાજા સુધન્વના શાસન દરમિયાન આ શહેર ઉજ્જૈન તરીકે જાણીતું બન્યું. રાજા સંપ્રતિ, જેમણે આચાર્ય આર્યસુહતિસૂરિની સલાહ પર 1,25,000 જૈન મંદિરોનું નિર્માણ કર્યું, 1,25,00,000 જૈન તીર્થંકરની મૂર્તિઓ સ્થાપિત કરી અને 36,000 જૈન મંદિરોનો જીર્ણોદ્ધાર કરીને શહેરને ગૌરવ અપાવ્યું. એક શુભ દિવસે, નલિની ગુલમ-વિમાનમાંથી એક ભાગ્યશાળી આત્માના જીવનનો અંત આવ્યો અને તે આત્મા ભદ્રા શેઠાણીના ગર્ભમાં અવતર્યો. તે જ સમયે ભદ્રા માતાએ એક શુભ સ્વપ્ન જોયું. ધીમે ધીમે સમય વીતવા લાગ્યો અને એક શુભ દિવસે ભદ્રા શેઠાણીએ એક અત્યંત તેજસ્વી પુત્ર-રત્નને જન્મ આપ્યો. બાળકનું નામ હતું - અવંતિસુકુમલ! ધીરે ધીરે અવંતિસુકુમલ વધવા લાગ્યો. યુવાનીના દરબારમાં પ્રવેશતાની સાથે જ તેણે પુરુષોની તમામ 72 કળાઓમાં નિપુણતા મેળવી લીધી, એટલું જ નહીં, તે ધર્મની કળામાં પણ નિપુણ બની ગયો. તેણે દેવાંગના જેવી 32 યુવતીઓ સાથે લગ્ન કર્યા.. એકવાર જ્યારે આર્ય સુહસ્તિ મહારાજ પૃથ્વીને શુદ્ધ કરી રહ્યા હતા, ત્યારે આચાર્ય આર્ય સુહતિસૂરિ તેમના શિષ્યો સાથે ઉજ્જૈન આવ્યા અને ભદ્રા શેઠાણીના વંશમાં રહ્યા. રાત્રે આચાર્ય ભગવંત નલિનીએ ગુલમા વિમાનના અભ્યાસની સમીક્ષા કરવાનું શરૂ કર્યું. તે સમયે અવંતિસુકુમલ નજીકના મકાનમાં બેસીને તેની પત્નીઓ સાથે વાતો અને મજાક કરી રહ્યા હતા. આચાર્ય ભગવંતના સ્વાધ્યાય-ધ્વનિના શબ્દો અવંતિસુકુમલના કાનમાં પડ્યા અને તે વિચારવા લાગ્યો, \\\"ઓહ! આચાર્ય ભગવંત સ્વાધ્યાયનું વર્ણન કરી રહ્યા છે... મેં તે દ્રશ્ય ક્યાંક જોયું છે\\\" - આ રીતે વિચારતા તેમને તરત જ જાતિ સ્મરણનું જ્ઞાન મળ્યું. તેણે તેના ભૂતપૂર્વ સ્વને સ્પષ્ટપણે જોવાનું શરૂ કર્યું.. તેને લાગ્યું, \\\"ઓહ! પાછલા જન્મમાં, હું આ નલિની ગુલમ વિમાનમાં ભગવાનના રૂપમાં હતો. ત્યાંના સુખ અને અહીંના સુખમાં આટલો મોટો તફાવત છે. ત્યાંનું સુખ રણ જેવું છે, જ્યારે અહીંનું સુખ સરસવ જેવું છે...\\\" (આગળના પાના પર અહીં પાનું અધૂરું રહી જાય છે, વાર્તા આગળ વધે છે).. (कथा-प्रसंग) अवंतीसुकुमाल यह विचार कर उसी समय आचार्य भगवंत के पास आकर अत्यंत विनयपूर्वक बोले, \\\"हे भगवंत! आप जिस नलिनीगुल्म विमान का वर्णन कर रहे हो, तो क्या आप उस विमान में से आ रहे हैं?\\\" आचार्य भगवंत ने कहा, \\\"नहीं, हम तो श्रुत (शास्त्र) के बल से उस विमान का वर्णन कर रहे हैं।\\\" अवंतीसुकुमाल बोले, \\\"प्रभो! मैं उसी देवविमान से च्यवकर आया हूँ - जातिस्मरण ज्ञान से मुझे उस विमान के सुख प्रत्यक्ष दिखाई दे रहे हैं...अब मुझे यहाँ के सुख तुच्छ प्रतीत हो रहे हैं। अतः मैं यहाँ रहने में समर्थ नहीं हूं, वहां पुनः जाने के लिए मैं दीक्षा लेना चाहता हूँ, आप मुझे दीक्षा प्रदान करें।\\\". आचार्य भगवंत ने कहा, \\\"महानुभाव! लोहे के चने चबाना सरल है किन्तु संयम का पालन दुष्कर है।\\\" अवंतीसुकुमाल ने कहा, \\\"प्रभो! प्रव्रज्या ग्रहण करने के लिए मेरा मन अत्यंत उत्कंठित है...मैं दीर्घकाल तक संयम पालन करने में असमर्थ हूँ, अतः दीक्षा अंगीकार कर तुरंत ही अनशन व्रत स्वीकार कर लूंगा, जिससे अल्पकाल के कष्टों से ही मेरा कार्य सिद्ध हो जाएगा।\\\" गुरुदेव ने कहा कि यदि दीक्षा ग्रहण करने की इच्छा है, तो अपनी माता व पत्नियों की सम्मति लेकर आ जाओ। अवंतीसुकुमाल ने जाकर अपनी माता व पत्नियों से बात की, परन्तु अनुमति न मिलने पर उन्होंने स्वयं ही दीक्षा अंगीकार कर ली।. साधु-वेश धारण कर वह आचार्य भगवंत के पास आए और उन्हें दीक्षा प्रदान की गई। तत्पश्चात दीर्घकाल तक कष्ट सहन करने में असमर्थ होने के कारण तत्काल गुरुदेव की अनुज्ञा लेकर अनशन व्रत स्वीकार कर वहां से श्मशान में जाकर कायोत्सर्ग ध्यान में खड़े हो गये। पूर्वभव की वह स्त्री, जो मरकर सियारिनी बनी थी, वहां आई और अपने वैर का बदला लेने के लिए अवंतीसुकुमाल पर भयंकर उपसर्ग करने लगी - पहले उनके पैर का भाग खाया, फिर अपने बच्चों सहित पेट आदि खाने लगी। इतने कष्ट में भी अवंतीसुकुमाल अपने शुभ-ध्यान से लेशमात्र भी विचलित नहीं हुए और समाधिपूर्वक कालधर्म प्राप्त कर नलिनीगुल्म विमान में देव रूप में उत्पन्न हुए।. प्रातःकाल देवताओं ने आकर उनका महोत्सव किया। इधर अवंतीसुकुमाल को न देखने पर उनकी पत्नियों ने आचार्य भगवंत से पूछा, जिन्होंने ज्ञानोपयोग द्वारा सारी घटना बताई। यह सुनकर वे रानियां भद्रा माता के पास गईं और उन्हें सब कुछ बताया। भद्रा माता अपनी पुत्रवधुओं सहित श्मशान गईं और पुत्र के मृत-कलेवर को देखकर करुण विलाप करने लगीं। उसके बाद अंतिम क्रिया की गई। पुत्र-वियोग की वेदना से प्रतिबोध पाकर भद्रा माता भी दीक्षा लेने को तैयार हो गईं, और उनके साथ अवंतीसुकुमाल की सभी रानियां भी दीक्षा के लिए तैयार हो गईं। अंततः एक गर्भवती रानी को छोड़कर भद्रा माता ने अन्य 31 पुत्रवधुओं सहित भागवती दीक्षा अंगीकार कर ली।. समय बीतने पर उस गर्भवती रानी ने एक पुत्र को जन्म दिया, जो बड़ा होकर महाकाल कहलाया। महाकाल ने आर्य सुहस्तिसूरीश्वरजी के निर्देशन में, भगवान महावीर के निर्वाण के 250 वर्ष बाद, अपने पिता की स्मृति में इस भव्य मंदिर का निर्माण कराया और भगवान पार्श्वनाथ की मूर्ति स्थापित कर पिता के सम्मान में इसे *श्री अवंती पार्श्वनाथ* कहा गया। चूंकि यह मंदिर महाकाल द्वारा बनवाया गया था, इसलिए इसे महाकाल चैत्य के नाम से भी जाना जाने लगा। राजा पुष्यमित्र (शिव भक्त) के शासनकाल में यह तीर्थ महाकाल महादेव (शिव) का मंदिर बन गया।. श्री वृद्धिविदसूरी अपने शिष्य कुमुदचंद्र से अप्रसन्न थे और उन्हें गुप्त यात्रा करके प्रायश्चित करने को कहा। उनके उपदेश सुनकर 18 राजा जैन बन गए। कुमुदचंद्र उज्जैन आए और शिवलिंग पर पैर रखकर महाकाल मंदिर में सो गए, जिसके लिए उन्हें पीटा गया, पर उन्हें कुछ नहीं हुआ - इसके बजाय कोड़े रानी की पीठ पर लग रहे थे। इससे आश्चर्यचकित राजा विक्रमादित्य ने माफी मांगी और कारण पूछा। कुमुदचंद्र ने कल्याण मंदिर स्तोत्र का जप शुरू किया और जब वे ग्यारहवें श्लोक का जाप कर रहे थे, तब भगवान पार्श्वनाथ की एक सुंदर मूर्ति शिवलिंग से प्रकट हुई (आज भी वह शिव मंदिर इस मंदिर में विद्यमान है)। यह देख राजा विक्रमादित्य जैन धर्म के अनुयायी बन गए और उन्होंने कुमुदचंद्र को \\\"श्री सिद्धसेन दिवाकर\\\" नाम दिया, जो महान आचार्य बने। इस प्रकार यह तीर्थ प्रसिद्ध हुआ और जैन धर्म को प्रसिद्धि मिली।. इस तीर्थ का मूलनायक को उत्थापित किए बिना ही जीर्णोद्धार कर विशाल रंगमंडप के साथ निर्माण किया गया तथा वि.स. 2075 महा सुद 14 को आचार्य भगवंत श्री जिनमणिप्रभसूरीश्वरजी की शुभ निश्रा में प्रतिष्ठा सम्पन्न हुई।. अन्य मंदिर: वर्तमान में उज्जैन में 32 मंदिर हैं, इनमें से 5 बड़े हैं। शहर में आदिनाथ का मंदिर सबसे पुराना है और इसका महान इतिहास है - यहीं श्रीपाल और मायासुंदरी ने भगवान आदिनाथ की पूजा व नवपद ओली की, जिससे श्रीपाल अपनी बीमारी से ठीक हो गए। मणिभद्र इन्द्र महाराज के अवतरण से पूर्व माणक सा सेठ के रूप में उज्जैन में रहते थे, जहां उनके निवास स्थान पर माणक सा सेठ का मस्तक आकर गिरा था। वहां मणिभद्र वीर का नवनिर्मित मंदिर बना है, जहां उनके मस्तक की पूजा होती है। अवंती पार्श्वनाथ मंदिर के सामने एक दादावाड़ी भी है।. કલા અને શિલ્પના કાર્યો: ભગવાન પાર્શ્વનાથની આ મૂર્તિ પ્રાચીન અને ચમત્કારિક છે. અવંતી પાર્શ્વનાથના નવા મંદિરમાં સફેદ માર્બલના શિખરબંધ સાથે ખૂબ જ કલાત્મક કોતરણીનું કામ કરવામાં આવ્યું છે.. દિશા નિર્દેશો: આ મંદિર મુખ્ય રેલ્વે સ્ટેશનથી 1.5 કિલોમીટરના અંતરે છે. ઉજ્જૈન ઈન્દોરથી 56 કિલોમીટરના અંતરે છે. બસ સેવાઓ અને ખાનગી વાહનો ઉપલબ્ધ છે. અહીં ધર્મશાળા અને ફૂડ હોલની સુવિધા ઉપલબ્ધ છે. શ્રી મણિભદ્રવીરનું મૂળ મંદિર અહીંથી 5 કિમીના અંતરે છે.. શાસ્ત્રો: આ મંદિરનો ઉલ્લેખ \\\"શ્રી વૃદાવનાથ ચંદ\\\", \\\"તીર્થમાલા\\\", \\\"શ્રી વિથેશ્વર પાર્શ્વનાથ ચંદ\\\", \\\"શ્રી વિદ્યાવાદી પ્રબંધ\\\", \\\"શ્રી વિશ્વેશ્વર પાર્શ્વનાથ\\\", \\\"શ્રી પાર્શ્વનાથ નામમાલા\\\" વગેરેમાં મળે છે. મહારાષ્ટ્રના યેવંતી પાર્શ્વનાથ ગામનું એક મંદિર પણ છે. મુંબઈના સાંતાક્રુઝમાં આવેલા કલીકુંડ પાર્શ્વનાથ મંદિરમાં, ભીલડિયાજી તીર્થમાં અને જીરાવાલા તીર્થમાં અવંતી પાર્શ્વનાથની પ્રત્યેક એક મૂર્તિ છે.. વખાણ: જ્યારે અવંતિસુકુમાર સારી સ્મૃતિમાં બાંધવામાં આવ્યા હતા, ત્યારે કલ્યાણ મંદિર થાકેલા શુક્રવારે ભગવાનને દેખાતું હતું, જ્યારે મણિભદ્રવીર પાન પ્રભુ તેમની બાજુમાં જાગતા હતા. 