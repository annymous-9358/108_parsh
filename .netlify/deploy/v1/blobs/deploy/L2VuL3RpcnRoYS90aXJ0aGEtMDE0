nter with the Bhil. It is for this that it is said, \\\\\\\"Oh karma! Strange indeed are your ways...\\\\\\\"\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"children\\\":\\\"T\"])</script><script>self.__next_f.push([1,\"his same prince of Kashi, this same god of Mount Sammed Shikhar,\\\"}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"19\\\",{\\\"children\\\":\\\"This same sun of Ahikshetra, ever awakened, who fills the heart with pure light!\\\"}]\\n2e:[\\\"$\\\",\\\"p\\\",\\\"20\\\",{\\\"children\\\":\\\"This is the very Parshwa whom devotees dug out of the earth at Khambhat —\\\"}]\\n2f:[\\\"$\\\",\\\"p\\\",\\\"21\\\",{\\\"children\\\":\\\"Chant the rosary of Parshwa, the wish-fulfilling gem, and every worry and anxiety shall vanish!\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[lang]/tirtha/[slug]/layout,_N_T_/[lang]/tirtha/[slug]/page,_N_T_/en/tirtha/tirtha-014"},"segmentPaths":["/_tree","/_full","/$d$lang/tirtha/$d$slug/__PAGE__","/$d$lang/tirtha/$d$slug","/$d$lang/tirtha","/$d$lang","/_index","/_head"],"revalidate":60,"cacheControl":{"revalidate":60,"expire":31536000}}}