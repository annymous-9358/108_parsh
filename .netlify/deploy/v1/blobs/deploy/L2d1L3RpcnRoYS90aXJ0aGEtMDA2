\\"div\\\",\\\"f9deb916-ac36-47c6-a7ef-db853ba0b1db\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L25\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_5466.jpeg\\\",\\\"alt\\\":\\\"શ્રી અમીઝરા પાર્ષ્વનાથ (ગાંધાર્ય પાર્ષ્વનાથ) फोटो 2\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"ગંધાર, તા. વાગરા, જિલ્લો-ભરૂચ.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"મૂળનાયક: સફેદ રંગની પદ્માસન મુદ્રામાં લગભગ ૧૭૫ સેન્ટીમીટર ઊંચી ભગવાન અમિઝારા પાર્ષ્વનાથની મૂર્તિ.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"તીર્થ: આ ગંધાર ગામની નજીક સમુદ્રના કિનારે આવેલું છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"ऐतिहासिकता: गंधार मध्य युग कું એક પ્રાચીન અને ખૂબ જ સમૃદ્ધ શહેર હતું. તે દિવસોમાં અહીં ૧૭ જૈન મંદિરો હતા. પ્રાચીન જૈન મંદિરોના અવશેષ આજે પણ મળી આવે છે. આ શહેર જે અતીતમાં ૩ માઈલના ક્ષેત્રમાં ફેલાયેલું હતું, આજે એક નાનું ગામ છે અને આ જૈન તીર્થ માટે પ્રસિદ્ધ છે. પ્રાચીન કાળમાં ગંધાર એક ખૂબ જ વિકસિત બંદર અને વ્યાપાર કેન્દ્ર હતું. ૭૬૯-૭૭૦ ઈ. માં સિંધના રાજાએ ગંધાર પર હુમલો કર્યો અને તમામ મંદિરો અને મૂર્તિઓનો નાશ કરી નાખ્યો, મોટાભાગના મંદિરોને મસ્જિદોમાં ફેરવી દેવામાં આવ્યા. ૧૭મી સદીમાં આ શહેર ફરીથી સમૃદ્ધ બન્યું અને ઘણા જૈન મંદિરો સાથે એક ખૂબ જ લોકપ્રિય જૈન કેન્દ્ર બન્યું. જગતગુરુ શ્રી હીરવિજયસૂરીશ્વરજી પોતાના વિશાળ શિષ્ય સમુદાય (લગભગ ૩૦૦ સાધુ અને ૭૦૦ સાધ્વીઓ) સાથે ત્રણ-ત્રણ ચાતુર્માસ માટે ગંધાર આવ્યા હતા. અહીં રાજા અકબરે તેમને ફતેહપુર-સીકરી આવવાનું આમંત્રણ મોકલ્યું, જેને ગુરુદેવે સ્વીકાર્યું. ૧૮મી સદીમાં જ્યારે આ શહેરનો નાશ કરવામાં આવી રહ્યો હતો, ત્યારે તીર્થંકરોની મોટાભાગની મૂર્તિઓને નજીકના રાજપૂત રાજ્ય દહેજ ગામ લઈ જ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"केवલ મહાવીર સ્વામીના મંદિર અને અમીઝારા પાર્ષ્વનાથના મંદિરને મસ્જિદનું સ્વરૂપ આપીને મૂર્તિઓને ભોંયરામાં છિપાવીને મૂકી દેવામાં આવ્યા હતા, આ ભોંયરું આજે પણ છે. બાકીના મંદિરો નાશ પામ્યા. વિ.સં. ૧૫૦૦માં મહાવીર સ્વામીના મંદિરનું નિર્માણ ખંભાતના રાજિયા વાજિયા દ્વારા કરાવવામાં આવ્યું હતું.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"આ જીર્ણશીર્ણ મંદિરનું વિ.સં. ૧૮૧૦માં પુનર્નિર્માણ કરવામાં આવ્યું હતું અને શ્રી અમીઝારા પાર્ષ્વનાથની મૂર્તિને વિ.સં. ૧૬૫૯માં આચાર્ય શ્રી વિજયેન્દ્રસૂરિશ્વરજીના શ્રદ્ધેય હાથે સ્થાપિત કરવામાં આવી હતી. આ મૂર્તિ ફરીથી વિ.સં. ૧૯૬૪માં માઘ મહિનાના શુક્લપક્ષના પાંચમા દિવસે એક નવા મંદિરમાં સ્થાપિત કરવામાં આવી હતી. ઘણી વખત પાર્ષ્વનાથ ભગવાનની આ મૂર્તિમાંથી અમૃત (આમી) નીકળતું રહે છે, માટે આ મૂર્તિને \\\\\\\"અમીઝારા પાર્ષ્વનાથ\\\\\\\"ના નામથી ઓળખવામાં આવે છે. આ મંદિર ગંધારમાં હોવાથી આ પાર્ષ્વનાથને \\\\\\\"ગાંધાર્ય પાર્ષ્વનાથ\\\\\\\" તરીકે પણ ઓળખવામાં આવે છે. આચાર્યદેવ શ્રી વિજય રામચંદ્રસૂરિશ્વરજીને વિક્રમ સંવત ૧૯૬૯માં ગાંધારના આ પવિત્ર સ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"કલા અને મૂર્તિકલા ના કાર્ય: આ સ્થાન નું પ્રાકૃતિક દૃશ્ય ખૂબ સુંદર અને રમણીય છે. મંદિર ની દિવાલો પર શત્રુંજય મહાતીર્થ, ગિરનાર, સમ્મેતશિખર આદિ તીર્થ સ્થાનો ના ચિત્ર છે. પાર્ષ્વનાથ ભગવાન ની મૂર્તિ પ્રાચીન, સુંદર, આકર્ષક, ચમત્કારી અને વિસ્મયકારી છે. આ તીર્થ ભરૂચ ના પંચતીર્થી માંથી એક છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"દિશાનિર્દેશ: નજીક નું રેલ્વે સ્ટેશન પખાજન છે, મંદિર થી 13 કિલોમીટર ના અંતરે ભરૂચ-કવિ રેલ્વે લાઇન પર છે. આ મંદિર ભરૂચ થી 45 કિલોમીટર અને કવિ થી 65 કિલોમીટર ના અંતરે છે. અહીં બસ સેવા અને ખાનગી વાહન ઉપલબ્ધ છે. ધર્મશાળા અને ભોજનશાળા ની સુવિધા ઓ અહીં ઉપલબ્ધ છે, ઉપાશ્રય પણ છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"શાસ્ત્ર: અમિઝારા પાર્ષ્વનાથ નો ઉલ્લેખ \\\\\\\"365 શ્રી પાર્ષ્વ જિન નામમાળા\\\\\\\", \\\\\\\"શ્રી શંખેશ્વર પાર્ષ્વનાથ છંદ\\\\\\\", \\\\\\\"શ્રી ભટેવ પાર્ષ્વનાથ સ્તવન\\\\\\\", \\\\\\\"108 નામ ગર્ભિત શ્રી ભગવાન પાર્ષ્વનાથ સ્તવન\\\\\\\", \\\\\\\"108 નામ ગર્ભિત શ્રી ગોડીપાર્ષ્વનાથ સ્તવન\\\\\\\", \\\\\\\"શ્રી હીરવિજય સૂરિ રાસ\\\\\\\", \\\\\\\"શ્રી પાર્ષ્વનાથ નામ માળા\\\\\\\", \\\\\\\"તીર્થ માળા\\\\\\\", \\\\\\\"135 નામગર્ભિત શ્રી પાર્ષ્વનાથ સ્તવન\\\\\\\", \\\\\\\"શ્રી પાર્ષ્વનાથ ચૈત્ય પરિપાટી\\\\\\\" વગેરે માં થયો છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"स्तुति: ગંધાર નગરે વિરાજતા હે ગંધ સમા વિભુ, અમૃત ઝરેં તુજ નયનથી ને વયણથી પાર્ષ્વ પ્રભુ, તુજ દર્શન સહુ ભવિક ના સંતાપ તાપ શમી જતા, શ્રી અમીઝરા પાર્ષ્વ ને ભાવે કરૂં હું વંદના.\\\"}],\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/gu/tirtha/tirtha-004\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L22\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"શ્રી કલ્હારા પાર્ષ્વનાથ\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/gu/tirtha/tirtha-007\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"શ્રી અમીઝરા પાર્શ્વનાથ\\\"}],[\\\"$\\\",\\\"$L22\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n21:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"mt-auto border-t border-sandstone-deep/60 py-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"મૂળ સ્રોત: રાજેન્દ્ર કુમાર જૈન, પાર્શ્વ સદન, પાર્શ્વ નગર, ડુંગરપુર\\\"}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"children\\\":\\\"જાપ મંત્ર: ઓં હ્રી અહ્઱મ્ શ્રી અમીઝરા પાર્ષ્વનાથય નમઃ.\\\"}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"શ્રી અમીઝરા પાર્ષ્વનાથના મંદિર ભારતમાં ઘણા સ્થાનોએ છે - મુખ્ય મંદિર ગંધારમાં છે. ખંભાતમાં, દુઆ (બનાસકાંઠા), જીરલાપડો નજીક ખેડા, સાણંદ, ગિરનાર તીર્થ, આસપુર (વાગડ) જિલ્લો ડુંગરપુર, જુન્નર, સાંગલી (મહારાષ્ટ્ર)માં પટેલ વાડા, ગિરિયાધર (સૌરાષ્ટ્ર), શ્રી શત્રુંજય તીર્થ, અમીઝરા (મધ્ય પ્રદેશ), કોલીવાડા નાકા ઊના, મુંદ્રા (કચ્છ), વડાલી, સોજીત્રા અને ઘણા અન્ય સ્થાનોએ મંદિર છે. અમીઝરા પાર્ષ્વનાથની એક મૂર્તિ જિરાવાલા પાર્ષ્વનાથ તીર્થમાં, અને મુંબઈના સાંતાક્રુઝમાં કાલીકુંડ પાર્ષ્વનાથ મંદિરમાં, તથા પાલિતાણામાં કેસરિયા નગર મંદિરમાં પણ છે.\\\"}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"ટ્રસ્ટ: શ્રી અમીઝારા પાર્ષ્વનાથ શ્વેતાંબર જૈન તીર્થ, શ્રી ગંધાર જૈન દેરાસર ટ્રસ્ટ, મુ.પો. ગંધાર-૩૯૨૧૪૦, તાલુકો વાગરા, જિલ્લો ભરૂચ, રાજ્ય ગુજરાત, ભારત. ફોન: ૦૨૬૪૧-૨૩૨૩૪૫, મોબાઇલ નં.: ૦૮૨૦૦૪૦૭૯૯૯ (જૈન દેરાસર ટ્રસ્ટ), ૦૯૯૦૯૪૧૫૯૦૪.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_