ttom:0;color:transparent\" sizes=\"(min-width: 640px) 33vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12988.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>74. श्री हमीरपुरा पार्श्वनाथ</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में 27 इंच ऊंची व 23 इंच चौड़ी भगवान श्री हमीरपुरा पार्श्वनाथ की मूर्ति। परिकर में 5 नाग के फणों का खूबसूरत छत्र है।</p><p>तीर्थ: यह मंदिर एक जंगल के बीच स्थित है जो तीन तरफ से पहाड़ियों से घिरा हुआ है। मीरपुर गाँव से 2 किलोमीटर दूरी पर है।</p><p>ऐतिहासिकता: यह कहा जाता है कि इस शहर की स्थापना विक्रम वर्ष 808 में देवड़ा हमीर ने की थी और इसे हमीरपुर के नाम से जाना जाता है। हमीर के घर में देवी के आगमन होने से इनके वंशज देवड़ा कहलाता है। इस शहर को हमीरगढ़ के नाम से भी जाना जाता था क्योंकि यहाँ एक मजबूत किला था। जैन मंदिर 9वीं शताब्दी ईस्वी में राजपूतों के शासनकाल के दौरान बनाया गया था। इस मंदिर को आमतौर पर राजस्थान का सबसे पुराना संगमरमर का स्मारक माना जाता है। एक शिलालेख है जिसमें कहा गया है कि यह मंदिर राजा संप्रति द्वारा बनाया गया था। इस संदर्भ में वी.एस.821 में आचार्य जयानंदसूरीश्वरजी के शिष्य श्री सामंत द्वारा मंदिर का जीर्णोद्धार करने का उल्लेख है। यहां बिखरे अवशेषों से पता चलता है कि यह एक समय में एक बड़ा और समृद्ध शहर था। इस मंदिर को 13वीं शताब्दी में महमूद बेगड़ा ने नष्ट कर दिया था, और 15वीं शताब्दी में इसका पुनर्निर्माण किया गया था। मंदिर के खंभों पर विक्रम वर्ष 1550 और 1556 के दौरान किए गए जीर्णोद्धार की अवधि के शिलालेख हैं। यह श्री पार्श्वचंद्रसूरि महाराज साहब का जन्म-स्थान है, जो वीर संवत 137 में पैदा हुए थे। पौष कृष्णा 10, चैत्र पूर्णिमा और कार्तिक पूर्णिमा को हर साल यहां मेला लगता है। इस मंदिर का उल्लेख &quot;विश्व और कला के विश्वकोश&quot; में भी है। इस मंदिर का हाल ही में जीर्णोद्धार किया गया था। आज हमीरपुर को &quot;मीरपुर&quot; के नाम से जाना जाता है।</p><p>अन्य मंदिर: इस मंदिर के अलावा वर्तमान में तीन और मंदिर हैं।</p><p>कला और मूर्तिकला के कार्य: इस स्थान की कला अतुलनीय है। ऐसा माना जाता है कि गुंबदों, मेहराबदार दरवाजों और खंभों की शिल्पकला हजार साल से भी पुरानी है। मंदिर में हाथियों की नक्काशी पल्लव के समय की कला का सबसे अच्छा काम लगती है। यहाँ शिखर बनाने में दिखाई गई निर्माण की कला माउंट आबू से भिन्न है। अपने अद्वितीय एकान्त वातावरण, अपनी कला और अपनी प्राचीनता के कारण इस तीर्थ का अपना विशेष महत्व है। चारों ओर यक्ष, गन्धर्व, देवी-देवताओं की आकृतियाँ बहुत ही सूक्ष्मता से उकेरी गई हैं। इस मंदिर की अवर्णनीय कलात्मकता दुनिया भर में प्रसिद्ध है और कई लोगों द्वारा इसे बेजोड़ माना जाता है। ऐसा कहा जाता है कि यहां शिखर पर प्रदर्शित कलात्मकता माउंटआबू के मंदिरों से भी आगे है। इस मंदिर के कोनों-किनारों पर भी गढ़े हुए हाथियों से ऐसा प्रतीत होता है कि मन्दिर उन पर खड़ा है। इस मंदिर की प्राचीन मूर्तिकला माउन्ट आबू, देलवाड़ा आदि की याद दिलाती है। इस एकाकी स्थान का शांतिपूर्ण वातावरण ध्यान (मेडीटेशन) हेतु बहुत सुंदर स्थान है। इसकी प्राकृतिक सुंदरता और मंदिर के सामने सूर्य-दर्शन का दृश्य शानदार है। श्री गोडीजी पार्श्वनाथ, पायधुनी मुम्बई की मूर्ति यहां से ले जाकर वहां स्थापित की गई है।</p><p>दिशानिर्देश: मंदिर से निकटतम रेलवे स्टेशन सिरोही 37 किलोमीटर की दूरी पर है। आबू से 60 किलोमीटर की दूरी पर है और सिरोही शहर से 15 किलोमीटर की दूरी पर है। बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं। यहां से दीयाणा 54 किमी, जिरावाला 24 किमी, पावापुरी तीर्थ 36 किमी दूरी पर है।</p><p>शास्त्र: इस मंदिर का उल्लेख राजा वीरपति ने &quot;वीरवंशावली&quot; नामक रचना में किया है। प्रशंसनीय कविता &quot;शतपदिका&quot; की हस्तलिखित पांडुलिपि में स्थानीय पल्लीवाल श्रेष्ठी के बारे में उल्लेख किया गया है। यहीं पर विक्रम वर्ष 1576 में तप गच्छ के श्री इंद्रानादसूरीजी के प्रमुख शिष्य श्री सौभाग्यसूरीजी ने &quot;मौन एकादशी&quot; की कथा की रचना की थी। हमीरपुरा पार्श्वनाथ का उल्लेख &quot;श्री शंखेश्वर पार्श्वनाथ छंद&quot;, &quot;तीर्थमाला&quot;, &quot;श्री 108 नाम गर्भित पार्श्वनाथ छंद&quot; आदि में किया गया है। श्री हमीरपुरा पार्श्वनाथ की एक मूर्ति मुंबई के सांताक्रूज में कलिकुंड पार्श्वनाथ मंदिर में है।</p><p>स्तुति: बलतो उतार्यो नागने तेमा शु मार्यो मीर ते, मुझे मोहपीर ने मारशो तो मानु तारा हीर ने, मीरपुर निवासी हे प्रभु तू वीर ने वडधीर छ। &quot;श्री हमीरपुरा पार्श्व ने भावे करूं हुं वंदना&quot;</p><p>जाप मंत्र: ॐ ह्री अर्हम् श्री हमीरपुरा पार्श्वनाथय नमः</p><p>ट्रस्ट: श्री मीरपुर पार्श्वनाथ श्वेतांबर जैन तीर्थ, पोस्ट: मीरपुर-307001, जिला: सिरोही, राजस्थान राज्य, भारत। फोन: 02972-286737</p></article><nav class=\"mt-14 flex items-center justify-between bord