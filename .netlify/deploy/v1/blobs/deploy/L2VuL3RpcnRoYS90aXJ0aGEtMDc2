wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"SpeakButton\\\"]\\n22:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T2c5b,\"])</script><script>self.__next_f.push([1,\"Shri Dokadiya Parshwanath. 57th of the 108 Parshwanaths -- Shri Dokadiya Parshwanath.. Location: Derasar ni Khadki, Prabhas Patan.. Main Deity: Shri Chandraprabhu Swami is the main deity (Mulanayak) here. In the sanctum to the left of Shri Chandraprabhu Swami is a black-colored image of Shri Dokadiya Parshwanath, 39 inches tall and 31 inches wide, in the padmasana posture with a tall, striking parikar. Above the head of the image is an attractive canopy of 9 serpent hoods.. Location: This is in Prabhas Patan city, by the seashore.. History: This is a very ancient and famous city. In the medieval period this city was known as Devpatan, Somnathpattan, and Chandraprabha Patan. It is said that the city was founded by Bharat Chakravarti, and that this temple was built when it became known that the samavasaran (holy assembly) of the future 8th Tirthankara, Shri Chandraprabhu Bhagwan, would be established here. In the 13th century, Shri Kumarpal Maharaja built the temple of Ashtapadji here. When Vallabhipur was destroyed by Muslim invaders in Vikram Samvat 845, the image of Bhagwan Chandraprabhu Swami was brought from Vallabhipur and installed here. Many temples here that were destroyed during Muslim invasions were converted into mosques.. The image of Shri Dokadiya Parshwanath, which is very powerful and miraculous, stands beside the image of Chandraprabhu Swami. There is a story behind the name Dokadiya Parshwanath given to this image. A Shravak who came every morning before anyone else to worship Dokadiya Parshwanath would find a 'dokda' (a coin of that period) placed in the Lord's palm each day. This continued for many days. One day he told another person about this occurrence. The next day the dokda was there, but it was stuck fast to the Lord's palm -- and even today we can see that coin on the Lord's palm. Hence this Parshwanath came to be known as 'Dokadiya Parshwanath.' This Parshwanath is also known as 'Dada Parshwanath.' Devotees have great faith in this miraculous and powerful image of Dokadiya Parshwanath. In the basement of this temple is a temple of the 45 Agamas (the principal scriptures of Jainism). All the Agamas have been beautifully inscribed on copper plates.. Other Temples: There are 7 temples close by (within the complex) of this temple. There is also a temple in the town itself.. Art and Sculpture: The view of this temple, situated by the seashore, is extremely enchanting and captivating. The artistry of the temple is beautiful. The nine large halls for sitting and worship are unique and magnificent. The antiquity of the temple is evident from the ancient artwork visible within it. The many artistic works visible on the interior walls make it clear that the temple is very ancient. Similarly, the many artistic works visible on the interior walls of the local mosque make it clear that these old temples must have been converted into mosques. Also, 5 kilometers from here is the famous, beautiful and ancient Somnath Temple, home to the first of the twelve sacred Jyotirlingas.. Directions: The nearest railway station, Veraval, is 7 kilometers away, from where buses and taxis are available for transport. The city's bus stand is close to the temple. There is a paved road to the temple, and buses and cars can reach it. Dharamshala and bhojanshala facilities are available here. Chorwadi Tirth is 25 kilometers from here. The Gir Forest and Gujarat's national park, home to Asiatic lions and chinkara, are 50 kilometers from here. Delwada, Una, Diu, Mangrol, and Girnar Tirth are all very close by.. Scripture References: Shri Dokadiya Parshwanath is mentioned in 'Tirthamala,' 'Shashwat Tirthamala,' 'Godi Parshwanath Stavan,' 'Shri Parshwanath Nammala,' and elsewhere. Shri Samyasundar Upadhyayji Maharaj wrote the 'Shri Dokadiya Parshwanath Ras.' There is an image of Shri Dokadiya Parshwanath at Jiravala Tirth.. Hymn of Praise: O giver of dokdas, Shri Dokadiya Parshwanathji, remover of my sorrows too, be my Lord; enthroned in the new sanctum of Prabhas Patan, ferrying beings across worldly existence. 'I bow with devotion to Shri Dokadiya Parshwa.'. Chanting Mantra: 'Om Hrim Arham Shri Dokadiya Parshwanathay Namah.'. Trust: Shri Dokadiya Parshwanath Shwetambar Jain Tirth, c/o Shri Prabhas Patan Shwetambar Jain Murtipujak Sangh, Derasar ni Khadki, Mu. Po.: Prabhas Patan, Taluka: Veraval, District: Junagadh - 362268, Saurashtra, Gujarat, India. Phone: 02876-231638, Mobile: 9978358874.. Key Features of the Shri Chandraprabhu Swami Temple: It is believed that this temple was established by Shri Bharat Chakravarti, son of Shri Adinath Prabhu. It is said that when Bharat Chakravarti, having revived the temple of Shri Siddhachalji and being drawn by the discourses of Shri Adishwar Prabhu, led a pilgrimage congregation of Jains, he camped for some time here on the banks of the Brahmi (Saraswati) River. Somyakumar, son of Shri Bahubali, who at that time was observing this forest region, found many sages engaged in profound austerities. On inquiring, he was told that they were the Vidyadharas of Vaitadhya Giri, and that, having heard from Shri Dharanendra Dev (the guardian deity of Shri Parshwanath Bhagwan) -- who cures all ailments -- about the significance of this forest bordering the sacred river Saraswati, they were performing these austerities for their own spiritual progress. He was further told that a samavasaran of the future 8th Tirthankara, Shri Chandraprabhu Bhagwan, would be established here. Shri Somyashakumar shared this information with his brother Bharat Chakravarti, who later founded this city and built this temple of Shri Chandraprabhu Bhagwan.. According to evidence available in this regard, this site was subsequently visited by Sagar Chakravarti, Chandrayasha, Chakradhar, King Dasharatha, the Pandavas, the king of Hastinapur, and others. This pilgrimage site is mentioned in the work titled 'Shatrunjay Mahatmya' (on the greatness and importance of Shatrunjay), composed by Shri Dhaneshwarsuriji in Vikram year 370. In earlier millennia the temple was known by the names Devpatan, Patan, Somnath, Prabhas, and Chandraprabha. This pilgrimage site is also mentioned in the Jain Agama 'Brihat Kalpasutra.' There is a reference stating that when the city of Vallabhipur was destroyed by non-Aryan invaders in the 4th century, the images of Devi Ambadevi and others, which had flown here through the sky, were installed in the temples here. This pilgrimage site is also mentioned in the 'Videh Tirthakalpa,' composed by Shri Jinaprabhasurishwarji in the 14th Vikram century, and in the 'Shri Prabandh Chintamani,' written by Shri Merutungsursuri in Vikram year 1361. It is said that King Shri Siddharaj Jaisingh of Gujarat, Minister Vastupal Tejpal, the Pithadhish Samarshah, and Shri Rajsi Sanghvi, among others, visited this pilgrimage site. There is also a reference that King Kumarpal, on the advice of the omniscient Kalikal Sarvagya Shri Hemchandracharya, built many temples here. It is said that this temple suffered heavy damage during the period of Mohammad Ghazni and during subsequent Muslim rule. As available inscriptions indicate, five rounds of 'Anjanshalaka' (eye-consecration) and abhishek (ritual bathing) rites were performed in the gentle presence of Shri Vijaysensuriji, disciple of Vijayshirsurishwarji, during the period between Paush Sukla 6 and Magh Sukla 6 in Vikram year 1666. In Vikram year 1876 the temple was again renovated on the advice of Shri Vijayjitendrasuriji. After a further renovation completed on Magh Sukla 6 in Vikram year 2008, the pilgrimage site was formally reconsecrated, and Acharya Shri Chandrasagarsuriji was recognized as the chief disciple of Agroddharak Acharya Dev Shri Anand Sagar Suri. All this information makes clear the antiquity of this pilgrimage site. In Vikram year 1264, Shri Devendrasuriji composed the 5,325-verse 'Shri Chandraprabh Charitra' here. In the 14th Vikram century, Shri Dharmaghoshsuriji composed a poem filled with mantras; this composition was delivered as a religious discourse here to Kapardi Yaksha, the senior guardian spirit of Mount Shatrunjay.. There are seven more temples within this temple complex, and one temple in the town. In the basement of this temple is an Agam Mandir where all the Agamas, inscribed on copper plates, are kept, and the nearby temples house images of Dokadiya Parshwanath and Bhagwan Mallinath, which are ancient, beautiful and miraculous.. The view of this temple, situated by the seashore in the city on the banks of the Saraswati River, is extremely captivating. The artistry of the temple is enchanting. Ancient art is also visible in the local mosques, and the many artistic works visible on their walls, sides and interiors make clear that these old temples must have been converted into mosques.. Purushadani Arhat Parshwanath Charitra, Part 8 (Chyavanshatru Takes Refuge with Bhagwan Parshwanath): Once, when King Ashvasen was engrossed in a discourse on Jain dharma in his royal court, a messenger arrived from a city named Kushasthal, saying: \\\"In our kingdom rules a king named Prasenjit, who is presently passing through great difficulty; please protect him.\\\" King Ashvasen then seated the messenger in the assembly and learned the full story from him. King Prasenjit's father, Naravarma, had been a follower of Jain dharma and had taken diksha under a virtuous guru. King Prasenjit had a beautiful daughter named Prabhavati. Once the princess heard from the wives of some Kinnaras that Shri Parshwakumar, son of King Ashvasen, the lord of Varanasi, was full of beauty, grace and virtue, and that any woman who had Parshwakumar as her husband would be triumphant in this world -- such a husband being difficult to obtain. Hearing of Shri Parshwakumar's virtues and fame, Prabhavati resolved that she would marry Parshwakumar alone, and no one else. When this news reached the wicked king of the Kalinga country, named Chyavanshatru, he sent a messenger to King Prasenjit demanding that Prabhavati be married to him, or else be prepared for war. Prabhavati had already chosen Parshwakumar as her betrothed. Now King Chyavanshatru, turned enemy, laid siege to the city of Kushasthal. The messenger said, \\\"I have come to you secretly, evading capture; now do whatever you think best.\\\" King Ashvasen assured him that he would subdue King Chyavanshatru in battle, and preparations for war began. As King Ashvasen was setting out to fight the king of Kushasthal, Parshwakumar stopped him and said, \\\"I too shall go to fight.\\\" On learning that Parshwakumar was going to war, the well-wishers of Chyavanshatru advised him: \\\"O King, this is a prince whose birth rites were performed by goddesses and whose birth was consecrated by the gods themselves; he is a supreme hero and a deliverer. Nothing is yet lost -- take refuge with him, and by taking his refuge this life of yours will be saved.\\\" In the end, Chyavanshatru took refuge with Bhagwan Parshwanath, and Bhagwan Parshwakumar, recognizing the rise of his bhogavali karma (karma pertaining to worldly enjoyment), married Princess Prabhavati. Seeing the well-matched pair of Parshwakumar and Queen Prabhavati, the men and women of Varanasi city were enraptured. Their love was like that of the sarus crane and his mate; their life together was like water and the lotus.\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/dzLhUUo8m2soYFGb6\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:props:children:1:props:children:0:props:iconNode\\\",\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"Open in Google Maps\\\"]}],null,[\\\"$\\\",\\\"$L20\\\",null,{\\\"text\\\":\\\"$21\\\",\\\"lang\\\":\\\"en\\\",\\\"label\\\":\\\"Listen\\\",\\\"stopLabel\\\":\\\"Stop\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-10 grid grid-cols-2 gap-2 sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"2c06d139-ff9f-469a-bbd5-e289189d7bf3\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 col-span-2 aspect-[4/3] sm:col-span-2\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_11519.jpeg\\\",\\\"alt\\\":\\\"Shri Dokadiya Parshwanath फोटो 1\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"a79e8cb9-da4f-4f22-baa1-759e1f6e7c4d\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_11469.jpeg\\\",\\\"alt\\\":\\\"Shri Dokadiya Parshwanath फोटो 2\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"32854758-b5f3-4c5e-8ed6-58ab8d797b65\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_11564.jpeg\\\",\\\"alt\\\":\\\"Shri Dokadiya Parshwanath फोटो 3\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"bdb31f7c-3b39-4bfc-85f1-265e5dcb9755\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_11508.jpeg\\\",\\\"alt\\\":\\\"Shri Dokadiya Parshwanath फोटो 4\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"2a3c1388-230e-462b-9371-7eecb2cfd963\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_11475.jpeg\\\",\\\"alt\\\":\\\"Shri Dokadiya Parshwanath फोटो 5\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"57th of the 108 Parshwanaths -- Shri Dokadiya Parshwanath.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"Location: Derasar ni Khadki, Prabhas Patan.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"Main Deity: Shri Chandraprabhu Swami is the main deity (Mulanayak) here. In the sanctum to the left of Shri Chandraprabhu Swami is a black-colored image of Shri Dokadiya Parshwanath, 39 inches tall and 31 inches wide, in the padmasana posture with a tall, striking parikar. Above the head of the image is an attractive canopy of 9 serpent hoods.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"Location: This is in Prabhas Patan city, by the seashore.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"History: This is a very ancient and famous city. In the medieval period this city was known as Devpatan, Somnathpattan, and Chandraprabha Patan. It is said that the city was founded by Bharat Chakravarti, and that this temple was built when it became known that the samavasaran (holy assembly) of the future 8th Tirthankara, Shri Chandraprabhu Bhagwan, would be established here. In the 13th century, Shri Kumarpal Maharaja built the temple of Ashtapadji here. When Vallabhipur was destroyed by Muslim invaders in Vikram Samvat 845, the image of Bhagwan Chandraprabhu Swami was brought from Vallabhipur and installed here. Many temples here that were destroyed during Muslim invasions were converted into mosques.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"The image of Shri Dokadiya Parshwanath, which is very powerful and miraculous, stands beside the image of Chandraprabhu Swami. There is a story behind the name Dokadiya Parshwanath given to this image. A Shravak who came every morning before anyone else to worship Dokadiya Parshwanath would find a 'dokda' (a coin of that period) placed in the Lord's palm each day. This continued for many days. One day he told another person about this occurrence. The next day the dokda was there, but it was stuck fast to the Lord's palm -- and even today we can see that coin on the Lord's palm. Hence this Parshwanath came to be known as 'Dokadiya Parshwanath.' This Parshwanath is also known as 'Dada Parshwanath.' Devotees have great faith in this miraculous and powerful image of Dokadiya Parshwanath. In the basement of this temple is a temple of the 45 Agamas (the principal scriptures of Jainism). All the Agamas have been beautifully inscribed on copper plates.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"Other Temples: There are 7 temples close by (within the complex) of this temple. There is also a temple in the town itself.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"Art and Sculpture: The view of this temple, situated by the seashore, is extremely enchanting and captivating. The artistry of the temple is beautiful. The nine large halls for sitting and worship are unique and magnificent. The antiquity of the temple is evident from the ancient artwork visible within it. The many artistic works visible on the interior walls make it clear that the temple is very ancient. Similarly, the many artistic works visible on the interior walls of the local mosque make it clear that these old temples must have been converted into mosques. Also, 5 kilometers from here is the famous, beautiful and ancient Somnath Temple, home to the first of the twelve sacred Jyotirlingas.\\\"}],\\\"$L23\\\",\\\"$L24\\\",\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-075\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Ajahara Parshwanath\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-077\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Chorwadi Parshwanath\\\"}],[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n1f:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"mt-auto border-t border-sandstone-deep/60 py-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur\\\"}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"Directions: The nearest railway station, Veraval, is 7 kilometers away, from where buses and taxis are available for transport. The city's bus stand is close to the temple. There is a paved road to the temple, and buses and cars can reach it. Dharamshala and bhojanshala facilities are available here. Chorwadi Tirth is 25 kilometers from here. The Gir Forest and Gujarat's national park, home to Asiatic lions and chinkara, are 50 kilometers from here. Delwada, Una, Diu, Mangrol, and Girnar Tirth are all very close by.\\\"}]\\n24:[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"Scripture References: Shri Dokadiya Parshwanath is mentioned in 'Tirthamala,' 'Shashwat Tirthamala,' 