ા જોઈ આચાર્યે તેમને જૈન ધર્મના ગુણોનો ઉપદેશ આપ્યો અને તેને અપનાવવાની પ્રેરણા આપી. ગામના લોકો જૈન બન્યા અને આચાર્ય પાસેથી જૈન ધર્મના વ્રત લીધા. શ્રાવકોએ પૂજા માટે જૈન મૂર્તિ માંગી. આ સાંભળીને આચાર્યએ તેમને તેમના બેસવાની જગ્યાએ - વટવૃક્ષ નીચે જમીન ખોદવાનું કહ્યું. ખોદકામ કરતી વખતે, તેમને એક સુંદર અને પ્રભાવશાળી પ્રતિમા, બે કાયોતસર્ગ મૂર્તિઓ, એક પિત્તળનો દીવો અને તાંબાની મૂર્તિ મળી. ભગવાનની મૂર્તિનો મહિમા જોઈને લોકો ખૂબ જ ઉત્સાહિત થઈ ગયા. 1516 ના વિક્રમ યુગમાં, જિન મંદિર નદીના કિનારે બનાવવામાં આવ્યું હતું અને શ્રી ભોભંજન પાર્શ્વનાથની હસતી મૂર્તિ સ્થાપિત કરવામાં આવી હતી. આ પ્રતિમા રાજા સંપ્રતિના સમયની હોવાનું માનવામાં આવે છે. એવું માનવામાં આવે છે કે ભગવાનની આ મૂર્તિની પૂજા કરવાથી ભક્તની મુશ્કેલીઓ દૂર થઈ જાય છે. આ પ્રતિમા 5મી સદીની છે અને આ મંદિર આજે પણ ખેડા શહેરમાં મોજૂદ છે. આ મંદિરનો જીર્ણોદ્ધાર એડી 1794 માં કરવામાં આવ્યો હતો અને તેનું છેલ્લું જીર્ણોદ્ધાર વિક્રમ યુગ 2053 માં પૂર્ણ થયું હતું. તે ઉપાધ્યાય શ્રી ઉદયરત્નાજી અને આચાર્ય શ્રી કપૂરસૂરીશ્વરજીનું જન્મસ્થળ છે. આ મંદિરમાં કાર્તિક પૂર્ણિમા અને ચૈત્ર પૂર્ણિમા જેવા પવિત્ર દિવસોનું વિશેષ મહત્વ છે.\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"p\\\",\\\"15\\\",{\\\"children\\\":\\\"$2e\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"children\\\":\\\"અન્ય મંદિરો: આ સિવાય ખેડા જિલ્લામાં આઠ મંદિરો છે.\\\"}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"17\\\",{\\\"children\\\":\\\"કલા અને શિલ્પના કાર્યો: આ પ્રતિમા રાજા સંપ્રતિના સમયની હોવાથી તેની કલાત્મકતા અસાધારણ અને અદ્ભુત છે. કયોતસર્ગ મુદ્રામાં જમીનમાંથી મળેલી આ મૂર્તિ આહલાદક છે.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[lang]/tirtha/[slug]/layout,_N_T_/[lang]/tirtha/[slug]/page,_N_T_/gu/tirtha/tirtha-017"},"segmentPaths":["/_tree","/_full","/$d$lan