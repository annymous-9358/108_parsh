\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"मुलनायक:- श्याम पाषाण की पद्मासन मुद्रा में सुंदर नक्काशीदार 9.5 इंच ऊँची 9 चौड़ी श्री वाराणसी पार्श्वनाथ की प्रतिमा जिसके मस्तक पर 5 नाग (धरनेंद्र) के फण का छत्र है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"तीर्थ:- यह उत्तर प्रदेश में वाराणसी शहर के भेलूपुर में है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"ऐतिहासिकता:- वाराणसी एक प्राचीन शहर है जो (जिसे काशी भी कहा जाता है) दो नदियाँ \\\\\\\"वरण\\\\\\\" और \\\\\\\"असि\\\\\\\" के मिलन स्थल पर स्थित है। वाराणसी, जिसे बनारस के नाम से जाना जाता है, तथा प्राचीन काल में जिसे \\\\\\\"काशी\\\\\\\" कहा जाता था। वाराणसी जैन धर्म, बौद्ध और हिंदू धर्म तीन संस्कृतियों के लिए प्रसिद्ध है। वाराणसी प्राचीन काल से अपने हिंदू विश्वविद्यालय के लिए प्रसिद्ध रहा है। प्राचीन काल से वाराणसी जैनियों और हिंदुओं का एक बहुत प्रसिद्ध तीर्थस्थल है। प्रसिद्ध काशी-विश्वनाथ मंदिर यहाँ है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"यह प्राचीन वाराणसी तीर्थ पवित्र है क्योंकि यह 4 तीर्थंकरों के 16 कल्याणक (च्यवन, जन्म, दीक्षा और केवल ज्ञान) की भूमि है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"1- भदैनी जो कि भेलुपुर से 1.5 किमी दूरी पर है यह श्री सुपार्श्वनाथ भगवान, के 4 (च्यवन, जन्म, दीक्षा और केवल ज्ञान) कल्याणक की जगह पर गंगा किनारे वच्छराज घाट पर श्री सुपार्श्वनाथ का जिनालय है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"2- चंद्रपुरी भेलुपुर से 23 किमी की दूरी पर है जो आठवें तीर्थंकर श्री चंद्रप्रभु स्वामी भगवान के 4 कल्याणक की भूमि है इस स्थान पर श्री चंद्रप्रभु स्वामी का जिनालय जिसमें श्री चंद्रप्रभु स्वामी की श्वेत पाषाण की 45 सेमी ऊँची मूर्ति तथा 5 अन्य पाषाण व एक धातु की प्रतिमा जी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"3-सिंहपुरी (सारनाथ के पास) भेलुपुर (वाराणसी) से 12 किमी की दूरी पर है जो अग्यारवें श्री श्रेयांसनाथ भगवान के 4 कल्याणक की भूमि है यहाँ शिखर बंध जिनालय जिसमें 30 सेमी ऊँची श्री श्रेयांसनाथ भगवान की श्वेत वर्ण की प्रतिमा व मंदिर में चारो तरफ कल्याणक की रचना की गई है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"4- भेलुपुर में श्री पार्श्वनाथ भगवान ने केवल ज्ञान प्राप्ति के बाद पहला उपदेश वाराणसी शहर में दिया था। वाराणसी भगवान पार्श्वनाथ का जन्म स्थान है। कमठ योगी शहर के बाहर लकड़ी जला कर हवन कर रहा था उसमें भगवान पार्श्वनाथ (पार्श्वकुमार) ने अपने अवधी ज्ञान के माध्यम से, ने नाग और नागिन की जोड़ी को जलते देखा। पार्श्वकुमार ने जलती लकड़ी को आग से निकलवा कर चिराया उसमें नागनागिन जोड़ा जलते हुए दिखा और पार्श्वकुमार ने नवकार महामंत्र का जाप किया। नवकारमन्त्र का जाप सुनकर वे स्वर्गवासी हो कर देवलोक गए और जो बाद में भगवान पार्श्वनाथ के अधिष्ठायक देव धरणेन्द्र और देवी पद्मावती बने। भगवान के समय के दौरान यह घटना वाराणसी शहर में हुई थी।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"भगवान महावीर स्वामी के समय वाराणसी मल्लकी राजाओं की राजधानी थी। मुस्लिम आक्रमण के दौरान, कई जैन, हिंदू और बुद्ध मंदिरों को मस्जिदों में बदल दिया गया। भगवान पार्श्वनाथ की मूर्ति शानदार, आकर्षक, चमत्कारी, बहुत सुंदर तथा आँखो को भाने वाली मूर्ति एवं अति प्राचीन मूर्ति है। इस मूर्ति को शहर के नाम वाराणसी के कारण \\\\\\\"वाराणसी पार्श्वनाथ\\\\\\\" के रूप में जाना जाता है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"children\\\":\\\"कुछ साल पहले इस मंदिर का पुनःनिर्माण किया गया और एक विशाल और शानदार मंदिर बनाया गया। आचार्य श्री राज्याशूरिश्वरजी महाराज साहेब के पूजनीय हाथों से प्रतिष्ठा कि गई।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"अन्य मंदिर:- वर्तमान में, यहां 12 श्वेतांबर मंदिर हैं। कई दिगंबर मंदिर भी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"दिशानिर्देश:- वाराणसी का निकटतम रेलवे स्टेशन मंदिर से 3 किलोमीटर की दूरी पर है। बस और निजी वाहन यहां उपलब्ध हैं। यहां धर्मशाला और भोजशाला सुविधाएं उपलब्ध हैं। वाराणसी अपनी बनारसी साड़ियों के लिए बहुत प्रसिद्ध है।\\\"}],\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\