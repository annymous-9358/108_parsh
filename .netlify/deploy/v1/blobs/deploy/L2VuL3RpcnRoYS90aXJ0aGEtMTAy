 srcSet=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_13637.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 82 - श्री नवलखा पार्श्वनाथ।</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में 33 इंच ऊंची व 26 इंच चौड़ी भगवान श्रीनवलखा पार्श्वनाथ की मूर्ति। मूर्ति के सिर पर नव नाग के फणों का छत्र है।</p><p>तीर्थ: यह पाली गाँव, राजस्थान में नवलखा रोड में है।</p><p>ऐतिहासिकता: इस स्थान के प्राचीन नाम &quot;पल्लिका&quot; और &quot;पल्ली&quot; था। श्री सांडेराव तीर्थ के इतिहास से ज्ञात होता है कि वि.सं. 969 में सांडेराव के मंदिर के जिणोर्द्वार प्रसंगे प्रतिष्ठा मोहत्सव पर प्रकांड विद्वान आचार्य श्री यशोभद्रसूरीश्वरजी द्वारा मांत्रिक शक्ति से पाली से घी मंगवाया गया था, जिसका व्यापारी को पता नहीं लगा सका। पश्चात सांडेराव के श्रावकगण घी की लागत के रुपयों का भुगतान करने आये, परन्तु भाग्यशाली व्यापारी ने रूपया लेने से इनकार किया व उक्त शुभ काम के लिए अपनी अमूल्य लक्ष्मी का सदुपयोग होने के कारण अति ही प्रसन्नता पूर्वक अपने को कृतार्थ समझने लगा। घी के मूल्य की राशि नव लाख रुपयों से यहीं मंदिर बनवाने की योजना बनाकर इस मंदिर का निर्माण किया गया, जो &quot;नवलखा मंदिर&quot; कहलाने लगा। नवलखा नाम के पीछे एक और कहानी है। यह कहा जाता है कि मूर्ति के नौ पूजा स्थल पर लिखे गए मंत्रों के कारण नवलखा पार्श्वनाथ के नाम से जाना जाता है। तत्पश्चात इस मंदिर का जिणोर्द्वार वि.सं. 1144 में होने का उल्लेख है। मंदिर में कई प्रतिमाओं पर सं 1144, सं. 1179 व सं. 1201 के लेखों में इस मंदिर में मुलनायक श्री महावीर भगवान रहने का उल्लेख है। वि.सं. 1686 में हुए पुनः जिणोर्द्वार के समय मुलनायक श्री महावीर स्वामी के स्थान पर श्री पार्श्वनाथ भगवान की यह प्रतिमा प्रतिष्ठत होने का उल्लेख है। प्रतिमाजी पर भी वि.सं. 1686 का लेख उत्कीर्ण है। वि.सं. 2041 में बावन जिनालय से युक्त नवलखा पार्श्वनाथ की प्रतिष्ठा पू. आ. श्री कैलाशसागरसूरीश्वरजी म.सा. के वरद हस्तों से संपन्न हुई थी।</p><p>पल्लिवाल गच्छ का उत्पत्ति स्थान यही है। इस गाँव के नाम पर ही पल्लिवाल ओसवाल नाम पड़ा। वि.सं. 969 में संड़ेरक गच्छाचार्य श्री यशोभद्रसूरीश्वरजी को आचार्य पदवी से यहीं पर विभूषित किया गया था। प्रारम्भ से ही यह स्थान जाहोजलालीपूर्ण रहा। यहाँ के श्रावकों ने धर्म प्रभावना के अनेक कार्य किये, जो आज भी उनकी धर्मनिष्ठा की याद दिलाते हैं। प्रतिवर्ष वैशाख शुक्ल 3 के दिन ध्वजा चढ़ती है। भाखरी मंदिर पर कार्तिक पूर्णिमा के दिन मेला भरता है।</p><p>(निरंतरता) अन्य मंदिर: इसके अलावा, शहर में दस मंदिर और चार दादावाड़ियाँ हैं। पुनागिरी हिल पर शहर के बाहर भगवन पार्श्वनाथ का मंदिर है, जिसे भाखरी मंदिर के रूप में जाना जाता है।</p><p>कला और मूर्तिकला के कार्य: नवलखा मंदिर अपनी अद्भुत वास्तुकला और नक्काशी के लिए जाना जाता है। भगवान की मूर्ति बहुत कलात्मक है। कुछ प्राचीन मूर्तियाँ बहुत ही आकर्षक दृश्य प्रस्तुत करती हैं।</p><p>दिशानिर्देश: मंदिर से 3 किलोमीटर की दूरी पर पाली का निकटतम रेलवे स्टेशन है। बस सेवा और टैक्सी सेवा उपलब्ध हैं। धर्मशाला और भोजनशाला की व्यवस्था है। वहां एक आम्बीलशाला, एक उपाश्रय, एक पाठशाला और एक ज्ञानशाला है।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;पार्श्वनाथ चैत्यपारीपाटी&quot; में किया गया है। नवलखा पार्श्वनाथ का एक मन्दिर केंद्र शासित प्रदेश दीव में भी है। इस मंदिर का निर्माण महाराजा कुमारपाल द्वारा करवाए जाने का उल्लेख &quot;तीर्थमाला&quot; में मिलता है। इस मंदिर का निर्माण उस समय जैन धर्मावलंबियों को जहाजों द्वारा विदेश में व्यापार हेतु जाते समय पूजा कर जाने तथा वापस आने पर सर्वप्रथम जिनदर्शन-पूजा करने हेतु करवाया गया था।</p><p>नवलखा पार्श्वनाथ की एक मूर्ति &quot;लिम्बरी&quot; मंदिर में, &quot;जीरावला तीर्थ&quot; में, और सांताक्रूज मुंबई के कलीकुंड पार्श्वनाथ मंदिर में भी है।</p><p>स्तुति: पाली नगरने पालनगे बाले आ पालजो, पालनहार विरूद्ध तारू तेज सच्चा जाणजो, नवअंग मा नवयंत्र लिखो तेहथी तु नवलखा। &quot;श्री नवलखा पार्श्व ने भावे करूँ हुं वंदना&quot;</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम् श्री नवलखा पार्श्वनाथय नमः&quot;</p><p>ट्रस्ट: श्री नवलचंद सुव्रतचंद जैन पेढ़ी, गुजराती कटला, पाली-306401, जिला: पाली, राजस्थान। फोन: 02932-21747/21929।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-101\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m