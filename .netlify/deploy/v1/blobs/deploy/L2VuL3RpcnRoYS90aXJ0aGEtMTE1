w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"SpeakButton\\\"]\\n22:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T1607,\"])</script><script>self.__next_f.push([1,\"Shri Nageshwar Parshwanath. 94th of the 108 Parshwanaths - Shri Nageshwar Parshwanath.. Main Deity: A green-colored standing image of Lord Shri Parshwaprabhu, life-sized at nine hasta (13.5 feet), in the kayotsarga posture, representing Lord Shri Nageshwar Parshwanath. Above the Lord's head is a canopy of seven serpent hoods. The total height including the canopy is 14 feet; excluding the canopy, the height of the Lord's body is thirteen and a half (13.5) feet. The Lord's actual bodily height was nine hasta.. Location: This temple is near the village of Unhel, on the bank of the Kshipra river, at an elevation of a thousand feet above sea level.. History: The image installed in this temple is believed to be roughly 2,800 years old and is made of emerald. Sculptors and gem experts hold that the mani-stone from which the image is made is more than two thousand years old. It is believed that this image was crafted by the gods and was originally installed in a temple in the city of Ahichchhatra. In time, as people learned the value of this image, many, driven by greed, sought to destroy it. The presiding deity protected the image. A Jain acharya, through the power of his austerities, summoned Dharanendra Dev and had a stone replica made, so that greedy people could not harm the original image. Later this image was brought to Parasnagar and installed there. The childless King Ajitsen built a beautiful temple for the Lord, and through worship he was blessed with a child. In Vikram Samvat 1624, this temple was renovated through the efforts of Shri Abhaydevsuri. Parasnagar later came to be called Nageshwar, and hence the Lord came to be known as Nageshwar Parshwanath. Over time, the local priest-guardian (baba) became the protector of the image, and this ancient temple fell into disrepair; a sannyasi baba tended to it for years, but the image itself remained unworshipped in the proper manner.. This magnificent, miraculous image, believed to date from the Lord's own lifetime, is unique — this is the main distinguishing feature of this site. Even during the sannyasi baba's stewardship, miraculous occurrences drew local people to come for darshan, and such events continue to this day. Upadhyay Shri Dharmasagarji Maharaj learned that the image known as \\\"Nagbaba,\\\" in the village of Unhel, Rajasthan, was in fact an ancient Shwetambar Jain image of Lord Nageshwar Parshwanath, which had come into the possession of non-Jains. Through his efforts, the image was returned to the Jains by court order, and was re-consecrated with 18 abhishek (ceremonial bathing) rituals by Shri Abhaysagarji Ganivarya. Since Vikram Samvat 1970, the temple has been entirely under Jain ownership. Credit for this achievement goes to the wisdom, arduous efforts, generosity, and eloquence of Shri Abhaysagarji Maharaj Saheb, as well as to the merchants who supported the development of the pilgrimage site. The consecration of the image of Nageshwar Parshwanath was completed on the 6th day of the bright half of Vaishakh in Vikram Samvat 2037.. Other Temples: There is a dadawadi of Kushalsuriji, and a magnificent dadawadi of Rajendrasurishwarji as well.. Art and Sculpture: Nowhere else in India is there such a wondrous, delightful, magnificent, large, and beautiful standing image of Nageshwar Parshwanath in the kayotsarga posture. On either side of the Mulanayak stand grey-stone images of Shantinath and Mahavir Swami, also in kayotsarga posture. The image is adorned with muslin cloth, a waist-sash, and a canopy. Despite its great size, the image maintains a natural and balanced posture that remains a puzzle even to skilled artists. For years, a snake has lived in a niche in the stone wall behind the canopy above the image's head, occasionally appearing white or grey to fortunate devotees. Beside the Mulanayak's feet, on either side, stand 37-inch-high images of chamar-bearing attendants, which are extremely magnificent. The eyes of the image are so artfully rendered that every devotee feels the Lord is bestowing special grace upon them.. Directions: Nageshwar Tirth is 8 kilometers from Vikramgadh Alote and 15 kilometers from Chaumahla railway station. The Dehradun Express, Ferozepur Express, Janata Express, Mathura-Vadodara Local, parcel trains, and Awadh Express all stop here. The temple trust arranges for jeeps and mini-buses to be sent to Alote upon request. The trust also provides overnight accommodation in Alote. Excellent dharmashala and bhojanshala facilities are available.. Scripture References: This image is believed to be more than eleven hundred years old and in the Mathura style. An inscribed Jain stupa found near the Kankali hills of Mathura mentions Jain images made 1,100 years ago, including an emerald image of Lord Parshwanath made by Dharanendra Dev, believed to be this very image of Nageshwar Parshwanath. An image of Nageshwar Parshwanath is also found in the \\\"Kareda Parshwanath Temple,\\\" in the Jain temple of Amroli village near Surat, in the Kandivali Jain temple in Mumbai, in the Porur Jain temple in Chennai, and elsewhere.. Praise (Stuti): O Nageshwar, Supreme Lord, you are the very form of supreme light; your power is unparalleled, embodiment of the remover of poison; bearing your emerald form in the kayotsarga posture. \\\"With devotion I bow to Shri Nageshwar Parshwa.\\\". Chanting Mantra: \\\"Om Hrim Arham Shri Nageshwar Parshwanathaya Namah.\\\". Trust: Shri Jain Shwetambar Nageshwar Parshwanath Tirth Pedhi, Post: Unhel-326515, Station: Chaumahla, District: Jhalawar, State: Rajasthan, India. Phone: 07410-40711/40715, Mobile: 09784816711/09649116711, Fax: 07410-40716.\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/Yc9uGTyDDBG81i8Q7\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:props:children:1:props:children:0:props:iconNode\\\",\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"Open in Google Maps\\\"]}],null,[\\\"$\\\",\\\"$L20\\\",null,{\\\"text\\\":\\\"$21\\\",\\\"lang\\\":\\\"en\\\",\\\"label\\\":\\\"Listen\\\",\\\"stopLabel\\\":\\\"Stop\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-10 grid grid-cols-2 gap-2 sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"58b3f24f-f98a-4b19-8348-007a8fb4ef84\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 col-span-2 aspect-[4/3] sm:col-span-2\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_14605.jpeg\\\",\\\"alt\\\":\\\"Shri Nageshwar Parshwanath फोटो 1\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"d7acfe4a-991c-48a5-8921-f22fa02111bb\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",