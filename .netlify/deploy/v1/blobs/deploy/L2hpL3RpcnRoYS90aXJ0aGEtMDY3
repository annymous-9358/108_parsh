%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10594.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10594.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10594.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10594.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10594.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 48 - श्री भटेवा पार्श्वनाथ।</p><p>मुलनायक: लगभग 23 सेंटीमीटर ऊँची, कच्छू-कमर और बैंड पद्मावत मुद्रा में भगवान श्री भटेवा पार्श्वनाथ की मूर्ति, साथ में धरणेन्द्र और पद्मावती की मूर्तियाँ। मूर्ति के सिर के ऊपर सात कुंडों की छतरी है। यह मूर्ति 21वें तीर्थंकर श्री नमिनाथ भगवान की अवधि की मानी जाती है।</p><p>तीर्थ: यह चाणस्मा शहर में है।</p><p>ऐतिहासिकता: इस मूर्ति के निर्माण की एक कहानी है। चंपानगरी के शासक राजा प्रजापाल अपने मंत्री बुद्धिसागर के साथ घोड़ों का परीक्षण करने घुड़सवारी पर गए थे। घोड़े बेकाबू होकर हवा की तरह उड़ते हुए एक जंगल में जा पहुंचे। दोनों किसी तरह एक पेड़ की शाखा पकड़कर उतर गए। शाम ढलते ही उन्होंने पेड़ के नीचे रात बिताने की सोची। रात्रि में उन्होंने संगीत की ध्वनि सुनी और खोज करने पर पाया कि &quot;नगोंश मुनि&quot; को केवल ज्ञान प्राप्त हुआ था और देवता उनका ज्ञान-कल्याणक समारोह मनाने आए थे। दोनों ने मुनि के प्रवचन सुने और तीर्थंकर की मूर्ति की प्रार्थना किए बिना अन्न-जल न लेने की शपथ ली। सुबह जंगल में कोई मंदिर न मिलने पर, मंत्री ने रेत से 23वें तीर्थंकर पार्श्वनाथ की एक सुंदर मूर्ति बनाकर राजा को दी। रेत की मूर्ति का अभिषेक न कर पाने की चिंता में दोनों प्रभु से प्रार्थना करने लगे। उनकी निस्वार्थ भक्ति से प्रसन्न होकर देवी पद्मावती प्रकट हुईं और बताया कि उन्होंने रेत की मूर्ति को पत्थर का बना दिया है। इस मूर्ति को &quot;भटेव पार्श्वनाथ&quot; कहा जाने लगा। राजा ने एक सुंदर मंदिर बनवाकर इसे वहाँ स्थापित किया। 30,000 साल बाद पाटन के राजा भूधर के अंधे-गूंगे व असाध्य रोग से पीड़ित पुत्र को आचार्य धर्मघोषसूरीजी ने भटेव पार्श्वनाथ का न्वहण (स्नात्र जल) लगाने की सलाह दी, जिससे राजकुमार ठीक हो गया। बाद में राजकुमार राजा बना तथा मृत्यु पश्चात देवलोक में देव बना, और इस मूर्ति को देवविमान द्वारा देवलोक ले जाकर 5,25,000 वर्षों तक देवों द्वारा पूजा गया।</p><p>कहा जाता है कि सदियों पहले ईडर नगर के निकट भाटुआर गाँव के निवासी श्रेष्ठी सुरचंद की आर्थिक स्थिति बहुत खराब हो गई थी। मुनिम सुरसुन्दर के कहने पर सेठ ने पोषध में रहकर पद्मावती माता की आराधना की। प्रसन्न होकर माता ने उन्हें अट्ठम तप कर श्री भटेवा पार्श्वनाथ की आराधना करने को कहा। इससे प्रसन्न होकर देवताओं ने श्री भटेवा पार्श्वनाथ की मूर्ति सुरचंद को सुपुर्द की, जिनकी पूजा से उनके घर में समृद्धि बढ़ने लगी। इससे ईर्ष्यालु होकर ईडर के राजा ने प्रतिमा की माँग की, तो श्रावक ने प्रतिमा को भूगर्भ में सुरक्षित रख दिया। सुरचंद मृत्यु पाकर यक्षयोनि में गए और चाणस्मा निवासी सेठ रवचंद को स्वप्न में मूर्ति का संकेत दिया। रवचंद ने भू-गर्भ से मूर्ति प्राप्त कर आचार्यश्री अजीतसिंहसूरीश्वरजी के निर्देश पर मंदिर बनवाकर वि.सं.1334 में वैशाख सुदी तीज को प्रतिष्ठित करवाया। वि.सं.1872 में मंदिर का जीर्णोद्धार व पुनः अंजनशलाका प्रतिष्ठा हुई। मंदिर 743 वर्ष प्राचीन है तथा जीर्णोद्धार के पश्चात 205 वर्ष प्राचीन है।</p><p>अन्य मंदिर: श्री शीतलनाथ भगवान का मंदिर और श्री आदिनाथ भगवान का एक और मंदिर है।</p><p>कला और मूर्तिकला: यह मूर्ति रेत से बनी है और बहुत प्रभावशाली है। धर्मेन्द्र और पद्मावती की रेत से बनी भव्य मूर्तियाँ मनभावन हैं। भगवान की मूर्ति के नीचे एक बच्चे के साथ अंबिकादेवी की मूर्ति है। मेहसाणा का यह पवित्र स्थान हरिज राष्ट्रीय उच्च मार्ग पर उत्कृष्ट रूप से भव्य है। इस तरह की मूर्ति अन्य कहीं नहीं है।</p><p>दिशा-निर्देश: यह मंदिर मेहसाणा-हरिज राष्ट्रीय उच्चमार्ग पर चाणस्मा रेलवे स्टेशन से एक किलोमीटर की दूरी पर है। यहां एक प्राचीन ज्ञानभंडार, एक उपाश्रया, धर्मशाला, भोजनशाला और एक पाठशाला है।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;श्री पार्श्वनाथ नाममाला&quot;, &quot;श्री पार्श्वनाथ चैत्यपारीपाटी&quot;, &quot;श्री भटेव पार्श्वनाथ की उत्पति&quot;, &quot;श्री भैरव पार्श्वनाथ लावणी&quot; आदि में किया गया है। श्री भटेवा पार्श्वनाथ की एक मूर्ति मुंबई के सांताक्रूज में कलिकुंड पार्श्वनाथ मंदिर में, जीरावला तीर्थ में, सूरत के गोपीपुरा में वासुपूज्यस्वामी मंदिर में, भिलाडियाजी तीर्थ में और करेड तीर्थ में भी है।</p><p>स्तुति: प्रजापाल नृपनी भय हटावता जे प्रभु निर्मित थाता, देवी प्रभावे वेलुमांथी व्रजमय जे बनी जता, माता अंबिका चरण मा रही जे प्रभु ने सेवता। श्री &quot;भटेवा पाश्र्व&quot; ने भावे करूँ हुं वंदना।</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम् श्री भटेवा पार्श्वनाथय नमः&quot;</p><p>ट्रस्ट: श्री चणास्मा जैन महाजन नी पेढ़ी, मोटी वाणीवाड, चणास्मा-384220, जिला: पाटन, गुजरात राज्य, भारत। फोन: 02734-23296, मोबाइल: 9426506676।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-065\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री गंभीरा पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-068\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री मनमोहन पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lu