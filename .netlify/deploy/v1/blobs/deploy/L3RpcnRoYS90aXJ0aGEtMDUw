,{\\\"children\\\":\\\"राजा अश्वसेन स्वप्नलक्षण पाठकों यानी कि जानकारों को बुलाकर राज दरबार के शाही सभाकक्ष में आसन पर बिठाकर, हाथ में फल फूल लेकर विनय पूर्वक राजा को बताते हैं कि आज वामादेवी अपने शाही शयनकक्ष में उच्च कोटि की शय्या पर शयन करते हुए अर्ध निंद्रा अवस्था में निम्न प्रकार के महान चौदह स्वप्न देखे हैं, देखते हुए निद्रा से जागृत हो गईं। यह स्वप्न गज वृषभ आदि थे। राजा विनती करते हैं कि हे देवानुप्रियो यह उदार चौदह महास्वप्न का क्या कल्याणकारी फल होगा?\\\"}]\\n20:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"इसके पश्चात स्वप्न लक्षण पढ़ने वालों ने अश्वसेन राजा द्वारा प्रस्तुत वृत्तांत सुनकर एवं समझकर अत्यंत प्रफुल्लित होकर, स्वप्न शास्त्रों के अनुसार वचन बोलते हुए कहा - हे देवानुप्रिया, वामादेवी ने जो महास्वप्न देखे हैं वह महा मंगलकारी हैं। यह अर्थ लाभ कराने वाले, लोगों का लाभ कराने वाले, पुत्र का लाभ, सुखों का लाभ एवं राज्य का लाभ कराने वाले हैं। निश्चित रूप से वामादेवी के कुल में ध्वज समान, दीपक समान, पर्वत समान, मुगट समान, तिलक समान और क्रांति को बढ़ाने वाले, समृद्धि देने वाले, विस्तार करने वाले, उद्धार समान, कुल के वृक्ष समान, कुल की विशेष वृद्धि करने वाले, सुकोमल हाथ-पैर वाला, हिंतारहित पांचों इंद्रियों से परिपूर्ण लक्षणों, व्यंजन और गुणों से युक्त, मान सम्मान, प्रमाण से परिपूर्ण सुजात सर्वांग चंद्र समान सौम्य आकृति वाला प्रियदर्शी स्वरूप के पुत्र का जन्म होगा।\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/tirtha/$d$slug/__PAGE__":"","/tirtha/$d$slug":"","/tirtha":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/tirtha/layout,_N_T_/tirtha/[slug]/layout,_N_T_/tirtha/[slug]/page,_N_T_/tirtha/tirtha-050"},"segmentPaths":["/_tree","/_full","/tirtha/$d$slug/__PAGE__","/tirtha/$d$slug","/tirtha","/_index","/_head"],"revalidate":60,"cacheControl":{"revalidate":60,"expire":31536000}}}