ps%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>अतीत का पुनर्निर्मित जिनालय लकड़ी से बना था। यह सोलहवीं शताब्दी तक लकड़ी का बना रहा। वर्षों, दशकों और शताब्दियों के बीतने के साथ इसकी स्थिति बुरी तरह बिगड़ गई और आधार (नींव) से फिर बनाने का विचार श्रेष्ठी श्री बाबूसाहेब पन्नालाल और पूरनचंदजी के मन में आया। ये पाटन के मूल निवासी थे और यह बावन जिनालय उनके परिवार द्वारा बनाया गया था। वी.स. 2011 शुभ माह जेठ के उज्ज्वल आधे हिस्से में परम पूज्य आचार्य समुद्रसुरि महाराज साहेब द्वारा भगवान पार्श्वनाथ की मूर्ति को उत्साह और धूमधाम से नए रूप में अंजनशलाका के साथ प्रतिष्ठित किया गया था। इस जिनालय के चारों ओर 51 मिनी मंदिर हैं। जैन देवताओं की 86 नई मूर्तियाँ और 24 तीर्थंकर की मूर्तियाँ, तीर्थंकर के वर्ण (शरीर के रंग) की स्लैब से बनी हैं।</p><p>इस जिनालय की कुछ मूर्तियाँ प्राचीन, सम्प्रति महाराजा के समय की हैं। इन मूर्तियों का प्रतिष्ठा समारोह वी.स. 2016 वैशाख की छठी छमाही के छठे दिन मंत्रों के जाप के बीच परम पूज्य पुण्यविजयजी महाराज साहेब के हाथों द्वारा किया गया था। भामती (मंदिर की दीवार के साथ गोलाकार मार्ग) में संगमरमर की 218 मूर्तियाँ हैं और 26 मूर्तियाँ धातु की हैं। इस परिसर में पाँच अन्य जिनालय हैं। पंचसरा पार्श्वनाथ की एक हीरों की आंगी (५ करोड़ की) होती है, इसे करवाने का नखरा पाँच हज़ार है। यहाँ सभी सुविधाओं के साथ धर्मशालाएँ (सराय) और भोजनशाला हैं, यहां हमेशा तीर्थयात्रियों की भीड़ लगी रहती है। पिछले कई वर्षों से तीन दिवसीय त्योहार मनाया जाता है, जो जिनालय की वर्षगांठ है, जो जेठ के उज्ज्वल आधे के पांचवें भाग पर पड़ता है। इन त्योहारों के दिनों में दूर-दूर स्थान से भक्त आते हैं और देव-दर्शन का लाभ लेते हैं।</p><p>अन्य मंदिर: इस मुख्य मंदिर के अलावा, 84 बड़े मंदिर और 134 छोटे मंदिर हैं। यहाँ 108 पार्श्वनाथ में से 10 पार्श्वनाथ थे, वर्तमान में 9 पार्श्वनाथ हैं, एक पार्श्वनाथ को मुम्बई ले गए।</p><p>कला और मूर्तिकला के कार्य: कई जैन मूर्तियों और कला कार्यों के साथ कई जैन मंदिर हैं। इस भव्य मंदिर की लंबाई 180 फीट है और चौड़ाई 90 फीट है। यह नवनिर्मित मंदिर जोधपुरी, मकराना, जैसलमेर और धांगधरा पत्थरों से निर्मित है। सभी गुंबद, खंभे, चौकियां, छतें, दीवारें, मंडप अद्भुत नक्काशी और कलात्मक ढंग से सजाए गए हैं।</p><p>दिशानिर्देश: पाटन का रेलवे स्टेशन मंदिर से 2 किलोमीटर की दूरी पर है। यहां से मेहसाणा लगभग 50 किलोमीटर, सिद्धपुर 30 किलोमीटर और चारूप 12 कि.मी. की दूरी पर है। निजी वाहनों की बस सेवा उपलब्ध है। धर्मशाला और भोजनशाला की सुविधाएँ यहाँ उपलब्ध हैं। कई उपाश्रय भी हैं। यहाँ ज्ञान भंडार अद्भुत हैं और कई प्राचीन शास्त्र उपलब्ध हैं।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;चंद्रप्रभ चरित्र&quot;, &quot;प्रभावक चरित्र&quot; में किया गया है। &quot;पाटन चैत्यपारीपाटी&quot; में, &quot;365 पार्श्व जिन नाममाला&quot; में और श्री &quot;शंखेश्वर पार्श्वनाथ छंद&quot; में भी उल्लेख है। श्री पंचासरा पार्श्वनाथ की मूर्ति कलिकुंड पार्श्वनाथ मंदिर सांताक्रूज़ मुंबई में, जीरावला तीर्थ में और करेडा तीर्थ में भी है।</p><p>स्तुति: जे पांच आश्रव वारता पंचासरा प्रभु पासजी, वनराज नृपे थापीया बहूमानथी धरी आसजी, प्रेमे करी भक्ति प्रभु तुज मांगु मुक्ति वासजी, श्री &quot;पंचासरा&quot; पार्श्व ने भावे करूँ हूं वंदना।</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम श्री &quot;पंचासरा&quot; पार्श्वनाथय नमः&quot;</p><p>ट्रस्ट: श्री पंचसारा पार्श्वनाथ जैन देरासर ट्रस्ट, हेमचंद्राचार्य रोड, पिपलानी शेरी, पाटन-384265, जिला-मेहसाणा, गुजरात राज्य, भारत। फोन: 02766-222278, 02766-220559।</p><p>पुरुषादानीय पार्श्वनाथ भगवान का चरित्र भाग-4 (स्वप्न पाठकों को आमंत्रण):</p><p>राजा अश्वसेन स्वप्नलक्षण पाठकों यानी कि जानकारों को बुलाकर राज दरबार के शाही सभाकक्ष में आसन पर बिठाकर, हाथ में फल फूल लेकर विनय पूर्वक राजा को बताते हैं कि आज वामादेवी अपने शाही शयनकक्ष में उच्च कोटि की शय्या पर शयन करते हुए अर्ध निंद्रा अवस्था में निम्न प्रकार के महान चौदह स्वप्न देखे हैं, देखते हुए निद्रा से जागृत हो गईं। यह स्वप्न गज वृषभ आदि थे। राजा विनती करते हैं कि हे देवानुप्रियो यह उदार चौदह महास्वप्न का क्या कल्याणकारी फल होगा?</p><p>इसके पश्चात स्वप्न लक्षण पढ़ने वालों ने अश्वसेन राजा द्वारा प्रस्तुत वृत्तांत सुनकर एवं समझकर अत्यंत प्रफुल्लित होकर, स्वप्न शास्त्रों के अनुसार वचन बोलते हुए कहा - हे देवानुप्रिया, वामादेवी ने जो महास्वप्न देखे हैं वह महा मंगलकारी हैं। यह अर्थ लाभ कराने वाले, लोगों का लाभ कराने वाले, पुत्र का लाभ, सुखों का लाभ एवं राज्य का लाभ कराने वाले हैं। निश्चित रूप से वामादेवी के कुल में ध्वज समान, दीपक समान, पर्वत समान, मुगट समान, तिलक समान और क्रांति को बढ़ाने वाले, समृद्धि देने वाले, विस्तार करने वाले, उद्धार समान, कुल के वृक्ष समान, कुल की विशेष वृद्धि करने वाले, सुकोमल हाथ-पैर वाला, हिंतारहित पांचों इंद्रियों से परिपूर्ण लक्षणों, व्यंजन और गुणों से युक्त, मान सम्मान, प्रमाण से परिपूर्ण सुजात सर्वांग चंद्र समान सौम्य आकृति वाला प्रियदर्शी स्वरूप के पुत्र का जन्म होगा।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-049\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री पंचासरा पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-051\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री कोका पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\