ll,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"अतीत का पुनर्निर्मित जिनालय लकड़ी से बना था। यह सोलहवीं शताब्दी तक लकड़ी का बना रहा। वर्षों, दशकों और शताब्दियों के बीतने के साथ इसकी स्थिति बुरी तरह बिगड़ गई और आधार (नींव) से फिर बनाने का विचार श्रेष्ठी श्री बाबूसाहेब पन्नालाल और पूरनचंदजी के मन में आया। ये पाटन के मूल निवासी थे और यह बावन जिनालय उनके परिवार द्वारा बनाया गया था। वी.स. 2011 शुभ माह जेठ के उज्ज्वल आधे हिस्से में परम पूज्य आचार्य समुद्रसुरि महाराज साहेब द्वारा भगवान पार्श्वनाथ की मूर्ति को उत्साह और धूमधाम से नए रूप में अंजनशलाका के साथ प्रतिष्ठित किया गया था। इस जिनालय के चारों ओर 51 मिनी मंदिर हैं। जैन देवताओं की 86 नई मूर्तियाँ और 24 तीर्थंकर की मूर्तियाँ, तीर्थंकर के वर्ण (शरीर के रंग) की स्लैब से बनी हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"इस जिनालय की कुछ मूर्तियाँ प्राचीन, सम्प्रति महाराजा के समय की हैं। इन मूर्तियों का प्रतिष्ठा समारोह वी.स. 2016 वैशाख की छठी छमाही के छठे दिन मंत्रों के जाप के बीच परम पूज्य पुण्यविजयजी महाराज साहेब के हाथों द्वारा किया गया था। भामती (मंदिर की दीवार के साथ गोलाकार मार्ग) में संगमरमर की 218 मूर्तियाँ हैं और 26 मूर्तियाँ धातु की हैं। इस परिसर में पाँच अन्य जिनालय हैं। पंचसरा पार्श्वनाथ की एक हीरों की आंगी (५ करोड़ की) होती है, इसे करवाने का नखरा पाँच हज़ार है। यहाँ सभी सुविधाओं के साथ धर्मशालाएँ (सराय) और भोजनशाला हैं, यहां हमेशा तीर्थयात्रियों की भीड़ लगी रहती है। पिछले कई वर्षों से तीन दिवसीय त्योहार मनाया जाता है, जो जिनालय की वर्षगांठ है, जो जेठ के उज्ज्वल आधे के पांचवें भाग पर पड़ता है। इन त्योहारों के दिनों में दूर-दूर स्थान से भक्त आते हैं और देव-दर्शन का लाभ लेते हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"अन्य मंदिर: इस मुख्य मंदिर के अलावा, 84 बड़े मंदिर और 134 छोटे मंदिर हैं। यहाँ 108 पार्श्वनाथ में से 10 पार्श्वनाथ थे, वर्तमान में 9 पार्श्वनाथ हैं, एक पार्श्वनाथ को मुम्बई ले गए।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"कला और मूर्तिकला के कार्य: कई जैन मूर्तियों और कला कार्यों के साथ कई जैन मंदिर हैं। इस भव्य मंदिर की लंबाई 180 फीट है और चौड़ाई 90 फीट है। यह नवनिर्मित मंदिर जोधपुरी, मकराना, जैसलमेर और धांगधरा पत्थरों से निर्मित है। सभी गुंबद, खंभे, चौकियां, छतें, दीवारें, मंडप अद्भुत नक्काशी और कलात्मक ढंग से सजाए गए हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"दिशानिर्देश: पाटन का रेलवे स्टेशन मंदिर से 2 किलोमीटर की दूरी पर है। यहां से मेहसाणा लगभग 50 किलोमीटर, सिद्धपुर 30 किलोमीटर और चारूप 12 कि.मी. की दूरी पर है। निजी वाहनों की बस सेवा उपलब्ध है। धर्मशाला और भोजनशाला की सुविधाएँ यहाँ उपलब्ध हैं। कई उपाश्रय भी हैं। यहाँ ज्ञान भंडार अद्भुत हैं और कई प्राचीन शास्त्र उपलब्ध हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"शास्त्र: इस मंदिर का उल्लेख \\\\\\\"चंद्रप्रभ चरित्र\\\\\\\", \\\\\\\"प्रभावक चरित्र\\\\\\\" में किया गया है। \\\\\\\"पाटन चैत्यपारीपाटी\\\\\\\" में, \\\\\\\"365 पार्श्व जिन नाममाला\\\\\\\" में और श्री \\\\\\\"शंखेश्वर पार्श्वनाथ छंद\\\\\\\" में भी उल्लेख है। श्री पंचासरा पार्श्वनाथ की मूर्ति कलिकुंड पार्श्वनाथ मंदिर सांताक्रूज़ मुंबई में, जीरावला तीर्थ में और करेडा तीर्थ में भी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"स्तुति: जे पांच आश्रव वारता पंचासरा प्रभु पासजी, वनराज नृपे थापीया बहूमानथी धरी आसजी, प्रेमे करी भक्ति प्रभु तुज मांगु मुक्ति वासजी, श्री \\\\\\\"पंचासरा\\\\\\\" पार्श्व ने भावे करूँ हूं वंदना।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"जाप मंत्र: \\\\\\\"ॐ ह्री अर्हम श्री \\\\\\\"पंचासरा\\\\\\\" पार्श्वनाथय नमः\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"ट्रस्ट: श्री पंचसारा पार्श्वनाथ जैन देरासर ट्रस्ट, हेमचंद्राचार्य रोड, पिपलानी शेरी, पाटन-384265, जिला-मेहसाणा, गुजरात राज्य, भारत। फोन: 02766-222278, 02766-220559।\\\"}],\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\