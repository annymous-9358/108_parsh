%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8447.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>24. श्री पोशीना पार्श्वनाथ</p><p>पोस्ट-नाना (साबली), पोशिना ता.-ईडर, जिला साबरकांठा।</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में लगभग 78 से.मी. (31 इंच) ऊँची भगवान श्री पोसिना पार्श्वनाथ की मूर्ति है।</p><p>तीर्थ: यह नाना पोसिना गांव के केंद्र में है।</p><p>ऐतिहासिकता: यह प्राचीन तीर्थ 12वीं शताब्दी के अंतर्गत आता है। यह मूर्ति एक किसान को कनेर पेड़ के नीचे मिली थी। जब वह अपने खेत की जुताई कर रहा था, तो उसका हल पेड़ के नीचे अटक गया था। वहाँ पर खुदाई करने पर उन्होंने यह 31 इंच की भगवान पार्श्वनाथ की सुंदर मूर्ति पाई। बड़े विश्वास के साथ उन्होंने इस मूर्ति को जैन संघ को सौंपा। संघ ने एक मंदिर का निर्माण किया और मूर्ति को मंदिर में स्थापित किया गया। कुमारपाल महाराजा के शासनकाल के दौरान एक विशाल मंदिर बनाया गया था और यह मूर्ति उसमें स्थापित की गई थी। मंदिर में 13वीं और 17वीं शताब्दी के बीच की अवधि की दूसरी मूर्तियाँ भी हैं। कई बार समय के साथ इस मंदिर का जीर्णोद्धार किया गया, और श्री आनंदविमलसूरिजी, श्रीविजयसिंहसूरिजी, श्रीलक्ष्मीसागरसूरिजी, श्रीविजयशिरसूरिजी, श्रीविजयदेवसूरिजी आदि महान आचार्यों के पूजनीय हाथों द्वारा मूर्तियाँ स्थापित की गईं। वी.सं.2008 में मंदिर का जीर्णोद्धार और मुख्य मूर्ति के साथ कई और मूर्तियाँ आचार्यदेव श्री लब्ध्यसूरीश्वरजी महाराजसाहेब के पूजनीय हाथों द्वारा स्थापित की गई थीं। अंतिम जीर्णोद्धार आचार्य श्री शतुलभद्रसूरीश्वरजी की सलाह पर कुछ वर्ष पहले किया गया था। वहाँ यह धारणा है कि प्रत्येक दिन मंदिर के शिखर पर ध्वज लहराने के विशेष समय पर ध्वज लहराने की संख्या आने वाले श्रद्धालुओं की संख्या को इंगित करती है, और उस संकेत के अनुसार लोगों के लिए सटीक संख्या में भोजन तैयार किया जाता है। तैयार भोजन सभी तीर्थयात्रियों के लिए पर्याप्त रहता है, न एक व्यक्ति अधिक होता है न ही एक व्यक्ति कम। यह निश्चित रूप से देखा जाने वाला चमत्कार है।</p><p>अन्य मंदिर: अन्य मंदिर नहीं हैं।</p><p>कला और मूर्तिकला के कार्य: यह एक प्राचीन मंदिर है। माना जाता है कि इस भगवान पार्श्वनाथ की मूर्ति का संबंध राजा संप्रति के काल से है। इस मंदिर की कलात्मकता असाधारण है। मंदिर बहुत रमणीय और सुंदर है। इस जगह की प्राकृतिक सुंदरता अद्भुत है।</p><p>दिशानिर्देश: यह पवित्र स्थान, जिसे साबली पोसिना या नानी पोशीना के रूप में जाना जाता है, साबरकांठा जिले के ईडर से 22 किलोमीटर की दूरी पर है। निकटतम शहर ईडर है। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;तीर्थमाला&quot; में, &quot;365 श्री पार्श्व जिन नाममाला&quot; में, &quot;श्रीशंखेश्वर पार्श्वनाथ छंद&quot; में, &quot;श्री पार्श्वनाथ नाममाला&quot; में, &quot;श्री पार्श्वनाथ चैत्यपारीपटी&quot; आदि में है। वि.सं.1966 में कवि राजरत्न ने ईडर में पोसिना पार्श्वनाथ का आशीर्वाद लेकर &quot;विजय शेठ विजया शतानी रास&quot; लिखा। उन्होंने रास में इसका उल्लेख किया है। पोसिना की एक मूर्ति पार्श्वनाथ जिरावाला तीर्थ में और मुम्बई के सांताक्रूज़ में कालीकुंड पार्श्वनाथ मंदिर में भी है।</p><p>स्तुति: जे ध्वज तणा संकेतथी यात्रीनावावड़ा आपता, ते प्रगटता खेतर खेडंता तेजपुंजथी ओपता, सहु दुर्गुणोंने शोषी लड़ने सदगुणोंने पोषता। श्री &quot;पोशीना&quot; प्रभु पार्श्वने भावे करूं हुं वंदना।</p><p>जाप मंत्र: ॐ ह्री अर्ह श्री &quot;पोशीना&quot; पार्श्वनाथाय नमः।</p><p>ट्रस्ट: श्री पोसीना पार्श्वनाथ श्वेतांबर जैन तीर्थ, शेठ श्री आनंदजी मंगलजी की पेढ़ी, पोस्ट: नाना पोसिना, तालुका: ईडर, जिला: साबरकांठा, गुजरात - 383421, भारत। फोन: 02778-266367, मोबाइल: 09724572367।</p><p>राजेंद्र कुमार जैन का जय जिनेंद्र।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-028\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री पुरुषादानीय पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-030\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री विघ्नापहार पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>मूल स्रोत: राजेन्द्र कुमार जैन, पार्श्व सदन, पार्श्व नगर, डूंगरपुर</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/40e0f9pufs6g4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Srea