\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}]\\n24:T2ac0,\"])</script><script>self.__next_f.push([1,\"Shri Nakoda Parshvanath. 108 पार्श्वनाथ में से 68 - श्री नाकोडा पार्श्वनाथ. मूलनायक: काले रंग की पद्मासन मुद्रा में 21 इंच ऊंची व 18 इंच चौड़ी भगवान श्री नाकोडा पार्श्वनाथ की मूर्ति है। मूर्ति 7 नाग फणों के छत्र से अलंकृत है।. तीर्थ: यह बालोतरा से 13 किलोमीटर की दूरी पर, दूर जंगल में पहाड़ियों के बीच है।. ऐतिहासिकता: वीरमदत और नकोर्सन नामक एक राजा के दो बेटों ने 10 मील की दूरी पर दो शहरों का निर्माण किया, जिनके नाम वीरमपुर और नकोर्ननगर रखे गए। इन राजाओं ने अपने शहरों में मंदिर बनवाए। वीरमपुर में श्री चंद्रप्रभु स्वामी की एक मूर्ति स्थापित की गई थी और नकोरसेन में श्री सुपार्श्वनाथ स्वामी की एक मूर्ति विक्रम युग की तीसरी शताब्दी में स्थापित की गई थी, जिसे परम पावन आचार्य शालीभद्रस्वामी के शुभ हस्ते प्रतिष्ठित किया गया था। समय के साथ, इस मंदिर का कई बार जीर्णोद्धार किया गया। वि.सं. ९०९ में वीरमपुर शहर सुसंपन्न श्रावकों के लगभग २७०० घरों की आबादी से जगमगा रहा था। उस समय श्रेष्ठी श्री हराखचंदजी ने प्राचीन मंदिर का जीर्णोद्धार करवाकर श्री महावीर भगवान की प्रतिमा की प्रतिष्ठा करवाई थी। एक अन्य मान्यतानुसार यह प्रतिमा, भाग्यवान श्रावक श्री जिनदत को अधिष्ठायक देव द्वारा स्वप्न में दिए संकेत के आधार पर नाकोरनगर के निकट सीन्दरी गाँव के पास एक तालाब से प्रकट हुई थी, ऐसा उल्लेख है। वि.सं. १२२३ में पुनः जिणोद्धार करवाने का उल्लेख मिलता है। वि.सं. १२८० में आलामशाह ने इस नगर पर चढ़ाई की, जिससे मंदिर को भारी क्षति पहुंची; उस समय संघ ने इन 120 मूर्तियों को संरक्षण के लिए कालिद्रह गाँव के तहखाने में छिपाकर रखा। १५वीं शताब्दी के आरम्भ में इस मंदिर के नवनिर्माण का कार्य पुनः प्रारंभ किया गया तथा कालिद्रह में स्थित नाकोरनगर की १२० प्राचीन प्रतिमाएं यहाँ लाकर उनमें से श्री पार्श्वनाथ भगवान की इस सुन्दर चमत्कारी प्रतिमा को मुलनायक के रूप में इस नवनिर्मित मंदिर में वि.सं. १४२९ में पुनः प्रतिष्ठित किया गया, जो अभी विद्यमान है। मूल प्रतिमा नाकोरनगर की होने के कारण इस तीर्थ का नाम \\\"नाकोडा पार्श्वनाथ\\\" प्रचलित हुआ। प्रकटप्रभावी अधिष्ठायक देव भैरवजी की मूर्ति को आचार्य कीर्तिरत्नसूरीश्वरजी ने यहां स्थापित किया था। भैरवजी बहुत चमत्कारी हैं, वह तीर्थ की रक्षा करते हैं और पूजा करने वालों की इच्छाओं को पूरा करते हैं; उनके चमत्कार पूरी दुनिया में जाने जाते हैं। वि.सं. १५६४ में ओसवाल वन्सहज गोत्रीय सेठ जुठिल के परपौत्र सेठ सदरंग द्वारा जीणोद्धार होने का उल्लेख है। वि.सं. १६३८ में इस मंदिर के पुनरुध्वार होने का भी उल्लेख है। लगभग सत्रहवीं शताब्दी तक यहाँ की जहोजलाली अच्छी रही। इसके बाद श्रेष्ठी मालाशाह संकलेचा के भ्राता सही नानकजी ने यहाँ के राजकुमार का अप्रिय व्यवहार देखकर गाँव छोड़ने का निर्णय लिया; अतः जैसलमेर का संघ सारे जैन कुटुम्बिजनो के साथ गाँव छोडकर चला गया। उसके पश्चात इस गाँव की जनसंख्या दिन प्रतिदिन घटने लगी। आज जैनियों का कोई घर नहीं है, लेकिन श्रीसंघ द्वारा हो रही तीर्थ की व्यवस्था उल्लेखनीय है। सत्रहवीं सदी के बाद सं. १८८६ में जिणोद्धार होने का उल्लेख है, इसके पश्चात भी समय-समय पर आवश्यक जिणोद्धार हुए। यहाँ मंदिर के अतिरिक्त कोई घर नहीं है, परन्तु यात्रियों का निरंतर आवगमन रहने के कारण यह स्थल नगरी सा प्रतीत होता है। प्रतिवर्ष श्री पार्श्वप्रभु के जन्मकल्याणक दिवस पौष कृष्ण दशमी को विशाल मेले का आयोजन होता है।. अन्य मंदिर: भगवान शांतिनाथ के मंदिर और भगवान आदिश्वर के मंदिर भी हैं, जो सत्रहवीं शताब्दी में निर्मित माने जाते हैं।. कला और मूर्तिकला की कृतियाँ: बारहवीं से सोलहवीं शताब्दी तक की मूर्तियाँ यहाँ प्रदर्शित हैं। जंगल में पहाड़ियों के बीच इस एकांत स्थान का प्राकृतिक दृश्य बहुत ही सुंदर, शांतिपूर्ण और आकर्षक है। भगवान पार्श्वनाथ की मूर्ति बहुत ही भावपूर्ण है। राजस्थान के तीर्थों में इस तीर्थ का एक विशेष महत्व है।. दिशानिर्देश: इस मंदिर से 13 किलोमीटर की दूरी पर निकटतम रेलवे स्टेशन बालोतरा है। राजस्थान के हर तीर्थ से इस स्थान तक बस सेवा और निजी वाहन उपलब्ध हैं। मंदिर के परिसर में उत्कृष्ट आवास वाली धर्मशालाएं हैं। एक अयम्बिलशाला, एक भोजनशाला, उपाश्रय, एक ज्ञानभंडार (पुस्तकालय), और एक पंजरापोल भी है।. शास्त्र: इस मंदिर का उल्लेख \\\"तीर्थमाला\\\", \\\"श्री शंखेश्वर पार्श्वनाथ छंद\\\" आदि में किया गया है। सांताक्रूज़, मुंबई के \\\"कलिकुंड पार्श्वनाथ मंदिर\\\" में तथा \\\"जिरावाला तीर्थ\\\" में श्री नाकोड़ा पार्श्वनाथ की मूर्ति