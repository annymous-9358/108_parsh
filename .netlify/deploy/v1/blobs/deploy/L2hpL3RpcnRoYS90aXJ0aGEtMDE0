\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"108 पार्श्वनाथ में से 11 - श्री स्थंभन पार्श्वनाथ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"मूलनायक: सुंदर परिकर-युक्त काले रंग की पद्मासन मुद्रा में 8 इंच ऊंची व 5 इंच चौड़ी श्री स्थंभन पार्श्वनाथ की मूर्ति है। मूर्ति के सिर के ऊपर 5 नाग फणों की छतरी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"तीर्थ: यह गुजरात के खंभात शहर में खारवाडो में स्थित है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"ऐतिहासिकता: खंभात का प्राचीन नाम \\\\\\\"त्रंबवती\\\\\\\" था और आज इसे अंग्रेजी भाषा में \\\\\\\"कैम्बे\\\\\\\" के नाम से जाना जाता है। प्राचीन काल से खंभात अपने जैन मंदिरों के लिए बहुत प्रसिद्ध है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"श्री स्थंभन पार्श्वनाथ प्रभु की प्रतिमा नीलम रत्न की है। इस प्रतिमा का भी अपना एक भव्य इतिहास है। गई चौविसी के आषाढ़ी श्रावक ने इस प्रतिमा को भराई थी। यह प्रतिमा जी इसके बाद हजारों वर्ष तक विभिन्न देवताओं द्वारा पूजी जाती रही, अलग-अलग जगह पर वर्षों तक पूजी जाती रही, अंतिम बार कृष्ण महाराजा द्वारा इसकी पूजा की गई थी। द्वारका के नाश के समय इसको एक श्रेष्ठी ने समुद्र में पधरा दिया था। क्रांतिपुर के एक श्रेष्ठी को समुद्र में से देवी के संकेत द्वारा एवं सहायता से यह मूर्ति पुनःप्राप्त हुई। इसके साथ दो अन्य मूर्तियां भी प्राप्त हुई थीं, जिनमें से एक मूर्ति श्री पार्श्वनाथ भगवान की एवं एक मूर्ति श्री नेमिनाथ भगवान की थी, जो आज भी चारूप में श्री पार्श्वनाथ व पतन गाँव में श्री नेमीनाथ भगवान की मूर्ति विद्यमान है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"बीसवें तीर्थंकर के काल से लेकर अंतिम तीर्थंकर के काल तक यहाँ अनेकों चमत्कारिक घटनाएँ घटी हैं। तत्पश्चात वर्षों तक प्रतिमा लुप्त रही। विक्रम सं. १११९ में नवांगी टीकाकार श्री अभयदेव सूरिजी ने दैविक चेतना पाकर सेढी नदी के तट पर भक्ति भाव पूर्वक जयतिहुअण स्तोत्र की रचना की, जिससे अधिष्ठायक देव प्रसन्न हुए व यह अलौकिक चमत्कारी प्रतिमा वहीं पर भूगर्भ से अनेकों भक्तगणों के सम्मुख पुनः प्रकट हुई। इसी प्रतिमाजी के न्हवण जल से श्री अभयदेवसूरिजी का देह निरोग हुआ था। कलिकाल सर्वज्ञ श्री हेमचन्द्राचार्य ने विक्रम सं. ११५० में यहीं पर दीक्षा ग्रहण कर शिक्षा प्रारम्भ की थी।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"अन्य मंदिर: 1. श्री शांतिनाथ-नेमिनाथ मंदिर। 2. श्री शांतिनाथ मंदिर जिसमें पार्श्वनाथ की प्राचीन और आकर्षक मूर्ति है, जिस पर वि.सं.1383 लिखा है; इस मंदिर में अन्य मूर्तियाँ 16वीं शताब्दी की हैं। 3. श्री मल्लिनाथ स्वामी मंदिर। 4. श्री चंद्रप्रभु स्वामी मंदिर। खंभात में 73 से अधिक मंदिर हैं। खंभात के मंदिर गुजरात का गौरव हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"कला और मूर्तिकला के कार्य: यह मूर्ति बहुत प्राचीन है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"दिशानिर्देश: वडोदरा से खंभात 80 किमी, मणीलक्ष्मी तीर्थ से 28 किमी और अहमदाबाद से 90 किमी दूरी पर है। खंभात में कई धर्मशालाएँ और भोजनशालाऐं हैं। कई उपाश्रय, पाठशालाएँ और ज्ञानभण्डार हैं। कई प्राचीन पांडुलिपियां और मूर्तियां इन ज्ञान भंडारों में हैं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"शास्त्र: कई शास्त्र, श्लोक, रास यहाँ कई महान आचार्यों, साधुओं आदि द्वारा लिखे गए थे। वि.सं.1422 में श्री विनयप्रभाजी द्वारा श्री गौतम स्वामी रास को खंभात में लिखा गया था। 16वीं शताब्दी के मध्य में, श्री नानसुरजी ने \\\\\\\"विचार सोगठ\\\\\\\", \\\\\\\"गजसुकुमार राजर्षि सज्जया\\\\\\\" और \\\\\\\"पंच तीर्थ स्तवन\\\\\\\" लिखा। श्री कुशलाभजी ने वी.स. 1653 में \\\\\\\"श्री स्तंभन पार्श्वनाथ स्तवन\\\\\\\" लिखा। 17वीं शताब्दी में, श्री ऋषभदासजी ने गुजराती में कई पुस्तकें लिखीं। वि.स.1727 में अपने चातुर्मास के दौरान, श्री लाभविजयजी ने यहाँ \\\\\\\"श्रीपाल मायासुंदरी रास\\\\\\\" लिखा। श्री मतिसागरजी ने \\\\\\\"खंभात की तिरुमाला\\\\\\\" और \\\\\\\"धन्ना ऋषि चौपाई\\\\\\\" लिखी। श्री आत्मारामजी महाराज ने वि.स.1942 में \\\\\\\"अग्यान तिमिर भास्कर\\\\\\\" लिखा था।\\\"}],\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\