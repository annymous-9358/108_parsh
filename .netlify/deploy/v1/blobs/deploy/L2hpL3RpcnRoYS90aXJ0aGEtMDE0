t/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/38nkbgmy2fbw2.js\\\",\\\"/_next/static/chunks/00gby0sjeqv85.js\\\"],\\\"Image\\\"]\\n23:T371f,\"])</script><script>self.__next_f.push([1,\"श्री स्थंभन पार्श्वनाथ. 108 पार्श्वनाथ में से 11 - श्री स्थंभन पार्श्वनाथ. मूलनायक: सुंदर परिकर-युक्त काले रंग की पद्मासन मुद्रा में 8 इंच ऊंची व 5 इंच चौड़ी श्री स्थंभन पार्श्वनाथ की मूर्ति है। मूर्ति के सिर के ऊपर 5 नाग फणों की छतरी है।. तीर्थ: यह गुजरात के खंभात शहर में खारवाडो में स्थित है।. ऐतिहासिकता: खंभात का प्राचीन नाम \\\"त्रंबवती\\\" था और आज इसे अंग्रेजी भाषा में \\\"कैम्बे\\\" के नाम से जाना जाता है। प्राचीन काल से खंभात अपने जैन मंदिरों के लिए बहुत प्रसिद्ध है।. श्री स्थंभन पार्श्वनाथ प्रभु की प्रतिमा नीलम रत्न की है। इस प्रतिमा का भी अपना एक भव्य इतिहास है। गई चौविसी के आषाढ़ी श्रावक ने इस प्रतिमा को भराई थी। यह प्रतिमा जी इसके बाद हजारों वर्ष तक विभिन्न देवताओं द्वारा पूजी जाती रही, अलग-अलग जगह पर वर्षों तक पूजी जाती रही, अंतिम बार कृष्ण महाराजा द्वारा इसकी पूजा की गई थी। द्वारका के नाश के समय इसको एक श्रेष्ठी ने समुद्र में पधरा दिया था। क्रांतिपुर के एक श्रेष्ठी को समुद्र में से देवी के संकेत द्वारा एवं सहायता से यह मूर्ति पुनःप्राप्त हुई। इसके साथ दो अन्य मूर्तियां भी प्राप्त हुई थीं, जिनमें से एक मूर्ति श्री पार्श्वनाथ भगवान की एवं एक मूर्ति श्री नेमिनाथ भगवान की थी, जो आज भी चारूप में श्री पार्श्वनाथ व पतन गाँव में श्री नेमीनाथ भगवान की मूर्ति विद्यमान है।. बीसवें तीर्थंकर के काल से लेकर अंतिम तीर्थंकर के काल तक यहाँ अनेकों चमत्कारिक घटनाएँ घटी हैं। तत्पश्चात वर्षों तक प्रतिमा लुप्त रही। विक्रम सं. १११९ में नवांगी टीकाकार श्री अभयदेव सूरिजी ने दैविक चेतना पाकर सेढी नदी के तट पर भक्ति भाव पूर्वक जयतिहुअण स्तोत्र की रचना की, जिससे अधिष्ठायक देव प्रसन्न हुए व यह अलौकिक चमत्कारी प्रतिमा वहीं पर भूगर्भ से अनेकों भक्तगणों के सम्मुख पुनः प्रकट हुई। इसी प्रतिमाजी के न्हवण जल से श्री अभयदेवसूरिजी का देह निरोग हुआ था। कलिकाल सर्वज्ञ श्री हेमचन्द्राचार्य ने विक्रम सं. ११५० में यहीं पर दीक्षा ग्रहण कर शिक्षा प्रारम्भ की थी।. अन्य मंदिर: 1. श्री शांतिनाथ-नेमिनाथ मंदिर। 2. श्री शांतिनाथ मंदिर जिसमें पार्श्वनाथ की प्राचीन और आकर्षक मूर्ति है, जिस पर वि.सं.1383 लिखा है; इस मंदिर में अन्य मूर्तियाँ 16वीं शताब्दी की हैं। 3. श्री मल्लिनाथ स्वामी मंदिर। 4. श्री चंद्रप्रभु स्वामी मंदिर। खंभात में 73 से अधिक मंदिर हैं। खंभात के मंदिर गुजरात का गौरव हैं।. कला और मूर्तिकला के कार्य: यह मूर्ति बहुत प्राचीन है।. दिशानिर्देश: वडोदरा से खंभात 80 किमी, मणीलक्ष्मी तीर्थ से 28 किमी और अहमदाबाद से 90 किमी दूरी पर है। खंभात में कई धर्मशालाएँ और भोजनशालाऐं हैं। कई उपाश्रय, पाठशालाएँ और ज्ञानभण्डार हैं। कई प्राचीन पांडुलिपियां और मूर्तियां इन ज्ञान भंडारों में हैं।. शास्त्र: कई शास्त्र, श्लोक, रास यहाँ कई महान आचार्यों, साधुओं आदि द्वारा लिखे गए थे। वि.सं.1422 में श्री विनयप्रभाजी द्वारा श्री गौतम स्वामी रास को खंभात में लिखा गया था। 16वीं शताब्दी के मध्य में, श्री नानसुरजी ने \\\"विचार सोगठ\\\", \\\"गजसुकुमार राजर्षि सज्जया\\\" और \\\"पंच तीर्थ स्तवन\\\" लिखा। श्री कुशलाभजी ने वी.स. 1653 में \\\"श्री स्तंभन पार्श्वनाथ स्तवन\\\" लिखा। 17वीं शताब्दी में, श्री ऋषभदासजी ने गुजराती में कई पुस्तकें लिखीं। वि.स.1727 में अपने चातुर्मास के दौरान, श्री लाभविजयजी ने यहाँ \\\"श्रीपाल मायासुंदरी रास\\\" लिखा। श्री मतिसागरजी ने \\\"खंभात की तिरुमाला\\\" और \\\"धन्ना ऋषि चौपाई\\\" लिखी। श्री आत्मारामजी महाराज ने वि.स.1942 में \\\"अग्यान तिमिर भास्कर\\\" लिखा था।. स्तुति: अतीत चोवीसी तणा नेमी प्रभु उपदेश थी, आषाढी श्रावक पुजता नीलम ताणा प्रभु पार्श्वजी, नागार्जुन ने आठमा बलदेव जी पण पुजता, \\\"श्री स्थंभन पार्श्व ने भावे करूँ हुं वंदना\\\"।. जाप मंत्र: \\\"ॐ ह्रीं श्री स्थंभन पार्श्वनाथाय नमः\\\". ट्रस्ट: श्री स्थंभन पार्श्वनाथ श्वेतांबर जैन तीर्थ, खारवाडो, पोस्ट: खंभात, जिला: खेडा, गुजरात-388620। फोन: 02698-220221।. छठा भव: वज्रनाभ राजा और कुरंगक भील. बारहवें देवलोक का आयुष्य पूर्ण होने के बाद मरुभूति का जीव पश्चिम महाविदेह की सुगंधि विजय में स्थित शुभंकरा नगरी में वज्रवीर्य राजा के पुत्र के रूप में उत्पन्न हुआ। उसका नाम वज्रनाभ रखा गया। युवावस्था में विजया नामक राजकुमारी के साथ उसका विवाह किया गया। वर्षों बाद उसे एक पुत्र हुआ, जिसका नाम चक्रायुध रखा गया।. एक बार क्षेमंकर नामक तीर्थंकर परमात्मा विचरण करते हुए वहाँ आए, राजा वज्रनाभ समवसरण में देशना सुनने गया। प्रभु की मधुर वाणी सुनकर वज्रनाभ के हृदय में वैराग्यभाव जाग्रत हुआ। राजमहल में आकर पुत्र आदि को समझाकर चक्रायुध का राज्याभिषेक किया। उसके बाद ज्ञानगर्भित वैराग्य से वज्रनाभ ने तीर्थंकर क्षेमंकर प्रभु के पास संयम स्वीकार किया। तीर्थंकर प्रभु के पास विशिष्ट ज्ञान प्राप्त करने हेतु आत्मसाधना में तत्पर वज्रनाभ मुनि गीतार्थ ज्ञानी बन गए। प्रभु ने उसे स्वतन्त्र रूप से विहार करने की आज्ञा प्रदान की। वे आकाशगामिनी विद्या के प्रभाव से सुकच्छ विजय में गए और पहाड़ों में विचरण करने लगे।. कमठ का जीव नरक का आयुष्य पूर्ण कर तथा पशु योनि के छोटे-छोटे भव में भ्रमण करते हुए सुकच्छ विजय में कुरंगक नामक भील के रूप में जन्म लिया। पाप के उदय के कारण उसने अशुभ कुल में जन्म लिया, अतः उसे जन्म से तो शुभ संस्कार नहीं मिले, परन्तु बड़े होने के बाद भी सुसंस्कार का कोई निमित्त नहीं मिला, अतः कुसंस्कार बढ़ते ही गए। जंगल में भटकना, शिकार खेलना, मांसाहार करना आदि दोषों में उस भील का चित्त लिप्त हो गया।. एक दिन कुरंगक भील ने जंगल में मुनि वज्रनाभ को देखा। पूर्वभव के द्वेष के कारण मुनि को देखते ही उसकी आँखों में वैर की आग भड़क उठी। उसने धनुष पर तीर चढ़ाया और मुनि की छाती का निशान लेकर तीर छोड़ा। तीर लगते ही उनकी छाती से रक्त का फव्वारा निकल पड़ा। वे \\\"नमो अरिहंताणं\\\" का उच्चारण करते हुए परमात्मा के ध्यान में लीन होकर समता भाव में जमीन पर गिर पड़े। वज्रनाभ मुनि का जन्म सुगन्धि विजय में हुआ था और उन्होंने दीक्षा भी वहीं ली थी, परन्तु उनके कर्म उन्हें साधना के लिए सुकच्छ विजय में ले गए और भील का संयोग करा दिया। कहा गया है इसीलिए 'रे कर्म! तेरी गति न्यारी...'. काशी का यह राजकुवर, यही देव सम्मेदशिखर गिरी वाला,. ये अहिक्षेत्र का सूर्य प्रबुद्ध, हृदय में करे जो विशुद्ध उजाला!. है यही पार्श्व जिसे खंभात में, भक्तो ने धरती खोद निकला,. चिंता छीन छु मंतर हो, जप चिंतामणि पार्श्व की माला!!\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-cente