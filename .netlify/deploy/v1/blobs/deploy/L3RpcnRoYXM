ext_f.push([1,\"80:T2f7f,\"])</script><script>self.__next_f.push([1,\"108 पार्श्वनाथ में से 94 - श्री नागेश्वर पार्श्वनाथ।\\n\\nमुलनायक: श्री पार्श्वप्रभु के देहप्रमाण नव हाथ ऊँची (13.5 फुट) व हरित वर्ण में काउसग्ग आसन में भगवान श्री नागेश्वर पार्श्वनाथ की हरे रंग की खड़ी मूर्ति। भगवान के सिर के ऊपर सात नाग फणों की छतरी है। छतर सहित कुल ऊंचाई 14 फीट है, छतर को छोड़कर भगवान के शरीर की ऊंचाई साढ़े तेरह (13.5) फीट है। भगवान की वास्तविक ऊंचाई नौ हाथों की थी।\\n\\nतीर्थ: यह उन्हेल गांव के पास क्षिप्रा नदी के तट पर है और समुद्र के स्तर से एक हजार फीट की ऊंचाई पर है।\\n\\nऐतिहासिकता: इस मंदिर में स्थापित मूर्ति लगभग 2800 साल पुरानी मानी जाती है और पन्ना से बनी है। मूर्तिकारों और मूर्ति विशेषज्ञों का मत है कि जिस मणि-पत्थर से मूर्ति बनी है, वह दो हजार साल से अधिक पुराना है। माना जाता है कि यह मूर्ति देवताओं द्वारा बनाई गई थी और पूर्व में अहिछत्र नगर के मंदिर में स्थापित थी। समय के साथ जब लोगों को इस मूर्ति के मूल्य का पता चला तो कई लोग लालचवश मूर्ति को नष्ट करना चाहते थे। अधिष्ठायक देवता ने मूर्ति की रक्षा की। एक जैन आचार्य ने अपनी तपस्या के बल पर धरणेन्द्रदेव को बुलाकर एक पत्थर की प्रतिकृति मूर्ति बनवाई ताकि लालची लोग असली मूर्ति को नुकसान न पहुंचा सकें। बाद में इस मूर्ति को पारसनगर लाकर स्थापित किया गया। निःसंतान राजा अजितसेन ने प्रभु के लिए एक सुंदर मंदिर बनवाया और पूजा-अर्चना से उन्हें संतान का आशीर्वाद मिला। विक्रम संवत 1624 में इस मंदिर का जीर्णोद्धार श्री अभयदेवसूरी के प्रयास से हुआ। पारसनगर आगे चलकर नागेश्वर कहलाया, इसलिए भगवान नागेश्वर पार्श्वनाथ के नाम से जाने जाने लगे। समय बीतने के साथ स्थान का पुजारी बाबा मूर्ति का संरक्षक बन गया और यह प्राचीन मंदिर जीर्ण अवस्था में रहा, जहां एक संन्यासी बाबा वर्षों तक इसकी देखभाल करते रहे परंतु प्रतिमा अपूजित ही रहती थी।\\n\\nयह भव्य, चमत्कारिक और प्रभु के समयकालीन मानी जाने वाली प्राचीन प्रतिमा अद्वितीय है, जो यहां की मुख्य विशेषता है। संन्यासी बाबा की देखभाल के दौरान भी चमत्कारिक घटनाओं के कारण स्थानीय लोग आकर्षित होकर दर्शनार्थ आते रहते थे, और आज भी ऐसी घटनाएं होती रहती हैं। उपाध्याय श्री धर्मसागरजी महाराज को पता चला कि राजस्थान के उन्हेल गाँव में 'नागबाबा' के रूप में जानी जाने वाली मूर्ति वास्तव में भगवान नागेश्वर पार्श्वनाथ की एक प्राचीन जैन श्वेतांबर मूर्ति है, जो गैर-जैनियों के कब्जे में थी। उनके प्रयासों से मूर्ति अदालत के आदेश द्वारा जैनियों को वापस मिली तथा श्री अभयसागरजी गणिवर्य द्वारा 18 अभिषेक पूजा कर पुनः प्रतिष्ठित की गई। विक्रम संवत 1970 के बाद से मंदिर पूर्णतः जैनियों के स्वामित्व में है। इस सफलता का श्रेय श्री अभयसागरजी महाराज साहब की बुद्धिमत्ता, कठिन प्रयासों, उदारता व वक्तृत्व को तथा तीर्थ के विकास में सहयोग देने वाले व्यापारियों को जाता है। नागेश्वर पार्श्वनाथ की मूर्ति की प्रतिष्ठा वैशाख सूद 6, वि.सं. 2037 में संपन्न हुई।\\n\\nअन्य मंदिर: कुशालसुरीजी की एक दादावाड़ी तथा राजेंद्र सूरीश्वरजी की एक भव्य दादावाड़ी भी है।\\n\\nकला और मूर्तिकला की रचनाएँ: भारत में कहीं भी काउस्सग्ग मुद्रा में खड़ी इतनी अद्भुत, रमणीय, भव्य, बड़ी और सुंदर नागेश्वर पार्श्वनाथ की मूर्ति नहीं है। मूलनायक के दोनों ओर काउस्सग्ग मुद्रा में शांतिनाथ और महावीर स्वामी की ग्रे-स्टोन की मूर्तियाँ हैं। मूर्ति के साथ मलमल-कपड़ा, कमर-पट्टी और दालान है। मूर्ति इतनी बड़ी होते हुए भी प्राकृतिक व संतुलित मुद्रा में है, जो कुशल कलाकारों के लिए भी एक पहेली है। सालों से एक सांप मूर्ति के सिर पर छत्र के पीछे पत्थर की दीवार के आले में रहता है, जो कभी-कभी सफेद या धूसर रंग में भाग्यशाली भक्तों को दिखाई देता है। मूलनायक के चरणों के पास दोनों ओर चामरधारी 37 इंच ऊँची मूर्तियाँ हैं, जो अत्यंत शानदार हैं। मूर्ति की आँखें इतनी कलात्मक हैं कि हर भक्त को लगता है मानो भगवान उस पर विशेष कृपा बरसा रहे हैं।\\n\\nदिशानिर्देश: नागेश्वर तीर्थ विक्रमगढ़ आलोट से 8 किलोमीटर और चौमहला रेलवे स्टेशन से 15 कि.मी. की दूरी पर है। देहरादून एक्सप्रेस, फिरोजपुर एक्सप्रेस, जनता एक्सप्रेस, मथुरा-वडोदरा लोकल, पार्सल ट्रेनें और अवध एक्सप्रेस यहाँ रुकती हैं। तीर्थ पेढ़ी पर जीप व मिनी बसों की व्यवस्था है जो सूचना करने पर आलोट भेजी जाती हैं। आलोट में भी पेढ़ी की तरफ से रात्रि ठहरने की व्यवस्था है। उत्कृष्ट धर्मशाला और भोजनशाला की सुविधाएं हैं।\\n\\nशास्त्र: यह मथुरा शैली की ग्यारह सौ साल से अधिक पुरानी मूर्ति मानी जाती है। मथुरा की कंकाली पहाड़ियों