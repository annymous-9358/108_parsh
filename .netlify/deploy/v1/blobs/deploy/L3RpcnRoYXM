.__next_f.push([1,\"75:T193b,\"])</script><script>self.__next_f.push([1,\"83. श्री मंडोवरा पार्श्वनाथ\\n\\nमूलनायक: सफेद रंग की पद्मासन मुद्रा में 12.5 इंच ऊंची व 10 इंच चौड़ी भगवान श्री मंडोवरा पार्श्वनाथ की मूर्ति।\\n\\nतीर्थ: यह मुंडवा गाँव में है।\\n\\nऐतिहासिकता: सोजत शहर के पास मुंडवा गांव भगवान पार्श्वनाथ का प्राचीन तीर्थ है। इस तीर्थ की उत्पत्ति के पीछे एक कींवदंती प्रसिद्ध है कि इस गाँव के एक श्रावक को प्रभु दर्शन के बाद ही भोजन करने का नियम था। इस नियम पालन हेतु वह रोज 5 मील दूर गाँव में जाता था। उसकी नियम निष्ठा से प्रसन्न हुए अधिष्ठायक देव ने स्वप्न में दर्शन दिए। गाँव बाहर केरडे के वृक्ष नीचे पार्श्वप्रभु के मनोहारी बिम्ब का संकेत दिया और उसे नवीन मंदिर बनाने का आदेश दिया। स्वप्न निर्देशानुसार उस श्रावक को वृक्ष के नीचे पार्श्व प्रभु की प्रतिमा प्राप्त हुई। मंदिर निर्माण हेतु धन की आवश्यकता थी। अधिष्ठायक देव के स्वप्न संकेतानुसार उसने जौ से भरा टोपला लेकर निर्दिष्ट स्थान में रख दिया। सुबह होते ही सभी जौ सोने के हो गए। बस, उसी सुवर्ण का व्यय कर इस मंदिर का निर्माण कराया गया। मुंडाव-मंडन पार्श्वनाथ प्रभु मंडोवरा पार्श्वनाथ के नाम से प्रख्यात हुए। पौष दशमी के दिन यहाँ मेला भी लगता है।\\n\\nयहाँ जैन का एक भी घर नहीं है। चंडावल जैन संघ इस तीर्थ की व्यवस्था करता है।\\n\\nअन्य मंदिर: वर्तमान में कोई अन्य मंदिर नहीं है।\\n\\nकला और मूर्तिकला की रचनाएँ: भगवान की यह मूर्ति बहुत ही अभिव्यंजक और रमणीय है।\\n\\nदिशानिर्देश: यह तीर्थ निकटतम रेलवे स्टेशन चंद्रावल से 4 किलोमीटर की दूरी पर और सोजत शहर से 15 किलोमीटर की दूरी पर है। बस सेवा और निजी वाहन उपलब्ध हैं। धर्मशाला और भोजनशाला की व्यवस्था है, उपाश्रय भी है। इस तीर्थ का प्रबंधन चंडावल जैन संघ द्वारा किया जाता है।\\n\\nशास्त्र: इस मंदिर का उल्लेख \\\"श्री पारसनाथ नाममाला\\\", 1750 में रचित \\\"तीर्थ माला\\\" और 1722 में पंडित महिमाकृत रचित \\\"चैत्य पारिपाटी\\\" जैसे ग्रंथों में किया गया है। जिरावाला तीर्थ में मुंडारा पार्श्वनाथ की एक मूर्ति है। पूज्य आचार्यदेव श्रीमद् विजय सूर्य मिश्र जी, आचार्यदेव श्री विजय भद्रकरन सूरीश्वरजी, पूज्य आचार्यदेव श्रीमद् विजय हीर सूरीश्वरजी, पूज्य आचार्यदेव श्रीमद् भुवन भानू सूरीश्वरजी महाराज ने इस प्राचीन मंदिर में आकर इनकी आराधना की थी।\\n\\nस्तुति: जे स्वप्न आपकी करेड़ा के वृक्ष के नीचे से प्रगटता, जो जौ भरेला कंरडिया ने सोनामा पलटावता, मंडावा नगरे तीर्थ तारू मुंडोजो मुझ मोहने। \\\"श्री मंडोवरा पार्श्व\\\" ने भावे करूँ हुं वंदना।\\n\\nजाप मंत्र: ॐ ह्री अर्हं श्री मंडोवरा पार्श्वनाथय नमः\\n\\nट्रस्ट: श्री मंडोवरा पार्श्वनाथ जैन श्वेतांबर तीर्थ, मुंडवा, जिला: पाली, राज्य: राजस्थान-306306, भारत। टेलीफोन: 02960-285059, मोबाइल: 9571556497/7357150592।\\n\\nश्री 108 पार्श्वनाथ स्तुति: हे \\\"हमीरपुरा\\\"! खमीर देजो, विषय पीरने मारवा, \\\"पोसालिया\\\"! गुण पोपजो, भवजथी पार उतारवा, \\\"काछोली\\\"! मारा कर्म छोली, आत्मा निर्मल करो, \\\"शंखेश्वरा\\\" प्रभु! विनवुं रक्षा करो! रक्षा करो!!\"])</script><script>self.__next_f.push([1,\"76:T38ba,\"])</script><script>self.__next_f.push([1,\"84. श्री स्वयंभू पार्श्वनाथ\\n\\nमूलनायक: नील (पिस्ता) रंग की एक जटिल नक्काशीदार परिकर के साथ पद्मासन मुद्रा में 21 इंच ऊंची व 16.25 इंच चौड़ी भगवान श्री स्वयंभू पार्श्वनाथ की मूर्ति है। सिर पर 7 नाग के फणों की दोहरी छतरी है। प्रतिमा जहर मोहर के पाषाण से निर्मित है तथा नाग-नागिन की जोड़ी भगवान के पग में पद्म चिन्ह के रूप में शोभायमान है। विश्व में यह अपनी तरह की एक मात्र मूर्ति है।\\n\\nतीर्थ: यह कापरड़ा गाँव में है।\\n\\nऐतिहासिकता: यह गांव 14वीं शताब्दी का है। कापरड़ा गाँव की स्थापना कब हुई, इसका पता लगाना कठिन है। इसके प्राचीन नाम कर्पंतहेडक, कापडहेड़ा थे। पहले इस गाँव को \\\"कापडहेडा\\\" के रूप में जाना जाता था, क्योंकि यहां कपड़े के मेले लगते थे, बाद में इसे \\\"कापरड़ा\\\" कहा जाने लगा। राव चंपा ने गाँव में एक सुंदर झील बनवाई जो उनके नाम से आज भी चंपसार नाम से है। यहां इस मंदिर का निर्माण कैसे हुआ, इसकी एक कहानी है। भंडारी गोत्र के श्री भानाजी, राजा गजसिंह के राज्यकाल में जोधपुर राज्य में जेतारण परगने के हाकिम थे। किसी कारण से राजा गजसिंह उनसे क्रोधित हो गए और उन्हें जोधपुर बुला लिया। रास्ते में वह कापरड़ा गाँव में रुक गये। भयाकुल श्री भंडारीजी को प्रभु-प्रतिमा का दर्शन करके ही भोजन करने का नियम था। गाँव में तलाश करने पर वहां उपाश्रय में विराजित एक यतिवर के पास प्रभु प्रतिमा होने का पता लगा। भंडारीजी प्रभु का दर्शन करके जब जाने लगे, तब निमितशास्त्र जानकार यतीजी ने भंडारीजी से जोधपुर जाने का कारण सुनकर कहा कि यह आपकी कसौटी है, धैर्य रखना, आपको वहां जाने पर राजा द्वारा सम्मान मिलेगा क्योंकि आप निर्दोष हैं। इधर राजा को स्वप्न में संकेत मिला कि हाकिम निर्दोष है, सुनी हुई सारी बातें झूठी हैं। राजा द्वारा पूछताछ करवाने पर भानाजी निर्दोष मालूम पड़े, जिससे जोधपुर पहुंचने पर उन्हें राजा द्वारा सम्मान दिया गया व पांच सौ रजत मुद्राएं उपहार स्वरुप भेंट दी गईं। भंडारीजी खुश होकर जेतारण जाते वक्त पुनः यतीजी से मिले व सारा वृतांत कहा।\\n\\nयतीजी ने यहाँ सुन्दर मंदिर बनवाने की प्रेरणा दी, इस पर भंडारीजी ने कहा कि उपहार में प्राप्त पांच सौ मुद्राएं सेवा में अर्पित हैं और जो बनेगा, जरूर करूंगा। यतीजी ने प्रसन्नता पूर्वक मुद्राओं को एक थैली में भरकर ऊपर वर्धमान विधा सिद्ध वासक्षेप डालकर भंडारीजी को सौंपते हुए कहा कि थैली को उलटी न करना, मंदिर की आवश्यकता पूरी होती रहेगी। भंडारीजी का पुण्य प्रबल था। उनकी इच्छानुसार एक अभूतपूर्व मंदिर का नक्शा बनाया गया व वि.सं.1660 में मंदिर के लिए नींव रखी गई। कार्य प्रारम्भ हुआ। भानाजी ने अपने पुत्र श्री नरसिंह को इस कार्य के लिए रखा। कार्य सम्पूर्ण होने को ही था कि नरसिंहजी ने थैली उलटी करके देखना चाहा, ज्यों ही थैली उलटी की सारी मुद्राएं बाहर आ गईं। यह बात यतीजी को अवगत कराई गई। यतीजी ने कहा कि जो होना था हो गया, पिताजी को कापरड़ा बुला लो। भानाजी को कापारड़ा बुलाकर सारे वृतान्तों से अवगत करवाया गया। भंडारीजी को अत्यंत दुःख हुआ लेकिन उपाय नहीं था। मंदिर उनकी भावनानुसार पूरा न हो पाया, लेकिन काफी हद तक हो चुका था। एक सुंदर चार मंजिला मंदिर बनाया गया था और एक मूर्ति की खोज शुरू हुई। श्री जिनचंद्रसूरिजी महाराज साहब को एक सपना आया जिसमें बबुल के पेड़ के नीचे जमीन में एक मूर्ति की उपस्थिति का संकेत दिया गया था।\\n\\nचमत्कारिक घटनाओं के साथ वि.सं. 1647 पौष कृष्ण 10 को प्रभु के जन्म कल्याणक के शुभ दिन भूगर्भ से यह प्रतिमा प्रकट हुई थी। जेतारण के हाकिम श्री भानाजी भण्डारी द्वारा निर्मित चौमंजिले अद्भुत भव्य जिनालय में वि.सं. 1678 वैशाख शुक्ला पूर्णिमा सोमवार के दिन आचार्य श्री जिनचन्द्रसूरिजी के सुहस्ते इस प्रभु प्रतिमा की प्रतिष्ठा संपन्न होने का लेख प्रतिमा के नीचे उल्लिखित है।\\n\\nजैसा कि यह जमीन से ही प्रकट हुई थी इसलिए इस मूर्ति को श्री स्वयंभू पार्श्वनाथ और गाँव के नाम पर \\\"कापरड़ापार्श्वनाथ\\\" भी कहा जाता है। वि.सं. 1975 के लगभग जब शासनसम्राट आचार्य श्री नेमिसुरीश्वरजी महाराज का यहाँ पदार्पण हुआ, तब व्यवस्था में शिथिलता आने के कारण होती हुई आशातना को देख उन्हें दुःख हुआ। शीघ्र ही अपने पूर्ण प्रयास से जिणोद्धार का कार्य प्रारंभ करवाकर मंदिर की सुव्यवस्था की। वि.सं. 1975 माघ शुक्ला वसंत पंचमी के दिन आचार्य श्री के सुहस्ते पुनः प्रतिष्ठा संपन्न हुई। पहले इस चौ-मंजिले चतुर्मुख मंदिर में श्री स्वयंभू पार्श्वनाथ भगवान की एक ही प्रतिमा थी। इस प्रतिष्ठा के समय अन्य 15 प्रतिमाएं भी प्रतिष्ठित करवाई गईं। इस विशाल मंदिर में एक तहखाना भी है। चैत्र मास के शुक्ल पक्ष के पांचवें दिन यहां एक मेला आयोजित किया जाता है।\\n\\nअन्य मंदिर: कोई दूसरा मंदिर नहीं है।\\n\\nकला और मूर्तिकला के कार्य: इसका शिखर करीब 94 फीट ऊंचा है जो 8 किलोमीटर की दूरी से ही देखा जा सकता है। हॉल में गुंबदों, खंभों और मेहराबदार फाटकों की छत पर मूर्तियों की मूर्तिकला कौशल वास्तव में असाधारण है। मंदिर की दीवारें और खंभे प्राचीन कला और चित्रों के नमूने से सजी हैं। इस मंदिर का मुख्य आकर्षण चौमुखी मूर्तियाँ हैं। यह मंदिर 94 फीट ऊँचा एवं 114 स्तम्भों पर है और यह तारंगा के श्री अजितनाथ भगवान मंदिर की याद दिलाता है। यह मंदिर पूजा के लिए हर साल यहां छःरिपालित संघ आते हैं।\\n\\nदिशानिर्देश: मंदिर से शिवड़ी का निकटतम रेलवे स्टेशन 8 किलोमीटर की दूरी पर है, जोधपुर 50 किलोमीटर, पीपाड़ शहर 16 किलोमीटर, बिलाड़ा 25 किलोमीटर की दूरी पर है। यहां बस और टैक्सी उपलब्ध हैं। यह मंदिर सड़क, रेल और हवाई मार्ग से जुड़ा हुआ है। निकटतम हवाई अड्डा जोधपुर है। यह मंदिर जोधपुर-जयपुर हाईवे पर स्थित है। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं।\\n\\nशास्त्र: इस मंदिर का उल्लेख \\\"श्री कापरडाजी तीर्थ नो रास\\\", \\\"श्री कापहेटा रास\\\", \\\"108 नामगर्भित श्री पार्श्वनाथ स्तवन\\\", \\\"श्री पार्श्वनाथ नाममाला\\\", \\\"चैत्य परिपाटी\\\", \\\"कापडहेटा पार्श्वनाथ कविता\\\", \\\"श्री कापडहेटा पार्श्वनाथ वरिदध स्तवन\\\", \\\"श्री पार्श्वनाथ प्रभु ना