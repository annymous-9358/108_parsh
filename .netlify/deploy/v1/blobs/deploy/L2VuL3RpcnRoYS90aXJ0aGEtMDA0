vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"फोटो: श्री विघ्नहरा पार्श्वनाथ मंदिर, रांदेल सुरत।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"108 पार्श्वनाथदादा का इतिहास एवं किस प्रकार पहुंचना... भाग-2: नवसारी, सुरत और रांदेर के कुल 4 पार्श्वनाथ प्रभु के तीर्थ करने के पश्चात भरूच एवं गंधार में आये कुल 2 पार्श्वनाथ प्रभु तीर्थों की यात्रा करेंगे। सूरत से भरूच 76 किमी तथा भरूच से गंधार 47 किमी की दूरी पर है। भरूच में 5. श्री कल्लहारा पार्श्वनाथ तथा गंधार में 6. श्री अमीझरा पार्श्वनाथ हैं (श्री 108 पार्श्वनाथ में से भोपावर से 10 किमी की दूरी पर अमझेरा में श्री अमीझरा पार्श्वनाथ है)।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"5. श्री कल्हारा पार्श्वनाथ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"मूलनायक: मूलनायक श्री मुनिसुव्रत स्वामी भगवान हैं। इस श्री मुनिसुव्रत स्वामी भगवान मूर्ति के बगल में उच्च सफेद रंग की पद्मासन मुद्रा में ३५ इंच ऊँची एवं २९ इंच चौड़ी भगवान श्री कल्हारा पार्श्वनाथ की मूर्ति है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"तीर्थ: यह नर्मदा नदी के तट पर भरूच में श्रीमाली पोल में है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"ऐतिहासिकता: भरूच एक बहुत ही प्राचीन शहर और तीर्थस्थल है। प्राचीन काल में यह 'भृगुपुर' या 'भृगुकच्छ' के नाम से बहुत प्रसिद्ध था। भरूच एक बंदरगाह है और पुराने दिनों में यह प्रसिद्ध व्यापार का एक केंद्र था। अपने आयात और निर्यात व्यापार के कारण यह शहर बहुत समृद्ध था। साढ़े ग्यारह लाख साल पहले, एक घोड़े को उपदेश देने के लिए 20वें तीर्थंकर श्री मुनिसुव्रत स्वामी पैदल यात्रा पर 240 मील की दूरी तय कर भरूच आए थे। ब्राह्मणों ने इस घोड़े को अश्वमेघ यज्ञ के लिए छोड़ा था। भगवान मुनिसुव्रत स्वामी के उपदेश को सुनकर घोड़ा शुभ भाव में रहते हुए शांति से मर गया और अन्य जीवित प्राणियों के प्रति अपनी सारी दुश्मनी भूल गया और सब से माफी माँग रहा था। घोड़ा मृत्यु के समय शुभभाव में होने के कारण उसका जन्म देवलोक में एक देव के रूप में हुआ था। अपने पिछले जन्म की जातिस्मरण हुआ जिसके कारण उन्होंने एक सुंदर मंदिर का निर्माण किया वहां और उसमें मुनिसुव्रत भगवान की मूर्ति स्थापित की गई। यह मंदिर जिसे 'अश्वबोध तीर्थ' के नाम से जाना जाता है। राजकुमारी सुदर्शना सिंहलद्वीप के राजा सिंहल की बेटी थीं।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"एक दिन नमस्कार महामंत्र का जाप करते हुए किसी व्यक्ति को सुना तो राजकुमारी को 'जाति स्मरण ज्ञान' होता है जिसका अर्थ है कि वह अपने पिछले जन्म को याद करती है जहां वह एक चील थी उस समय जब वह मृत्यु शय्या पर थी और उस समय एक जैन साधु ने उनके लिए नवकार मंत्र का जाप किया था और जिसके कारण वह राजकुमारी के रूप में पैदा हुई है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"बाद में राजकुमारी सुदर्शना ने इस अश्वबोध तीर्थ का जीर्णोद्धार कराया और इस मंदिर को 'शकुनिका विहार' नाम से जाना जाने लगा। समय के साथ इस मंदिर में कई नवीकरण किए गए थे। शांतु मेहता ने इस मंदिर को स्वर्ण कलश से सजाया। मंत्री अंबद ने 32 लाख सोने के सिक्के खर्च कर इस मंदिर का जीर्णोद्धार करवाया।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"तथा इन मूर्तियों को कलिकाल सर्वज्ञ प.पू.आ.भ.श्री हेमचंद्राचार्य के पूज्य हाथों द्वारा स्थापित किया गया। इस मंदिर में महाराजा कुमारपाल द्वारा की गई आरती बहुत प्रसिद्ध हुई और \\\\\\\"महाराजा कुमारपाल की आरती\\\\\\\" के रूप में जानी जाती है। कई और शानदार मंदिर यहां बनाए गए थे।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"मुस्लिम शासन के दौरान इनमें से कई मंदिरों को मस्जिदों में बदल दिया गया था। आज भी वहाँ भरूच में 9 प्राचीन मंदिर हैं। कुछ साल पहले इस नए मंदिर का जीर्णोद्धार किया गया था और शानदार तीन मंजिला मंदिर बनाया गया, और विक्रम युग के वर्ष 2045 में माघ महीने के शुक्लपक्ष के 13वें दिन आचार्य श्री राज्याशूरिश्वरजी के श्रद्धेय हाथों द्वारा मूर्ति को फिर से स्थापित किया गया था। श्री कल्हारा पार्श्वनाथ की यह प्राचीन और आकर्षक मूर्ति \\\\\\\"कल्याण पार्श्वनाथ\\\\\\\" के रूप में भी लोकप्रिय है। श्री नयविजयजी ने इस पार्श्वनाथ का नाम \\\\\\\"श्री यशोधरा पार्श्वनाथ\\\\\\\" रखा।\\\"}],\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-003\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Sahastrafna Parshwanath, Shri Surajmandan Parshwanath and Shri Vighnahara Parshwanath\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-006\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Sri Amijhara Parshvanath (Gandharya Parshvanath)\\\"}],[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n21:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"mt-auto border-t border-sandstone-deep/60 py-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur\\\"}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"25:[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"children\\\":\\\"श्री भक्तमार भाव मंदिर: भरूच में भारत का पहला सबसे सुंदर भक्तमार मंदिर बनाया गया था। अभयारण्य में आचार्य श्री मातुंगसुरिश्वरजी की मूर्ति है। आचार्य श्री मातुंगसुरिश्वरजी ने भक्तमार स्तोत्र की रचना की है। आचार्य श्री मातुंगसुरिश्वरजी भक्तमार स्तोत्र की रचना करते समय लोहे की जंजीरों में जकड़े हुए थे, इसलिए मूर्ति भी लोहे की जंजीरों में जकड़ी हुई है। इसके अलावा, मरुदेवता, भरत महाराजा, लब्धिसुरी महाराज साहेब और विक्रमसूरिजी महाराज साहेब की मूर्तियाँ हैं। इस मंदिर के तहखाने में भक्तमार स्तोत्र की 44 गौरवशाली गाथाओं के चित्रण हैं। 44 गाथाओं का प्रतीक भक्तामर स्तोत्र में इसके यंत्र और चित्रों को दर्शाया गया है। इस मंदिर में एक 51 फीट ऊंची मुलनायक आदिनाथ भगवान की प्राचीन मूर्ति है।\\\"}]\\n26:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"अन्य मंदिर: भरूच में 11 अन्य मंदिर हैं।\\\"}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"कला और मूर्तिकला के कार्य: चूंकि यह एक प्राचीन शहर है, इसलिए हर जगह प्राचीन मूर्तिकला कला दिखाई देती है। इसका दरवाज़ा बेहद शानदार है। पहली मंजिल पर मुलनायक श्री मुनिसुव्रत स्वामी की मूर्ति है और इसके बगल में श्री कल्हारा पार्श्वनाथ की मूर्ति है। दूसरी मंजिल पर श्री सहस्रफणा पार्श्वनाथ भगवान की मूर्ति है। काले रंग की कायोत्सर्ग मुद्रा में खड़ी 127 सेंटीमीटर ऊंची श्री मुनिसुव्रत स्वामी भगवान की मूर्ति भी है।\\\"}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"children\\\":\\\"Directions: This shrine is on the main Bombay-Ahmedabad railway line. Railway station is 2 km from the temple. Is at a distance of. Bharuch is well connected to all the cities of Gujarat by rail and road. Bus services and private vehicles are available here. Dharamshala and Bhojanhala facilities are available here. There is also an Ayambilshaala. The pilgrimage places of Kavi, Gandhar, Dahej, Jambusar are nearby. Vejalpur and Kabirpura have a beautiful and magnificent temple which is close by.\\\"}]\\n29:[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"children\\\":\\\"Shastra: In \\\\\\\"Shri Bhairav ​​Parshvanath Stavan\\\\\\\", in \\\\\\\"108 Name Garbhit Shri Parshvanath Stavan\\\\\\\", in \\\\\\\"Shri Parshvanath Naam Mala\\\\\\\", in \\\\\\\"Teerthamala\\\\\\\", mention of \\\\\\\"Kalhara Parshvanath\\\\\\\" is found. \\\\\\\"Shri Parshvanath Sankhya Stawan\\\\\\\" etc. Shri Gyanvimalji has written a eulogy on Shri Kalhara Parshvanath. A mention of Bharuch Tirtha is made in \\\\\\\"Sri Jagachintamani Chaityavandan\\\\\\\".\\\"}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"15\\\",{\\\"children\\\":\\\"There is an ancient temple of Shri Kalhara Parshva\"])</script><script>self.__next_f.push([1,\"nath in Jainabad in Dasada taluk of Saurashtra. The ancient name of this village was \\\\\\\"Kalhara\\\\\\\" and this village is considered to be around 1000 years old. Later this village came to be known as \\\\\\\"Jainabad\\\\\\\". The present temple is believed to be built more than 125 years old. It is believed that even before this there were many Jain temples here. The idol here is very miraculous, miracles keep happening here. Many years ago the village people saw a bright light at night near the temple, the light was seen till the peak of the temple. Images of two people were seen in this bright light. These two people circumambulated the temple and disappeared. The entire village had seen this incident. During the night the sound of bells ringing and music coming from the temple is heard. “Saffron rain” also happens here, especially when “Chhatri Palit Sangha” comes, then saffron rain definitely happens here.\\\"}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"children\\\":\\\"Praise: Kalhara Paras Mohbhangi Kalahara became Jazo, I once brought Jazo in Niranjannona Nagar, Jainabadne Bhrigukach Tara Tirtha Jagma Zanita. Shri Kalhara Parshva said, I will worship you.\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"17\\\",{\\\"children\\\":\\\"Chant Mantra: Om Hree Arham Shri Kalhara Parshvanathaya Namah.\\\"}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"children\\\":\\\"Trust: Shri Munisuvrat Swami Shwetambar Jain Daisar Pedhi, Shri Kalhara Parshvanath Shwetambar Jain Tirtha, Srimalipol, Bharuch - 392001, State: Gujarat, India. Phone: 02642-262586/262587.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[lang]/tirtha/[slug]/layout,_N_T_/[lang]/tirtha/[slug]/page,_N_T_/en/tirtha/tirtha-004"},"segmentPaths":["/_tree","/_full","/$d$lang/tirtha/$d$slug/__PAGE__","/$d$lang/tirtha/$d$slug","/$d$lang/tirtha","/$d$lang","/_index","/_head"],"revalidate":60,"cacheControl":{"revalidate":60,"expire":31536000}}}