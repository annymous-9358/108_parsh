20.193 4 14.993 4 10a8 8 0 0 1 16 0\\\",\\\"key\\\":\\\"1r0f0z\\\"}],[\\\"circle\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"10\\\",\\\"r\\\":\\\"3\\\",\\\"key\\\":\\\"ilqhr7\\\"}]],\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}]\\n24:T5567,\"])</script><script>self.__next_f.push([1,\"Shri Godiji Parshvanath. 104. श्री गोडीजी पार्श्वनाथ. मूलनायक: सफेद रंग की पद्मासन मुद्रा में भगवान श्री गोडीजी पार्श्वनाथ की मूर्ति।. तीर्थ: यह बंबई शहर के पायधुनी इलाके में है।. ऐतिहासिकता: भगवान पार्श्वनाथ की मूर्तियों को कई प्रसिद्ध और प्रभावशाली नामों से जाना जाता है, उनमें से संक्षिप्त और मधुर नाम \\\"गोडी पार्श्वनाथ\\\" का है। भगवान गोडी जी पार्श्वनाथ का मूल मंदिर में, लगभग 1.5 फीट ऊंची मूर्ति थी। यह मंदिर पाकिस्तान के थारपारकर जिले के गोडी में था। मूल मंदिर अभी भी जीर्ण-शीर्ण अवस्था में खड़ा है, लेकिन मंदिर में कोई मूर्ति नहीं है। यह इस्लामकोट और नगरपारकर के बीच गोडी गाँव में है। यहां के मूलनायक प्रतिमाजी को किस स्थान पर प्रतिष्ठित किया गया यह ज्ञात नहीं है, लेकिन आज भी भगवान गोडी जी पार्श्वनाथ की कई मूर्तियाँ मौजूद हैं। उनमें, यह बंबई के पायधुनी इलाके में भगवान गोडी जी पार्श्वनाथ की मूर्ति बहुत प्रसिद्ध है। ऐसा माना जाता है कि यह भगवान गोडीजी पार्श्वनाथ की प्राचीन, प्रभावशाली, आकर्षक मूर्ति को राजस्थान के हमीरपुर के प्राचीन और प्रभावशाली मंदिर (जिसे आज मीरपुर के नाम से जाना जाता है) से बॉम्बे लाया गया। 19वीं शताब्दी की शुरुआत में, कई जैन मुंबई आए और किले इलाके में बस गए। इस इलाके में एक मंदिर बनाया। भगवान गोडीजी पार्श्वनाथ की मूर्ति राजस्थान के हमीरपुर से लाई गई। इस मंदिर में मूलनायक के रूप में स्थापित किया गया था। भगवान आदिनाथ और भगवान चिंतामणि पार्श्वनाथ की मूर्तियों को मूलनायक भगवान के दोनों ओर स्थापित किया गया था। इस मंदिर में भगवान गोडीजी पार्श्वनाथ की स्थापना के बाद, मुंबई में जैन आबादी बढ़ने लगी और जैन समुदाय समृद्ध होने लगा। विक्रम युग के 1859 में, किले के इलाके में एक बहुत बड़ी आग लगी थी। आग 72 घंटे तक चली और लाखों रुपये की बर्बादी हुई। इसलिए, कई जैन परिवार किला इलाके को छोड़ कर पायधुनी इलाके में बस गए। जैन समुदाय ने अन्य स्थान पर भगवान गोडीजी पार्श्वनाथ मूर्ति को स्थानांतरित करने का फैसला किया। फोर्ट इलाके में एक नया मंदिर बनाया गया और वि.स.1865 में मूलनायक भगवान शांतिनाथ की मूर्ति की प्रतिष्ठित की गई थी। एक विशाल और शानदार मंदिर पायधुनी में बनाया... (शेष विवरण अगले पृष्ठ पर)।. (...मंदिर के निर्माण की कथा जारी) और यह सुंदर, आकर्षक और प्रभावशाली भगवान गोडीजी पार्श्वनाथ की आकर्षक मूर्ति को विक्रम युग के वर्ष 1868 में मंदिर में धूमधाम के साथ प्रतिष्ठित किया गया था। भगवान गोडीजी पार्श्वनाथ की यह मूर्ति बहुत ही चमत्कारी है। इस मूर्ति ने भव्यता प्राप्त की और चारों ओर प्रसिद्ध हो गई, कई तीर्थयात्री इस मंदिर में आते हैं। कुछ साल पहले, मूलनायक भगवान की मूर्ति को उत्थापित किए बिना मंदिर को भगवान के निवास की तरह पुनर्निर्मित किया गया था और वि.सं. 2045 में आचार्य श्रीमद विजय, आचार्य श्री सुबोधसागरसूरीश्वरजी, आचार्य श्री दर्शनसागरसूरीश्वरजी, आचार्य श्री भुवनभानुसूरीश्वरजी के शिष्य आचार्य श्री हेमचंद्रसूरीश्वरजी की उपस्थिति में कई मूर्तियों व तीर्थंकरों को यहाँ स्थापित किया गया। हर साल वैशाख महीने के शुक्ल पक्ष के 10वें दिन ध्वजा परिवर्तन किया जाता है।. अन्य मंदिर: इस इलाके में और बॉम्बे शहर में कई शानदार मंदिर हैं। वल्केश्वर का आकर्षक मंदिर दिलवाड़ा मंदिर की सुंदर नक्काशी की याद दिलाता है। मुंबई में चेंबूर, अगासी, दहिसर आदि के मंदिर बहुत प्रसिद्ध हैं।. कला और मूर्तिकला की रचना: बॉम्बे के आकर्षक शहर में भगवान गोडीजी पार्श्वनाथ की मूर्ति हमें आकर्षित करती है। भगवान की नाजुक आँखों से असीम करुणा की धारा बहती है और कठोर हृदय वाले का भी हृदय पिघला देती है। परिकर के बिना भी मूर्ति सुंदर दिखती है। इस मंदिर की कलात्मकता, जो भगवान के निवास की तरह चमकीली है, कला की विरासत का एक नमूना है। मंदिर की नक्काशी सुंदर और भव्य है। इस मंदिर के दर्शन हेतु जरूर जाना चाहिए।. दिशानिर्देश: पायधुनी मुंबई में एक घनी आबादी वाला इलाका है। यह मंदिर रेलवे स्टेशन के करीब है और कई जैन गतिविधियों का केंद्र है। इस शहर के अमीर श्रावकों की उदारता विश्व प्रसिद्ध है। यहां बस सेवा और निजी वाहन उपलब्ध हैं। बॉम्बे में लोकल ट्रेनों के स्टेशनों की ग्रांट रोड, चुन्नी रोड और पश्चिमी रेलवे की समुद्री लाइनें तथा मध्य रेलवे के भायखला, मस्जिदबंदर, बोरीबंदर आदि स्टेशन इस मंदिर के करीब हैं। इस शहर में कई धर्मशालाएँ, भोजनशालाएँ, उपाश्रय, ज्ञानभंडार, पाठशाला और आयंबिलशाला हैं।. शास्त्र: भगवान गोडीजी पार्श्वनाथ का उल्लेख \\\"श्री गोडी जी पार्श्वनाथ उत्पत्ति स्तोत्र\\\", \\\"श्री गोडी पार्श्वनाथजीनो चोडलियुं\\\", \\\"श्री गोडी पार्श्वनाथ स्तवन\\\", \\\"श्री गोडी पार्श्वनाथ छंद\\\", \\\"श्री गोडी पार्श्वनाथ स्तोत्र\\\" आदि में किया गया है। भारत में कई मंदिरों में भगवान गोडीजी पार्श्वनाथ की मूर्तियाँ हैं।. भारत में भगवान गोडीजी पार्श्वनाथ के मंदिर: 1. अहमदाबाद के नरोड़ा गाँव में पद्मावती पार्श्वनाथ को भगवान गोडीजी पार्श्वनाथ के नाम से भी जाना जाता है। 2. अहमदाबाद के शाहपुर में। 3. एलिस ब्रिज-अहमदाबाद में कल्याण समाज में। 4. जमालपुर में टोकरशाह नी पोल में। 5. साबरमती में। 6. वड़ोदरा में देरापोल में। 7. सूरत में माली फालिया, कायस्थ मोहल्ला, नानपारा, वड़चौता और गोलेश्वरी में। सूरत के नागरसेठ नी पोल में वडाचौता के मंदिर के पीछे एक कहानी है: वि.सं.1062 में सेठ दहियाभाई ने मोरवाड़ा में श्री गोडी जी पार्श्वनाथ मंदिर के लिए एक छःरिपालित संघ निकाला। उसकी पत्नी बीमारी के कारण संघ में जाने में असमर्थ थी, जो उसके लिए बहुत निराशाजनक था क्योंकि उसे संघ में शामिल होने की तीव्र इच्छा थी। वह अपनी बुरी किस्मत के लिए खुद की निंदा कर रही थी। एक चमत्कार हुआ - जब भगवान के अधिष्ठायक देवता की कृपा से संघ मोरवाड़ा पहुंचा, सेठानी के सामने भगवान गोडीजी पार्श्वनाथ की मूर्ति दिखाई दी। बड़ी भक्ति और प्रसन्नता के साथ पूजा करते हुए सेठानी ने अपने गले से सोने का हार निकालकर भगवान को सुशोभित किया। मूर्ति मोरवाड़ा में सेठानी के सोने के हार के साथ दिखाई दी। सेठ ने भगवान के गले में अपनी पत्नी के हार को देखकर चकित रह गया, क्योंकि उसने स्वयं ऐसा नहीं किया था। सेठ को मूर्ति की प्रभावशाली और चमत्कारी शक्ति का एहसास हुआ, इसलिए उन्होंने एक मंदिर बनाने का फैसला किया। इसी घटना की याद में सूरत में भगवान गोडीजी पार्श्वनाथ मंदिर का निर्माण किया गया।. 8. अलीपुर, गन्देवी, थराड, राधनपुर (गोडीजी शेरी), पाटन, मुजपुर (सलिवडा), तथा गुजरात में विजापुर, इडर, जामनगर, भावनगर, कच्छ, मोरबी, पालीताना आदि स्थानों पर भी मंदिर हैं। 9. मुंबई में पायधुनी, पटवा चायल और नारायण दाभोलकर सड़क पर, तथा पुणे शहर (महाराष्ट्र) में। 10. राजस्थान में जैसलमेर, फलोदी, पाली, जालौर, आहोर, कोसाना, बीकानेर, अजमेर, सोजत शहर, सिवाना, नदलाई, पिंडवाड़ा, धनेराव, सिरोही आदि। आहोर और गोहिली में एक सुंदर 52 जिनालय मंदिर है, जिसमें मूलनायक भगवान के रूप में भगवान गोडीजी पार्श्वनाथ विराजमान हैं। उदयपुर में मालदास नी शेरी में भी मंदिर है। 11. मध्य प्रदेश के मालवा, बालापुर और मलकापुर (तलनपुर के जंगल) में। 12. उत्तर भारत के वाराणसी, आगरा और अजीमगंज में। 13. हैदराबाद में कोठी और बेगम बाज़ार तथा परभणी में। 14. कर्नाटक के चित्रदुर्ग में स्थित भगवानजी पार्श्वनाथ की मूर्ति 1,200 वर्ष पुरानी है। यह मूर्ति कई सालों तक एक घर के मंदिर में रही, बाद में एक सुंदर मंदिर का निर्माण किया गया और मूर्ति को आचार्य श्री स्तुलभद्रसूरीश्वरजी के पूज्य हाथों से भगवान गोड़ीजी पार्श्वनाथ के रूप में स्थापित किया गया, वि.सं.2046 में वैशाख महीने के शुक्ल पक्ष के तीसरे दिन। यहाँ 250 जैन परिवार रहते हैं तथा एक पाठशाला, उपाश्रय और आयंबिलशाला है। श्री भगवान पार्श्वनाथ जैन श्वेतांबर संघ, जैन मंदिर मार्ग, चित्रदुर्ग-577501, फोन: 08194-220195।. 15. कई स्थानों पर मंदिर में श्री भगवान गोड़ीजी पार्श्वनाथ के चरण पादुका रखे जाते हैं - राधनपुर, मोरवाड़ा, सुगम और थारा में। पास में एक नदी के तट पर श्री गोडी जी पार्श्वनाथ की एक वरखड़ी है जिसे \\\"वर्खदी\\\" के रूप में जाना जाता है।. स्तुति: मुंबई नगरनी रिद्धिने समृद्धिना जे मूल छें, मुझ आत्मानी सिद्धि काजे जे प्रभु अनुकूल छे, तुझ मिलननी आशा मही मन माहरू व्याकुल छे। श्री गोडीजी पार्श्व ने भावे करूं हुं वंदना. जाप मंत्र: ॐ ह्री अर्हम् श्री गोडीजी पार्श्वनाथय नमः. ट्रस्ट: श्री गोडीजी पार्श्वनाथ श्वेताम्बर जैन तीर्थ पेढ़ी, विजय वल्लभ चौक, पायधुनी, मुंबई-400004, राज्य: महाराष्ट्र, भारत। फोन: 022-234163156. इसके साथ ही पुस्तक में 108 पार्श्वनाथ प्रभुओं के नामों की एक सूची चार भागों में दी गई है, जिसमें मनमोहन, मनोरंजन, मनोवांछित, नागेश्वर, नवपल्लव, नवखंड, अजहरा, अमीझरा, अंतरिक्ष, वामनन्दन अश्वसेनसुत चिंतामणि, शंखेश्वर, विघ्नहराय गोडीजी (भाग 1); जिरावला, जगवल्लभ, संकटहरण, भीडभंजन, भयभंजन, कामितपुराण, सम्मेतशिखर, भद्रेश्वर, सुखसागर, रणकपुरा, कल्पद्रुम, आशापुराण, विजय चिंतामणि, भुवन, दादा, वही