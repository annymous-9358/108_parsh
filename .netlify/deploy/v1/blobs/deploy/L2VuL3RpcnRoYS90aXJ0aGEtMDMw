sjeqv85.js\\\"],\\\"Image\\\"]\\n23:T1e77,\"])</script><script>self.__next_f.push([1,\"Shri Vighnapahar Parshvanath. 108 पार्श्वनाथ में से 26 - श्री विघ्नापहार पार्श्वनाथ। पोस्ट-मोटा पोसिना, ता-खेडब्रह्मा, जिला-साबरकांठा, गुजरात।. मूलनायक: सफेद रंग की पद्मासन मुद्रा में लगभग 68 सेंटीमीटर ऊँची मूर्ति भगवान श्रीविघ्नापहार पार्श्वनाथ की है।. तीर्थ: यह खेड़ब्रह्म तालुका के गाँव मोटा पोसिना में है।. ऐतिहासिकता: यह एक प्राचीन शहर है और मंदिर विक्रम संवत 15वीं शताब्दी का है। आचार्य सोमसुंदरसूरीश्वरजी जैन धर्म के एक महान ज्योतिषाचार्य थे। श्रेष्ठी गोपाल ने आचार्य सोमसुंदरसूरीश्वरजी के आध्यात्मिक प्रवचनों को सुनकर मोटा पोसिना के अपने पैतृक गांव में मंदिर निर्माण करने का निश्चय किया। जब सुंदर मंदिर का निर्माण हुआ, तो वि.सं.1477 में आचार्य श्री सोमसुंदरसूरीश्वरजी के श्रद्धेय के हस्त से शुभ मुहूर्त पर उनकी पत्नी और बेटी को मंदिर में भगवान पार्श्वनाथ की मूर्ति को स्थापित किया गया।. जब स्थापना समारोह किया गया था, तब एक आपदा हुई। अचानक आग लग गई और लोगों में डर हो गया कि मंदिर नष्ट हो जाएगा। इसके बजाय एक चमत्कार हुआ - जो आग अचानक प्रज्वलित हो गई थी, वह बिना किसी नुकसान के बुझ गई। इसे देखकर सभी हैरान रह गए और इस चमत्कार को देखकर लोगों के मुंह से निकला नाम \\\"विघ्नापहार पार्श्वनाथ\\\", और इसलिए इस पार्श्वनाथ को विघ्नापहार पार्श्वनाथ के नाम से जाना जाने लगा। दूसरा नाम विघ्नापहार पार्श्वनाथ के लिए विघ्नहारा पार्श्वनाथ है। वी.स.1481 में एक और छोटा मंदिर श्रेष्ठी मदन द्वारा इस मंदिर के परिसर में बनाया गया था। वि.स.1491 में श्रेष्ठी अर्जुन को आचार्य सोमसुंदरसूरीश्वरजी के पूज्य हाथों से स्थापित भगवान आदिनाथ की एक मूर्ति मिली थी जो यहाँ स्थापित है।. यहाँ ध्वजा जेठ के महीने के शुक्ल पक्ष के 11वें दिन इस मंदिर में फहराई जाती है।. अन्य मंदिर: यहां 4 अन्य मंदिर हैं। शांतिनाथ भगवान के मंदिर में वि.सं.1281 मूर्ति पर लिखा है। नेमिनाथ मंदिर में वि.सं.1888 मूर्ति पर लिखा है। क्षेत्रपालजी में महावीर स्वामी का मंदिर बहुत चमत्कारी है। इससे इन मंदिरों की प्राचीनता का पता चलता है। इन सभी 5 मंदिरों का जीर्णोद्धार आचार्य श्री विजयदेवसूरिजी द्वारा 17वीं शताब्दी में कराया गया।. कला और मूर्तिकला के कार्य: यह