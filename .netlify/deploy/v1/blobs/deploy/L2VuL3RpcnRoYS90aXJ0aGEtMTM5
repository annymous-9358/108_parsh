kpjc789k8m.js\\\"],\\\"SpeakButton\\\"]\\n22:I[5500,[\\\"/_next/static/chunks/3vsl20q6wdw12.js\\\",\\\"/_next/static/chunks/0abm728svpw4d.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/2nzzixgj4wils.js\\\",\\\"/_next/static/chunks/0taliq9wft957.js\\\",\\\"/_next/static/chunks/3ppkpjc789k8m.js\\\"],\\\"Image\\\"]\\n21:T17b7,\"])</script><script>self.__next_f.push([1,\"Shri Ratna Chintamani Parshwanath. 108 Parshwanath, No. 112 – Shri Ratna Chintamani Parshwanath.. Main Deity: An image of Shri Ratna Chintamani Parshwanath, in the padmasana posture, made of five metals (panchdhatu), seated within a beautiful parikar.. Location: In Manek Chowk, Khambhat, to the right of the Shri Chintamani Parshwanath Bavan Jinalaya (52-shrine temple complex), stands the household shrine (griha jinalaya) of Lord Ratna Chintamani Parshwanath, in a lane (pol).. History: Bahenkor Bahen, wife of Seth Shri Somchandbhai Popatlal of Khambhat, had her maternal home in Manek Chowk and her marital home in Mandvi ni Pol, where her husband's family had built a household shrine (griha jinalaya) with Shri Ratna Chintamani Parshwanath enshrined as the Main Deity. Being the only child of her maternal family, she came to live in Manek Chowk and had a household temple (ghar derasar) built there, installing her marital family's Shri Ratna Chintamani Parshwanath as the Main Deity of this new household shrine. This jinalaya was consecrated on Saturday, the 10th day of the bright half of Magsar, Vikram Samvat 2001, by the blessed hands of the revered head of the Tapagachchha order, Acharya Shri Vijaynemsurishwarji Maharaj. An inscription relating to this consecration is engraved on the inner wall of the jinalaya's main entrance. On the pedestal of the Main Deity can be read the words: \\\"Samvat 1681, Falgun Sud 10... Shri Ratna Parshwanath bimb pratishthapi sushravakena Sa. Shri Tejpalena pratishthitam\\\" (\\\"The image of Shri Ratna Parshwanath was consecrated by the devout shravaka Sa. Shri Tejpal\\\"), and the parikar also bears the mention of Samvat 2004. In addition, a small inscription was found on a separate stone, reading \\\"Samvat 1661, Vaishakh Sud 7, Som Vanik Tejpal along with Vijaysensuri,\\\" though the inscription is too worn to be read in full. In the \\\"Jain Tirth Sarva Sangraha,\\\" published in Samvat 2010, this jinalaya is listed as a household shrine, mentioning at that time four metal images and one image of Shani (Saturn), which still exist today. This household shrine dates from Samvat 2001, and it is possible that the original consecration in Mandvi ni Pol took place in Samvat 1661 by the blessed hands of the revered Shri Vijaysensuriji — though this remains a matter for further research.. Art and Sculpture: The jinalaya stands as a separate structure rather than within a house, comprising both a gambhara (sanctum) and a rangmandap (assembly hall). Above the sanctum's inner doorway, stone panels have been carved on the wall depicting replicas of Shri Girnarji, Shatrunjay, and Sammet Shikhar, which look very striking with their use of golden pigment in the coloured work.. Other Temples: At present, alongside the Main Deity Shri Ratna Chintamani Parshwanath, the household shrine also houses crystal images of Shri Chandraprabhu Swami and Shri Munisuvrata Swami, as well as images of Shri Adinath, Shri Shantinath, Lord Parshwanath, Shri Padmavati Mata, Shri Siddhachakra Gattaji, and an exquisite panel depicting 170 Jineshwaras. Around this jinalaya are seven other jinalayas — those of Shri Adeshwar, two of Shri Chintamani Parshwanath, Shri Shantinathji, Shri Vasupujya Swami, Shri Dharmanath, and Shri Mahavir Swami.. Directions: Khambhat is a very popular port city of Gujarat, well connected by rail and road to other cities. This temple is 1.5 km from the railway station. Dharamshala and bhojanshala facilities, as well as jnanabhandars holding many ancient books and scriptures, are available here.. Hymn of Praise: Beholding your wondrous image, my eyes find peace; I have come to you to claim the kingdom of liberation; I have accepted you as my mother and father — fulfil my heartfelt wish and carry me across. \\\"With loving devotion I bow in reverence to Shri Ratna Chintamani Lord Parshwa.\\\". Chanting Mantra: \\\"Om Hreem Arham, Shri Ratna Chintamani Parshwanathaya Namah\\\". Shrine Address: Shri Ratna Chintamani Parshwanath Shwetambar Jain Tirth, Manek Chowk, Mu.Po. Khambhat, Dist. Kheda, via Anand (Gujarat) 388620. Phone Number – 02698226006. Contacts: 1. Shri Tejasbhai – Khambhat 9898536939, 2. Shri Girishbhai – Mumbai 09320362702.. The Life of the Reverend (Purushdaniya) Arhat Parshwanath, Part 18 (Nirvana and the Site): After his life as a householder, taking diksha, and remaining for 83 days and nights in the state prior to omniscience (chhadmastha), he attained omniscience (kevalgyan) and, living as an omniscient ascetic (kevali) for 70 years, observing the life of a shraman, the Reverend Arhat Parshwanath lived out his full lifespan of one hundred years. When his karmas of feeling (vedaniya), lifespan (dirghayu), name (nama), and lineage (gotra) were exhausted, in the fourth ara (dushama-sushama) of the descending half-cycle of time (avasarpini kal), in the first month of the rainy season, in its second fortnight — that is, on the eighth day of the bright half of the month of Shravan — on Mount Sammet Shikhar, together with thirty-four persons (Parshwanath himself and 33 other monks), after a month-long fast upon the mountain, observing a waterless fast (chovihar), as morning came and the conjunction of the Vishakha constellation arrived, he remained fixed in the posture of kayotsarga meditation and, attaining the state beyond karma (kaldharma), achieved liberation (moksha) — thus becoming free from all suffering. ...The End.. Compiled by: Rajendra Kumar Jain, Parshwa Sadan, Parshwa Nagar, Dungarpur, Rajasthan. Rkjainasp – 8107105235.. Please forward this PDF book on WhatsApp and save it on your mobile device, so that whenever you travel to that region for pilgrimage, you can open Google Maps to find information about the nearby shrine of Lord Parshwanath and travel with ease.. If, in the compilation of this book, anything has been written against scripture or dharma — whether through a stray mark, diacritic, or otherwise — I seek forgiveness in thought, word, and deed (Michhami Dukkadam).. Jai Jinendra from Rajendra Kumar Jain and family.\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/2NXZgoguJqwdegy2A\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1a\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:props:children:1:props:children:0:props:iconNode\\\",\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"Open in Google Maps\\\"]}],null,[\\\"$\\\",\\\"$L20\\\",null,{\\\"text\\\":\\\"$21\\\",\\\"lang\\\":\\\"en\\\",\\\"label\\\":\\\"Listen\\\",\\\"stopLabel\\\":\\\"Stop\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-10 grid grid-cols-2 gap-2 sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"f68b977f-86fc-4e80-b7d6-32c7135b7335\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 col-span-2 aspect-[4/3] sm:col-span-2\\\",\\\"children\\\":[\\\"$\\\",\\\"$L22\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_16406.jpeg\\\",\\\"alt\\\":\\\"Shri Ratna Chintamani Parshwanath फोटो 1\\\",\\\"fill\\\":true,\\\"siz