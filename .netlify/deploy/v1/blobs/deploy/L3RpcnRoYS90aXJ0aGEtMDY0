blic%2Ftirtha-images%2Fimg_10288.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10288.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10288.jpeg&amp;w=3840&amp;q=75\"/></div><div class=\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\"><img alt=\"श्री घीया पार्श्वनाथ फोटो 2\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(min-width: 640px) 33vw, 50vw\" srcSet=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10290.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 46 - श्री घीया पार्श्वनाथ।</p><p>स्थान: घिया नो पाडो, पोस्ट-पाटन, जिला-पाटन। वर्तमान में यह प्रतिमाजी भुवनभानु मानसा मंदिर आसन गॉव शाहपुर मुम्बई में ले जाकर स्थापित की गई है।</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में लगभग 27 इंच ऊंची एवं 23 इंच चौड़ी भगवान श्री घीया पार्श्वनाथ की मूर्ति है।</p><p>तीर्थ: यह गुजरात के पाटन के घीया नो पाड़ो (बस्ती) में है।</p><p>ऐतिहासिकता: सदियों से पाटन जो कि गुजरात का एक प्राचीन शहर है, अपने सामाजिक, धार्मिक और सांस्कृतिक कार्यक्रम के लिए प्रसिद्ध था। &#x27;घीया पार्श्वनाथ&#x27; के नाम के पीछे एक कहानी है। एक व्यापारी जो घी का व्यापार करता था वह व्यक्ति भगवान पार्श्वनाथ का बडा भक्त था और रोजाना वह विश्वास और श्रद्धा से पार्श्वनाथ भगवान की पूजा करता था। उसकी महान भक्ति और विश्वास के कारण उन्होंने बहुत पैसा कमाया। उन्होंने एक सुंदर और भव्य मंदिर का निर्माण किया और इसमें भगवान पार्श्वनाथ की मूर्ति स्थापित की गई। इस घी व्यवसायी के बाद पार्श्वनाथ को &#x27;श्री घीया पार्श्वनाथ&#x27; कहा जाने लगा। इस पार्श्वनाथ को लोकप्रिय रूप से &#x27;कम्बोई पार्श्वनाथ&#x27; के नाम से भी जाना जाता है।</p><p>अन्य मंदिर: पाटन में घिया ना पाडा में 2 मंदिर हैं। एक मंदिर में मुलनायक घीया पार्श्वनाथ और दूसरे मंदिर में मूलनायक शांतिनाथ भगवान हैं।</p><p>दिशानिर्देश: यह प्राचीन शहर पाटन गुजरात के सभी शहरों के लिए रेल और सड़क मार्ग से अच्छी तरह से जुड़ा हुआ है।</p><p>शास्त्र: श्री घीयापार्श्वनाथ का उल्लेख &#x27;पाटन चैत्यपारीपाटी&#x27;, &#x27;365 श्री पार्श्वजिन नाममाला&#x27; में किया गया है। &#x27;108 नामगर्भित श्री पार्श्वनाथ स्तवन&#x27; में, &#x27;पाटन जिनालय स्तुति&#x27; आदि में किया गया है। जीरावाला तीर्थ में घिया पार्श्वनाथ की मूर्ति है।</p><p>स्तुति: अणहील पतने शोभता कंबोइना प्रभु पारसजी, घयतवणिजना दुःख दुरित दर्दों आपे कीधा नाशजी, संसार दुःखे दुःखीयो छुं आपने कहुं खासजी। &#x27;श्री घीया पार्श्व ने भावे करूँ हूं वंदना&#x27;।</p><p>जाप मंत्र: &#x27;ॐ ही अर्हं श्री घीया पार्श्वनाथय नमः&#x27;</p><p>ट्रस्ट: श्री काम्बोइया (घिया) पार्श्वनाथ श्वेतांबर जैन मंदिर, घिया नो पाडो, पोस्ट- पाटन 384 265, जिला: मेहसाणा, राज्य: गुजरात, भारत।</p><p>पुरुषादानीय अर्हत पार्श्वनाथ चरित्र भाग 6 (पार्श्व को माता के पास से मेरुशिखर पर ले जाते इंद्र): भगवान के जन्म होते ही शकेंद्र का सिंहासन कम्पायमा होने लगा। उन्होंने अवधि ज्ञान से भगवान का जन्म जानकर समस्त देवी देवताओं के परिवार के साथ वाराणसी नगरी आए, साथ में भवनपति, वाणव्यंत, ज्योतिष्क और वैमानिक देवनिकाय के इंद्र और देवतागण भी आए। उन्होंने भगवान और माता वामादेवी का तीन बार प्रदक्षिणा कर वंदन किया। माता को अवस्वापिनी निंद्रा देकर भगवान का प्रतिबिंब रखकर भगवान को मेरू शिखर पर ले गए। भगवान का अभिषेक करने हेतु समस्त देव देवियां क्षीरसागर से जल भर कर लाती हैं तथा भगवान का अभिषेक कर दूसरे मंगला लेखन कर पुष्प वृष्टि, धूप, दिप, आरती, गीत नृत्य रंग आदि कर्म करने के पश्चात वापस भगवान को माता की गोद में सौंप दिया। नंदीश्वर द्वीप में अष्टान्हिका महोत्सव कर सब वापस स्वस्थान पर चले गए।</p><p>108 पार्श्वनाथदादा का इतिहास एवं किस प्रकार पहुंचना... भाग-12: नवसारी, सुरत, रादेर के 4 एवं भरूच, गंधार के 2, डभोइ व छाणी, बोरसद के 4, खंभात के 4, खेडा व धोलका के 2, अहमदाबाद के 4, नरोडा, टीटोंई, मोदर, बडोदा के 4, नाना पोसीना के 1, मोटा पोसीना के 1 एवं विजापुर के 1, विहार, विसनगर, मेहसाणा, सिद्धपुर, धोता सकलाणा, पालनपुर, भिलडियाजी, उंबरी, चारूप के एक-एक एवं पाटन के 9 व मानसा मंदिर मुम्बई के 1 - कुल 46 पार्श्वनाथ प्रभु के तीर्थों की यात्रा करने के पश्चात, आगे हम गांभु, चणास्मा, कंभोई, मुंजपुर, शंखेश्वर के एक-एक कुल 5 पार्श्वनाथ प्रभु के तीर्थ की यात्रा करेंगे। पाटन से गांभु 36 किमी, गांभु से चणास्मा 17 किमी, चणास्मा से कंभोई 12 किमी, कंभोई से मुंजपुर 28 किमी, मुंजपुर से शंखेष्वर 12 किमी। गांभु में 47. श्री गंभीरा पार्श्वनाथ, चणास्मा में 48. श्री भटेवा पार्श्वनाथ, कंभोई में 49. श्री मनमोहन पार्श्वनाथ, मुंजपुर में 50. श्री जोटींगडा पार्श्वनाथ, शंखेश्वर में 51. श्री शंखेष्वर पार्श्वनाथ हैं।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-063\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री धींगडमल (श्यामला) पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/tirtha/tirtha-065\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री गंभीरा पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>मूल स्रोत: राजेन्द्र कुमार जैन, पार्श्व सदन, पार्श्व नगर, डूंगरपुर</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/2jtg_pfs3s_5g.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><scri