"],\\\"Image\\\"]\\n23:T3181,\"])</script><script>self.__next_f.push([1,\"श्री मक्षी पार्श्वनाथ. 98. श्रीमक्षी पार्श्वनाथ. मूलनायक: काले रंग की पद्मासन मुद्रा में 35 इंच ऊंची व 31 इंच चौड़ी भगवान श्री मक्षी पार्श्वनाथ की मूर्ति है। मूर्ति के सिर के ऊपर 7 नाग फणों की छतरी है।. तीर्थ: यह मक्सी गांव में एक सुंदर झील के किनारे है।. ऐतिहासिकता: यह एक प्राचीन मूर्ति है जिसे 2,500 वर्ष से अधिक पुराना माना जाता है। श्रेष्ठी संग्राम सोनी, जो वडियार प्रांत के लोलदा गाँव के मूल निवासी थे, एक बहुत ही धार्मिक श्रावक थे। व्यावसायिक उद्देश्यों के लिए वह मांडवगढ़ में बस गए और बहुत समृद्ध हो गए। बादशाह ग़यासुद्दीन ने उन्हें अपना मंत्री नियुक्त किया। जैन धर्म उस समय बहुत लोकप्रिय था, यहाँ बड़ी संख्या में जैन परिवार रहते थे। संग्राम सोनी ने 17 जैन मंदिरों का निर्माण कराया। उन्होंने मक्सी गाँव में आसपास के 52 छोटे मंदिरों के साथ एक सुंदर और आकर्षक जैन मंदिर का भी निर्माण कराया और भगवान पार्श्वनाथ की इस मूर्ति को आचार्य श्री श्रीसुन्दरसूरीश्वरजी के पूज्य हाथों से वि.सं. 1472 में औपचारिक रूप से प्रतिष्ठित किया गया। जब मोहम्मद गजनी ने यहाँ आक्रमण कर इस मंदिर को तबाह करने की कोशिश की, वह गंभीर रूप से बीमार पड़ गया और उसे अलौकिक शक्तियों के अनुभव होने लगे, इसलिए उसने अपनी सेना को न केवल पीछे हटने का निर्देश दिया, बल्कि मंदिर और मूर्ति को बिना किसी हानि पहुचाए छोड़ दिया। पश्चाताप के एक टोकन के रूप में उसने मंदिर के प्रवेश द्वार पर पांच लघु बुर्ज बनवाए। यह एक बहुत ही चमत्कारी मूर्ति है जिसमें अभी भी चमत्कार होते रहते हैं। एक बार मूर्ति के सिर पर फणों से दूध की धारा बहने लगी, जिसके बाद मंदिर का गर्भगृह दूध से भर गया, और उपस्थित भक्तों ने इस चमत्कारी दृश्य को देखकर खुद को भाग्यशाली माना। कुछ साल पहले इस मंदिर का जीर्णोद्धार किया गया था।. कला और मूर्तिकला के कार्य: पार्श्वनाथ की मूर्ति बहुत प्राचीन, शानदार, सुंदर और चमत्कारी है। मूर्ति की कला हमेशा तीर्थयात्रियों के लिए आकर्षण का केंद्र बनी हुई है। मंदिर पर की गई नक्काशी बहुत कलात्मक है।. दिशानिर्देश: मंदिर मक्सी के रेलवे स्टेशन से 1.5 किलोमीटर दूर है। मक्सी गाँव मुंबई-आगरा रोड पर उज्जैन से 40 किलोमीटर और इंदौर से 70 किलोमीटर दूर है। मंदिर तक एक पक्की रोड है। बस और निजी वाहन सेवा उपलब्ध है। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं। मुख्य मंदिर में सुबह 6 से 9 बजे तक दिगम्बर समाज के लिए पुजा का समय है तथा 9 बजे के पश्चात पूरा दिन श्वेतांबर समाज के लिए पुजा-पाठ हेतु है।. शास्त्र: \\\"वीर वंशावली\\\" में उल्लेख है कि यह मंदिर संग्राम सोनी द्वारा बनवाया गया था। जगतगुरु हिरविजयसुरिश्वरजी के शिष्य ने मक्सी पार्श्वनाथ पर \\\"स्तोत्र\\\" लिखा है। इसका उल्लेख \\\"श्री शंखेश्वर पार्श्वनाथ छंद\\\", \\\"365 श्रीपार्श्वजीन नाममाला\\\", \\\"108 नाम गर्भित श्री गोडी जी पार्श्वनाथ स्तवन\\\", \\\"श्री पार्श्वनाथ चैत्यपारीपाटी\\\", \\\"तीर्थमाला\\\", \\\"मक्सी मण्डन श्री पार्श्वनाथ स्तवन\\\" आदि में मिलता है। माक्षी पार्श्वनाथ की एक मूर्ति श्री करेडा तीर्थ में, जीरावला तीर्थ में और संतराक्रूज़, मुंबई के कलिकुंड पार्श्वनाथ मंदिर में भी है।. स्तुति: छत्र स्वरूप तुझ फेणामाथी दूध धार वहेती दुधनी, परचो बतावयो गिजनीने अरजी सुनो आ मुगतवी, हे मक्षी पारस मोक्ष देजो रक्षी-रक्षी मोहथी। मक्षी पार्श्व ने भावे करूं हूं वंदना।. जाप मंत्र: \\\"ॐ ह्री अर्हम् श्री मक्षी पार्श्वनाथय नमः\\\". ट्रस्ट: श्री मक्षी पार्श्वनाथ श्वेतांबर जैन मंदिर, श्री आनंदजी कल्याणजी पेढ़ी, पोस्ट: मक्सी-465106, जिला: शाजापुर, राज्य: मध्य प्रदेश, भारत। फोन: 07363-232028, 07363-232214, 07363-232037।. श्री १०८ पार्श्वनाथ स्तुति: केवा मजानां \\\"दोकड़ीयां\\\" दुःखड़ा, सुखड़ा करे, दिल चोरनार \\\"चोरवालडी\\\", दोष ने दुर्गुण हरे, मूर्छित बनेली भावना \\\"नवपल्लवित\\\" प्रभुजी! करो, \\\"शंखेश्वरा\\\" प्रभु! विनवुं रक्षा करो! रक्षा करो!!. 108 पार्श्वनाथदादा का इतिहास एवं किस प्रकार पहुंचना... भाग-20: इसके साथ ही यहॉ अब तक 108 पार्श्वनाथ में से गुजरात, राजस्थान, मध्यप्रदेष एवं उत्तरप्रदेष के कुल 98 पार्श्वनाथ प्रभु की यात्रा पूर्ण होती है। आगे हम उत्तरप्रदेष में बाकी रहे एक एवं झारखंड में आने वाले एक मात्र पार्श्वनाथ की यात्रा करेंगे। सर्वप्रथम वाराणसी जाना है, इसके लिये अहमदाबाद से गोरखपुर एक्सप्रेस 19489 उपलब्ध है, वाराणसी स्टेशन पर उतरना होगा। वाराणसी से भेलपुर की दूरी 03 किमी है। दर्शन-सेवा-पूजा करने के बाद वाराणसी से सम्मेदशिखर जाने हेतु 13308 गंगा सतलज ऐक्सप्रेस से पारस स्टेशन पर उतरना होगा। पारस स्टेशन से मधुबन की दूरी 24 किमी है।. वाराणसी: 99. श्री वाराणसी पार्श्वनाथ। मधुबन: 100. श्री सम्मेतषिखर पार्श्वनाथ।. पुरुषदानीय अर्हत पार्श्वनाथ चरित्र भाग-16 (भगवान पार्श्वनाथ द्वारा तीर्थ और गणधर की स्थापना): भगवान पार्श्वनाथ द्वारा तीर्थ एवं गणधर की स्थापना की जाती है। पुरुषदानीय अर्हत पार्श्व के आठ गण एवं दस गणधर हैं - (1) शुंभ (2) अज्जघोष (आर्यघोष) (3) वशिष्ठ (4) ब्रह्मचारी (5) सोम (6) श्रीधर (7) वीरभद्र और (8) यश। पुरुषदानीय अर्हत पार्श्व के संघ में अज्जदीण (आर्यदत्त) आदि सोलह हजार साधुओं की उत्कृष्ट श्रमण संपदा थी। समुदाय में पुष्पाचुला आदि जैसे अडतालीस हजार साध्वियों की उत्कृष्ट संपदा थी। सुनंदा आदि एक लाख चौंसठ हजार श्रमणोपासक (श्रावक) की उत्कृष्ट संपदा थी और तीन लाख सत्ताईस हजार श्रमणोपासिकाओं (श्राविकाओं) की उत्कृष्ट संपदा थी। साढ़े तीन सौ चौदह-पूर्वधारियों की संपदा थी, एक हजार केवलज्ञानियों की संपदा थी, ग्यारह सौ वैक्रिय लब्धिवालों तथा ऋजुमति ज्ञानवालों की संपदा थी। भगवान पार्श्वनाथ एक हजार श्रमणों एवं दो हजार श्रमणियों के साथ सिद्ध हुए थे। संघ में साढ़े सात सौ विपुलमति (मनःपर्यव ज्ञानवाले), छ सौ वादी, और बारह सौ अनुत्तरोपपातिक (अनुत्तर विमान में जानेवाले) की संपदा थी।\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/XoUC2KFGq8nUBo6X8\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-sm bg-maroon px-5 py-2.5 font-ui text-sm font-medium text-ivory hover:bg-maroon-deep transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":\\\"$8:2:props:children:props:children:1:props:children:0:props:iconNode\\\",\\\"className\\\":\\\"lucide-map-pin h-4 w-4\\\",\\\"aria-hidden\\\":true}],\\\"Google Maps पर देखें\\\"]}],null,[\\\"$\\\",\\\"$L22\\\",null,{\\\"text\\\":\\\"$23\\\",\\\"lang\\\":\\\"hi\\\",\\\"label\\\":\\\"सु