%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_12667.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>71. श्री भयभंजन पार्श्वनाथ</p><p>पोस्ट- भीनमाल, जिला- जालोर (राजस्थान)।</p><p>मूलनायक: सोने के रंग की पद्मासन मुद्रा में पांच धातुओं की बनी 12.5 इंच ऊंची व 15 इंच चौड़ी फणा रहित भगवान श्रीभयभंजन पार्श्वनाथ की मूर्ति है।</p><p>तीर्थ: यह भीनमाल शहर में है।</p><p>ऐतिहासिकता: प्राचीन गुजरात राज्य का मुख्य नगर यह भीनमाल एक समय खूब प्रसिद्ध था। यह नगर किसने बसाया था, उसका निश्चित इतिहास उपलब्ध नहीं है। पौराणिक कथाओं के अनुसार इसका नाम सतयुग में श्रीमाल, त्रेतायुग में रत्नमाल, द्वापरयुग में पुष्पमाल व कलियुग में भीनमाल रहा। श्रीमाल व भीनमाल नाम लोकप्रसिद्ध रहे। इस नगरी का अनेक बार उत्थान-पतन हुआ। एक जैन मंदिर के खण्डहर में वि.सं.1333 का शिलालेख मिला है, जिसमें बताया गया है कि श्री महावीर भगवान यहाँ विचरे थे। विक्रम की पहली शताब्दी में आचार्य श्री वज्रस्वामी के भी श्रीमाल (भीनमाल) की तरफ विहार करने के उल्लेख मिलते हैं। एक जैन पट्टावली के अनुसार वीर निर्वाण सं.70 के आसपास श्री रत्नप्रभसूरिजी के समय श्रीमाल नगर के राजकुमार श्री सुन्दर व मंत्री श्री उहड़ ने यहाँ से जाकर ओसियां बसाया था, जिसमें श्रीमाल से अनेक कुटुम्ब जाकर बसे थे। एक और मतानुसार श्रीमाल के राजा देशल ने जब धनाढ्यों को किले में बसने की अनुमति दी, तब अन्य लोग असंतुष्ट होकर देशल के पुत्र जयचन्द्र के साथ वि.सं.223 में ओसियाँ जाकर बसे थे। किसी जमाने में इस नगरी का घेराव 64 कि.मी. था। किले के 84 दरवाजे थे, उनमें 84 करोड़पति श्रावकों के, 64 श्रीमाल ब्राह्मणों के व 8 प्रगवट ब्राह्मणों के घर थे। सैकड़ों शिखरबंध मंदिरों से यह नगरी रमणीय बनी हुई थी। श्री जिनदासगणी द्वारा वि.सं.733 में रचित &quot;निशीथचुर्नी&quot; में सातवीं-आठवीं शताब्दी पूर्व से यह नगर खूब समृद्धिशाली रहने का उल्लेख है। सातवीं शताब्दी से दसवीं शताब्दी तक प्रायः सारे प्रभावशाली आचार्य भगवन्तों ने यहाँ पदार्पण करके इस शहर को पवित्र व रमणीय बनाया है, व अनेक अनमोल जैन साहित्यों की रचना करके अमूल्य सामग्री विश्व को नयी प्रेरणा दे रहा है।</p><p>पौराणिक कथाओं में भी इस नगरी को भारी महत्त्व दिया गया है। भगवान श्री महावीर यहाँ विचरे थे, ऐसा उल्लेख मिलता है। पहली शताब्दी में आचार्य श्री वज्र स्वामी यहाँ दर्शनार्थ पधारे थे। श्री उहड़ मंत्री व राजकुमार सुन्दर ने यहीं से जाकर ओसियाँ नगरी बसायी थी। &quot;शिशुपालवध महाकाव्य&quot; के रचयिता कवि श्री माघ की जन्मभूमि यही है। सं.992 में सिद्धशिर गणी ने &quot;उपमिति भव प्रपंचा कथा&quot; का सर्जन यहीं पर किया था। विमलशा मंत्री के पूर्वज यहीं पर रहते थे। श्रीमाली वंश की उत्पत्ति यहीं हुई थी।</p><p>इस शहर ने कई उन्नति और अवनति देखी है। एक धनवान व्यवसायी ने एक सुंदर और विशाल मंदिर का निर्माण किया और भगवान पार्श्वनाथ की पांच धातुओं वाली मूर्ति स्थापित की। मुस्लिम आक्रमण के भय के कारण इस मूर्ति को छिपा कर रखा गया था। विक्रम संवत 1651 में जब मंदिर स्थल में खुदाई की गई थी, यह मूर्ति लोगों को एक समवसरण और कई अन्य मूर्तियों के साथ मिली थी। पार्श्वनाथ की इस मूर्ति को तब भगवान शांतिनाथ के मंदिर में धूमधाम और महिमा के साथ स्थापित किया गया था।</p><p>भीनमाल के सूबेदार को प्रतिमाजी प्रगट होने की बात का पता चला। उस समय जालोर में गजनीखान का राज्य था, सूबेदार ने गजनीखान को यह बात कही। राजा ने उस प्रतिमा को तोड़कर घंट बनाने का निश्चय किया, उसने वह प्रतिमाजी अपने पास मंगवा ली। इससे समग्र जैन संघ चिंतातुर बना। लोगों ने राजा को समझाने की कोशिश की, राजा टस से मास न हुआ। श्रद्धासंपन्न श्रावकों ने अनेक प्रकार के अभिग्रह किए, वीरचंद क्षेष्ठि ने अन्न त्याग का अभिग्रह किया। श्रेष्ठी की दृढ़ता से अधिष्ठायक देव प्रगट हुए। परंतु सत्ता के नशे में चकचुर गाजिखान प्रतिमा देने के लिए तैयार नहीं हुआ। उसने सोनी को बुलाकर मूर्ति में से अपनी पत्नी के लिए नवसेरा हार व घोड़े के गले के घुंघरू बनाने का आदेश दे दिया।</p><p>राजा के उपदेश से सोनी ने जैसे ही प्रतिमा तोड़ने का प्रयास किया, उसी समय सैकड़ों भौंरों के गुंजन से वातावरण भयजनक बन गया। आकाश में भयंकर बादल छा गए। सैन्य पर अदृश्य प्रहार होने लगे। हाथी-घोड़ों का संहार होने लगा। अनेक सैनिक मरने लगे।</p><p>प्रजाजन भी राजा को प्रतिमाजी छोड़ देने के लिए समझाने लगे। अचानक गाजिखान नीचे गिर पड़ा। उसके देह में असाहय पीड़ा होने लगी। अत्यंत त्रस्त बने राजा ने प्रतिमाजी देने के लिए सम्मति दे दी। राजा ने सिंहासन पर प्रतिमाजी स्थापित कर बहुमानपूर्वक उसकी पूजा-स्तुति की और प्रतिमाजी संघ को सौंप दी। आनंद-उत्साह के साथ संघ द्वारा वह प्रतिमाजी भीनमाल लाई गई और बड़े उत्साह के साथ उसका प्रवेश कराया गया। सभी ने अपने अभिग्रह के पारणे किए। गाजिखान को झूठी सलाह देने वाले भीनमाल के दुष्ट हाकिम सूबेदार के पांचों पुत्र एक साथ मर गए।</p><p>वि.सं.1662 में वर्जंग श्रेष्ठी ने नवचौकी व प्रदक्षिणा युक्त भव्य मंदिर बनाया। कार्तिक महीने की पूर्णिमा के दिन पार्श्वनाथ की मूर्ति स्थापित की गई थी। राजा के भय से मुक्ति दिलाने के कारण यह प्रतिमाजी भयभंजन के नाम से प्रसिद्ध हुई। वि.सं.1671 में श्री चंद्रप्रभस्वामी का एक और मंदिर यहाँ बनाया गया था। इस पार्श्वनाथ भगवान की पूजा करने से लोग भय मुक्त हो जाते हैं।</p><p>Other temples: Apart from this there are 8 temples in the city and 2 temples outside the city. They all date from the period of the 14th century to the 18th century. A new temple has been built in Bhinmal &quot;Shri Lakshmi Vallabh Parshvanath 72 Jinalaya Mahatirtha&quot; - This temple built on 100 acres of land is very beautiful and artistic. The idol of the Lord was installed in February 2011.</p><p>Works of Art and Sculpture: The ruins of old buildings in the ancient and famous city of Bhinmal are full of artistry. There are many ancient temples here with artistic sculptures, which are truly delightful to look at.</p><p>Directions: Bhinmal&#x27;s railway station is at a distance of 1 km, on the Bhildi-Jalore railway line. Dharamshala and food hall facilities are available here. There is a valuable treasure of Jain knowledge here. Bus services and private vehicles are available to this place from Jalore and Sirohi.</p><p>Scripture: This Tirtha is mentioned in &quot;Nisiddha Churni&quot;, in &quot;Shriphal Siddhanath&quot;, in &quot;Upamati Bhava Prapancha Katha&quot;, in &quot;Shri Uttaradhyaya Vritti&quot;, in &quot;Tirtha Vandana Stotra&quot;, in &quot;Vimal Prabandha&quot;, in &quot;Tirthamala&quot;, in &quot;365 Shri Parshva Jin Namala&quot;, in &quot;Shri Shankheshwar Parshvanath Chhand&quot;, in &quot;Shri Bhinmal Stavan&quot;, It has been done in &quot;Shri Parshvanath Nammala&quot;, &quot;Chaitya Paripati&quot; etc.</p><p>Praise: Parcho Batavyo Nath Ghazi Khan Maa Maa Maa Utrava, Bhinmalno Bhagwan Chhe, Shri Sanghana Bhay Bhanjwa, Mujh Moh Bhayne Bhanjne Bhagwan Tujhne Dhyavata. &quot;Shri Bhaybhanjan Parshva Ne Bhave Karoon Hum Vandana.&quot;</p><p>Chant Mantra: Om Hree Arham Shri Bhaybhanjan Parshvanathaya Namah.</p><p>Trust: Shribhaybhanjan Parshvanath Shwetambar Jain Trust, Hathion Ki Pol, Post: Bhinmal, District: Jalore, State: Rajasthan - 343029, India. Phone: 02969-221190, Mobile: 9461132192.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-088\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Ashapuran Parshvanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-090\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Jeeravala Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/40e0f9pufs6g4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$