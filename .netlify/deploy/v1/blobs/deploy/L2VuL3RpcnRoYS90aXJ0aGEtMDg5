 नयी प्रेरणा दे रहा है।\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"71. श्री भयभंजन पार्श्वनाथ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"पोस्ट- भीनमाल, जिला- जालोर (राजस्थान)।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"मूलनायक: सोने के रंग की पद्मासन मुद्रा में पांच धातुओं की बनी 12.5 इंच ऊंची व 15 इंच चौड़ी फणा रहित भगवान श्रीभयभंजन पार्श्वनाथ की मूर्ति है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"तीर्थ: यह भीनमाल शहर में है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"$25\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"पौराणिक कथाओं में भी इस नगरी को भारी महत्त्व दिया गया है। भगवान श्री महावीर यहाँ विचरे थे, ऐसा उल्लेख मिलता है। पहली शताब्दी में आचार्य श्री वज्र स्वामी यहाँ दर्शनार्थ पधारे थे। श्री उहड़ मंत्री व राजकुमार सुन्दर ने यहीं से जाकर ओसियाँ नगरी बसायी थी। \\\\\\\"शिशुपालवध महाकाव्य\\\\\\\" के रचयिता कवि श्री माघ की जन्मभूमि यही है। सं.992 में सिद्धशिर गणी ने \\\\\\\"उपमिति भव प्रपंचा कथा\\\\\\\" का सर्जन यहीं पर किया था। विमलशा मंत्री के पूर्वज यहीं पर रहते थे। श्रीमाली वंश की उत्पत्ति यहीं हुई थी।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"इस शहर ने कई उन्नति और अवनति देखी है। एक धनवान व्यवसायी ने एक सुंदर और विशाल मंदिर का निर्माण किया और भगवान पार्श्वनाथ की पांच धातुओं वाली मूर्ति स्थापित की। मुस्लिम आक्रमण के भय के कारण इस मूर्ति को छिपा कर रखा गया था। विक्रम संवत 1651 में जब मंदिर स्थल में खुदाई की गई थी, यह मूर्ति लोगों को एक समवसरण और कई अन्य मूर्तियों के साथ मिली थी। पार्श्वनाथ की इस मूर्ति को तब भगवान शांतिनाथ के मंदिर में धूमधाम और महिमा के साथ स्थापित किया गया था।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"भीनमाल के सूबेदार को प्रतिमाजी प्रगट होने की बात का पता चला। उस समय जालोर में गजनीखान का राज्य था, सूबेदार ने गजनीखान को यह बात कही। राजा ने उस प्रतिमा को तोड़कर घंट बनाने का निश्चय किया, उसने वह प्रतिमाजी अपने पास मंगवा ली। इससे समग्र जैन संघ चिंतातुर बना। लोगों ने राजा को समझाने की कोशिश की, राजा टस से मास न हुआ। श्रद्धासंपन्न श्रावकों ने अनेक प्रकार के अभिग्रह किए, वीरचंद क्षेष्ठि ने अन्न त्याग का अभिग्रह किया। श्रेष्ठी की दृढ़ता से अधिष्ठायक देव प्रगट हुए। परंतु सत्ता के नशे में चकचुर गाजिखान प्रतिमा देने के लिए तैयार नहीं हुआ। उसने सोनी को बुलाकर मूर्ति में से अपनी पत्नी के लिए नवसेरा हार व घोड़े के गले के घुंघरू बनाने का आदेश दे दिया।\\\"}],\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-088\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Ashapuran Parshvanath\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-090\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Jeeravala Parshvanath\\\"}],[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n21:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"mt-auto border-t border-sandstone-deep/60 py-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur\\\"}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"राजा के उपदेश से सोनी ने जैसे ही प्रतिमा तोड़ने का प्रयास किया, उसी समय सैकड़ों भौंरों के गुंजन से वातावरण भयजनक बन गया। आकाश में भयंकर बादल छा गए। सैन्य पर अदृश्य प्रहार होने लगे। हाथी-घोड़ों का संहार होने लगा। अनेक सैनिक मरने लगे।\\\"}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"प्रजाजन भी राजा को प्रतिमाजी छोड़ देने के लिए समझाने लगे। अचानक गाजिखान नीचे गिर पड़ा। उसके देह में असाहय पीड़ा होने लगी। अत्यंत त्रस्त बने राजा ने प्रतिमाजी देने के लिए सम्मति दे दी। राजा ने सिंहासन पर प्रतिमाजी स्थापित कर बहुमानपूर्वक उसकी पूजा-स्तुति की और प्रतिमाजी संघ को सौंप दी। आनंद-उत्साह के साथ संघ द्वारा वह प्रतिमाजी भीनमाल लाई गई और बड़े उत्साह के साथ उसका प्रवेश कराया गया। सभी ने अपने अभिग्रह के पारणे किए। गाजिखान को झूठी सलाह देने वाले भीनमाल के दुष्ट हाकिम सूबेदार के पांचों पुत्र एक साथ मर गए।\\\"}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"children\\\":\\\"वि.सं.1662 में वर्जंग श्रेष्ठी ने नवचौकी व प्रदक्षिणा युक्त भव्य मंदिर बनाया। कार्तिक महीने की पूर्णिमा के दिन पार्श्वनाथ की मूर्ति स्थापित की गई थी। राजा के भय से मुक्ति दिलाने के कारण यह प्रतिमाजी भयभंजन के नाम से प्रसिद्ध हुई। वि.सं.1671 में श्री चंद्रप्रभस्वामी का एक और मंदिर यहाँ बनाया गया था। इस पार्श्वनाथ भगवान की पूजा करने से लोग भय मुक्त हो जाते हैं।\\\"}]\\n29:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"Other temples: Apart from this there are 8 temples in the city and 2 temples outside the city. They all date from the period of the 14th century to the 18th century. A new temple has been built in Bhinmal \\\\\\\"Shri Lakshmi Vallabh Parshvanath 72 Jinalaya Mahatirtha\\\\\\\" - This temple built on 100 acres of land is very beautiful and artistic. The idol of the Lord was installed in February 2011.\\\"}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"Works of Art and Sculpture: The ruins of old buildings in the ancient and famous city of Bhinmal are full of artistry. There are many ancient temples here with artistic sculptures, which are truly delightful to look at.\\\"}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"children\\\":\\\"Directions: Bhinmal's railway station is at a distance of 1 km, on the Bhildi-Jalore railway line. Dharamshala and food hall facilities are available here. There is a valuable treasure of Jain knowledge here. Bus services and private vehicles are available to this place from Jalore and Sirohi.\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"children\\\":\\\"Scripture: This Tirtha is mentioned in \\\\\\\"Nisiddha Churni\\\\\\\", in \\\\\\\"Shriphal Siddhanath\\\\\\\"\"])</script><script>self.__next_f.push([1,\", in \\\\\\\"Upamati Bhava Prapancha Katha\\\\\\\", in \\\\\\\"Shri Uttaradhyaya Vritti\\\\\\\", in \\\\\\\"Tirtha Vandana Stotra\\\\\\\", in \\\\\\\"Vimal Prabandha\\\\\\\", in \\\\\\\"Tirthamala\\\\\\\", in \\\\\\\"365 Shri Parshva Jin Namala\\\\\\\", in \\\\\\\"Shri Shankheshwar Parshvanath Chhand\\\\\\\", in \\\\\\\"Shri Bhinmal Stavan\\\\\\\", It has been done in \\\\\\\"Shri Parshvanath Nammala\\\\\\\", \\\\\\\"Chaitya Paripati\\\\\\\" etc.\\\"}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"15\\\",{\\\"children\\\":\\\"Praise: Parcho Batavyo Nath Ghazi Khan Maa Maa Maa Utrava, Bhinmalno Bhagwan Chhe, Shri Sanghana Bhay Bhanjwa, Mujh Moh Bhayne Bhanjne Bhagwan Tujhne Dhyavata. \\\\\\\"Shri Bhaybhanjan Parshva Ne Bhave Karoon Hum Vandana.\\\\\\\"\\\"}]\\n2e:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"children\\\":\\\"Chant Mantra: Om Hree Arham Shri Bhaybhanjan Parshvanathaya Namah.\\\"}]\\n2f:[\\\"$\\\",\\\"p\\\",\\\"17\\\",{\\\"children\\\":\\\"Trust: Shribhaybhanjan Parshvanath Shwetambar Jain Trust, Hathion Ki Pol, Post: Bhinmal, District: Jalore, State: Rajasthan - 343029, India. Phone: 02969-221190, Mobile: 9461132192.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[lang]/tirtha/[slug]/layout,_N_T_/[lang]/tirtha/[slug]/page,_N_T_/en/tirtha/tirtha-089"},"segmentPaths":["/_tree","/_full","/$d$lang/tirtha/$d$slug/__PAGE__","/$d$lang/tirtha/$d$slug","/$d$lang/tirtha","/$d$lang","/_index","/_head"],"revalidate":60,"cacheControl":{"revalidate":60,"expire":31536000}}}