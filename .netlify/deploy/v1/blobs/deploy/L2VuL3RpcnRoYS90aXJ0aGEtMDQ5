url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9622.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 37 - श्री पंचासरा पार्श्वनाथ, श्री हेमचंद्राचार्य रोड, पिप्पला नी शेरी, पोस्ट-पाटन, जिला-पाटन, पिन-384265।</p><p>मुलनायक:- सफेद रंग की पद्मासन मुद्रा, लगभग 120 सेंटीमीटर ऊंची भगवान श्री पंचासरा पार्श्वनाथ की मूर्ति। मूर्ति के सिर के ऊपर 7 नाग के फण की छतरी है।</p><p>तीर्थ:- यह पाटन शहर के केंद्र में है।</p><p>ऐतिहासिकता:- इस शहर का इतिहास विक्रम युग के 802 से शुरू होता है जब वनराज चावड़ा ने जैन मंत्रों के जाप के साथ इस शहर की स्थापना की। उन्होंने अपने गुरु आचार्य श्री शीलगुणसूरिजी के सम्मान में एक सुंदर और शानदार मंदिर निर्माण किया और पार्श्वनाथ भगवान की मूर्ति स्थापित की। इस मंदिर की मूर्ति इस शहर से भी अधिक प्राचीन है क्योंकि इसे पंचासरा से यहाँ लाया गया था, जो अपने पूर्वजों की राजधानी से और श्री शीलगुणसूरि के तत्वावधान में मूर्ति को यहाँ स्थापित किया गया। इसलिए यह असाधारण मूर्ति पंचासरा पार्श्वनाथ के नाम से प्रसिद्ध हुई। यह गुजरात का एक प्राचीन मंदिर है। इस मंदिर को &quot;वनराज विहार&quot; के नाम से भी जाना जाता है।</p><p>पाटन के राजाओं वनराज, मूलराज, सिद्धराज और कुमारपाल और उनके मंत्रियों ने यहाँ कई मंदिरों का निर्माण किया। राजा कुमारपाल द्वारा निर्मित शामला पार्श्वनाथ आज भी है जहाँ वे प्रतिदिन अपने श्रावक के साथ स्नात्र पूजा करते थे। पंचासरा पार्श्वनाथ के मन्दिर को 13वीं शताब्दी में मंत्री आसाक ने जीर्णोद्धार कराया। वास्तुपाल ने भी इस मंदिर का जीर्णोद्धार कराया था।</p><p>मन्दिर निर्माण की सूची में श्री ललितप्रभसुरीश्वरजी द्वारा निर्मित मंदिर, जो वर्ष 1648 विक्रम युग में, 101 बड़े मंदिर और 99 छोटे मंदिर थे। इन मंदिरों में सैकड़ों मूर्तियाँ थीं और उनमें से 38 मूर्तियाँ रत्नों से बनी थीं। विक्रम युग के 1353 और 1356 के बीच, पाटन पर अलाउद्दीन के सेनापति मलिक काफूर द्वारा आक्रमण किया गया था। मंदिरों सहित शहर को नष्ट कर दिया गया था। समय के साथ, शहर का पुनर्निर्माण किया गया और मंदिरों का जीर्णोद्धार किया गया। उस समय पाटन गुजरात की राजधानी के साथ-साथ वैभव, धन, समृद्धि, व्यापार, बहादुरी और करुणा में यह एक अग्रणी शहर था। इसलिए, यह स्वर्ण नगरी के रूप में जाना जाता था।</p><p>श्री हेमचंद्राचार्य ने यहाँ कई वर्ष तक चतुर्मास कर शास्त्र लिखे। जो आज भी पाटन में हेमचंद्राचार्य का पुस्तकालय और कई जैन संस्थान व ज्ञानशाला हैं, जो जैनधर्म का खजाना है।</p><p>अतीत का पुनर्निर्मित जिनालय लकड़ी से बना था। यह सोलहवीं शताब्दी तक लकड़ी का बना रहा। वर्षों, दशकों और शताब्दियों के बीतने के साथ इसकी स्थिति बुरी तरह बिगड़ गई और आधार (नींव) से फिर बनाने का विचार श्रेष्ठी श्री बाबूसाहेब पन्नालाल और पूरनचंदजी के मन में आया। ये पाटन के मूल निवासी थे और यह बावन जिनालय उनके परिवार द्वारा बनाया गया था। वी.स. 2011 शुभ माह जेठ के उज्ज्वल आधे हिस्से में परम पूज्य आचार्य समुद्रसुरि महाराज साहेब द्वारा भगवान पार्श्वनाथ की मूर्ति को उत्साह और धूमधाम से नए रूप में अंजनशलाका के साथ प्रतिष्ठित किया गया था। इस जिनालय के चारों ओर 51 मिनी मंदिर हैं। जैन देवताओं की 86 नई मूर्तियाँ और 24 तीर्थंकर की मूर्तियाँ, तीर्थंकर के वर्ण (शरीर के रंग) की स्लैब से बनी हैं।</p><p>इस जिनालय की कुछ मूर्तियाँ प्राचीन, सम्प्रति महाराजा के समय की हैं। इन मूर्तियों का प्रतिष्ठा समारोह वी.स. 2016 वैशाख की छठी छमाही के छठे दिन मंत्रों के जाप के बीच परम पूज्य पुण्यविजयजी महाराज साहेब के हाथों द्वारा किया गया था। भामती (मंदिर की दीवार के साथ गोलाकार मार्ग) में संगमरमर की 218 मूर्तियाँ हैं और 26 मूर्तियाँ धातु की हैं। इस परिसर में पाँच अन्य जिनालय हैं। पंचसरा पार्श्वनाथ की एक हीरों की आंगी (५ करोड़ की) होती है, इसे करवाने का नखरा पाँच हज़ार है। यहाँ सभी सुविधाओं के साथ धर्मशालाएँ (सराय) और भोजनशाला हैं, यहां हमेशा तीर्थयात्रियों की भीड़ लगी रहती है। पिछले कई वर्षों से तीन दिवसीय त्योहार मनाया जाता है, जो जिनालय की वर्षगांठ है, जो जेठ के उज्ज्वल आधे के पांचवें भाग पर पड़ता है। इन त्योहारों के दिनों में दूर-दूर स्थान से भक्त आते हैं और देव-दर्शन का लाभ लेते हैं।</p><p>अन्य मंदिर: इस मुख्य मंदिर के अलावा, 84 बड़े मंदिर और 134 छोटे मंदिर हैं। यहाँ 108 पार्श्वनाथ में से 10 पार्श्वनाथ थे, वर्तमान में 9 पार्श्वनाथ हैं, एक पार्श्वनाथ को मुम्बई ले गए।</p><p>कला और मूर्तिकला के कार्य: कई जैन मूर्तियों और कला कार्यों के साथ कई जैन मंदिर हैं। इस भव्य मंदिर की लंबाई 180 फीट है और चौड़ाई 90 फीट है। यह नवनिर्मित मंदिर जोधपुरी, मकराना, जैसलमेर और धांगधरा पत्थरों से निर्मित है। सभी गुंबद, खंभे, चौकियां, छतें, दीवारें, मंडप अद्भुत नक्काशी और कलात्मक ढंग से सजाए गए हैं।</p><p>दिशानिर्देश: पाटन का रेलवे स्टेशन मंदिर से 2 किलोमीटर की दूरी पर है। यहां से मेहसाणा लगभग 50 किलोमीटर, सिद्धपुर 30 किलोमीटर और चारूप 12 कि.मी. की दूरी पर है। निजी वाहनों की बस सेवा उपलब्ध है। धर्मशाला और भोजनशाला की सुविधाएँ यहाँ उपलब्ध हैं। कई उपाश्रय भी हैं। यहाँ ज्ञान भंडार अद्भुत हैं और कई प्राचीन शास्त्र उपलब्ध हैं।</p><p>Shastra: This temple is mentioned in &quot;Chandraprabha Charitra&quot;, &quot;Prabhak Charitra&quot;. Also mentioned in &quot;Patan Chaityaparipati&quot;, in &quot;365 Parshva Jina Namamala&quot; and in Sri &quot;Shankheshwar Parshvanath Chhand&quot;. The idol of Shri Panchasara Parshvanath is also in Kalikund Parshvanath Temple Santa Cruz Mumbai, in Jeeravala Tirtha and in Kareda Tirtha.</p><p>Praise: Je Panch Ashraav Varta Panchasara Prabhu Pasji, Vanraj Nripe Thaapiya Bahumanathi Dhari Asaji, Preme Kari Bhakti Prabhu Tuj Mangu Mukti Vasji, Shri &quot;Panchasara&quot; Parshva Ne Bhave I Do Vandana.</p><p>Chant Mantra: &quot;Om Hree Arham Shri &quot;Panchasara&quot; Parshvanathaya Namah&quot;</p><p>Trust: Shri Panchasara Parshvanath Jain Derasar Trust, Hemchandracharya Road, Piplani Sheri, Patan-384265, District-Mehsana, Gujarat State, India. Phone: 02766-222278, 02766-220559.</p><p>Character of Purushadaniya Parshvanath Bhagwan Part-4 (Invitation to dream readers):</p><p>King Ashwasen calls the dream readers i.e. the experts and makes them sit on the seats in the royal meeting room of the royal court and with fruits and flowers in his hand, he politely tells the king that today Vamadevi, while sleeping on a high quality bed in her royal bedroom, in a half-sleep state, has seen the following fourteen great dreams, and after seeing them, she woke up from sleep. These dreams were of Gaja Vrishabha etc. The king requests, O dear devan, what will be the beneficial outcome of this generous fourteen great dreams?</p><p>After this, those who read the dream signs became very happy after hearing and understanding the story presented by King Ashwasen, and speaking words according to the dream scriptures, said - O Devanupriya, the great dreams that Vamadevi has seen are very auspicious. These meanings are those who provide benefit, benefit to people, benefit to son, benefit to happiness and benefit to the state. Certainly, in the family of Vamadevi, a son of Priyadarshi form will be born, who is like a flag, like a lamp, like a mountain, like a mug, like a tilak, and one who enhances the revolution, gives prosperity, expansion, like salvation, like a tree of the family, who gives special growth to the family, with soft hands and feet, full of signs, dishes and qualities with all the five senses without any harm, full of respect, honor and authority, with a gentle figure like the Sujaat all-round moon, will be born.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-048\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Charup (Shyamla) Parshvanath and Patan Yatra Route</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-051\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Koka Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui 