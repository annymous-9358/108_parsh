.js\\\"],\\\"Image\\\"]\\n21:T10a8,\"])</script><script>self.__next_f.push([1,\"श्री अमीझरा पार्श्वनाथ. 6. श्री अमीझरा पार्श्वनाथ. मूलनायक: काले रंग की पद्मासन मुद्रा में लगभग 90 सेंटीमीटर ऊँची भगवान श्री अमीझरा पार्श्वनाथ की मूर्ति।. तीर्थ: यह वडाली गांव के केंद्र में है।. ऐतिहासिकता: प्राचीन काल में इस स्थान को वालपल्ली के नाम से जाना जाता था। पार्श्वनाथ का यह मंदिर 12वीं शताब्दी से पहले की अवधि से संबंधित माना जाता है। यह कहा जाता है कि एक बार प्रचुर मात्रा में अमृत (अमी) इस मूर्ति से बाहर निकल रहा था। अतः भक्तों ने पार्श्वनाथ की इस मूर्ति को अमीझरा पार्श्वनाथ कहना शुरू कर दिया। यह मूर्ति प्राचीन और बहुत ही चमत्कारी है।. अन्य मंदिर: वर्तमान में भगवान शांतिनाथ का एक शानदार मंदिर भी है, जिसमें 52 मूर्तियाँ हैं। यहाँ भगवान आदिनाथ का मंदिर भी है। ऐसा माना जाता है कि ये दोनों मंदिर बारहवीं शताब्दी से पहले की अवधि के हैं।. कला और मूर्तिकला के कार्य: इन सभी मंदिरों में मूर्तियों में अद्भुत शांति के प्रतीक हैं, वे प्राचीन, सुंदर, आकर्षक और शानदार हैं।. दिशानिर्देश: वडाली का निकटतम रेलवे स्टेशन मंदिर से एक किलोमीटर की दूरी पर है। यह पवित्र स्थान ईडर से अहमदाबाद-खेड़ब्रह्मा मार्ग पर 14 किलोमीटर की दूरी पर है और प्रमुख शहर हिम्मतनगर से 44 किलोमीटर दूर है। बस सेवा और टैक्सी सेवाएं उपलब्ध हैं। यहां धर्मशाला और भोजनशाला की सुविधाएं उपलब्ध हैं।. 108 श्री अमीझरा पार्श्वनाथ श्वेतांबर जैन तीर्थ, वडाली, जिला साबरकांठा, गुजरात 383235।. ट्रस्ट: वडाली जैन श्वेताम्बर मूर्तिपूजक संघ, पोस्ट: वडाली - 383235, जिला: साबरकांठा, गुजरात।. पार्श्वनाथ प्रभु के दो चमत्कारी मंत्र जपने से सर्व मनोकामनाओं की पूर्ति होती है, उनके रक्षक देवों के द्वारा सम्पूर्ण शांति व सर्व क्लेशों का नाश होता है। प्रतिदिन जप जरूर कीजिएगा।. ॐ ह्रीं श्री शंखेश्वरा पार्श्वनाथाय नमो नमः॥. ॐ ह्रीं श्री धरणेन्द्र पद्मावती परिपूजिताय श्री शंखेश्वर पार्श्वनाथाय नमः॥\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mb-8 flex flex-wrap items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://goo.gl/maps/U8KgDJMadx8Aga3W6\\\",\\\"target\\\":\\\