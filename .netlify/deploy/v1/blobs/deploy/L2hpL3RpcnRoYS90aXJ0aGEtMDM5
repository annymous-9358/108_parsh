2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 31 - श्री सुल्तान पार्श्वनाथ</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में लगभग 63 सेंटीमीटर ऊंची भगवान श्री सुल्तान पार्श्वनाथ की मूर्ति है।</p><p>तीर्थ: यह सिद्धपुर के पास मेहसाणा-पालनपुर हाइवे पर सुजापुरा, तुलसी रेस्टोरेंट के सामने है।</p><p>ऐतिहासिकता: सरस्वती नदी के पश्चिमी तट पर बसा सिद्धपुर प्राचीन काल में श्रीस्थल के नाम से जाना जाता था। वी.स. 1184 में सिद्धराज जयसिंह ने 24 छोटे मंदिरों से घिरे एक सुंदर मंदिर का निर्माण किया, जिसे &quot;सिद्धविहार&quot; (&quot;राजविहार&quot; के नाम से भी) कहा गया। उसी समय उनके मंत्री अलिंगदेव ने &quot;चौमुख विहार&quot; नामक एक और मंदिर बनवाया और उसमें भगवान पार्श्वनाथ की मूर्ति स्थापित की। माना जाता है कि यह मूर्ति ही सुल्तान पार्श्वनाथ की है। 16वीं-17वीं शताब्दी में सिद्धपुर में 5 जैन मंदिर और 190 तीर्थंकरों की मूर्तियाँ थीं। इन 5 मंदिरों के मूलनायक श्री नेमिनाथ, श्री सुपार्श्वनाथ, श्री महावीरस्वामी, श्री चंद्रप्रभस्वामी और श्री पार्श्वनाथ भगवान थे। वर्ष 1299 में राजपूताना में रणथंभौर और चित्तौड़ पर विजय प्राप्त करने के बाद दिल्ली के सुल्तान अलाउद्दीन खिलजी 14,000 घुड़सवार सेना और 20,000 पैदल सेना के साथ गुजरात की राजधानी अनहिलवाड़ पाटन पर हमला करने के रास्ते में, कस्बों और मंदिरों को लूटता हुआ, सरस्वती नदी के तट पर स्थित सिद्धपुर पहुंचा।</p><p>धनी शहर की भव्यता देखकर सेना ने मंदिरों में तोड़फोड़ शुरू कर दी। सेना को भोजक (भक्ति गायकों) का एक समूह श्री पार्श्वनाथ भगवान को समर्पित एक प्राचीन मंदिर की रक्षा करते हुए मिला। जब पता चला कि यह 11वीं शताब्दी में सिद्धराज के मंत्री अलिंगदेव द्वारा निर्मित जैन मंदिर था, तो मूर्तिपूजा से नफरत करने वाले खिलजी ने मंदिर को पूरी तरह नष्ट करने का फैसला किया। भोजक ने बार-बार प्रार्थना कर नरसंहार रोकने की भीख मांगी, फिर अलाउद्दीन खिलजी के पास पहुंचकर मूर्ति को नष्ट न करने का अनुरोध किया क्योंकि यह केवल पत्थर की मूर्ति नहीं बल्कि स्वयं भगवान थी। अहंकारी सुल्तान ने भक्तों को देवत्व का प्रमाण दिखाने या मूर्ति के विनाश का गवाह बनने को कहा। भोजक ने शाम को मंदिर में सुल्तान को बुलाकर भगवान के सामने घी से भरे 99 दीपक रखे और भक्ति भजन गाना शुरू किया। जैसे राग चरम पर पहुंचा, अचानक ठंडी हवाएं गर्म हो गईं, खिलजी के माथे पर पसीना आ गया और अंधकार में एक दिव्य प्रकाश चमका, सभी 99 दीपक एक-एक करके स्वयं जलने लगे। फिर भी मूर्ति नष्ट करने के लिए जैसे ही खिलजी ने तलवार खींची, एक फणवाला नागदेवता प्रकट हुआ और उसे एक कदम भी आगे नहीं बढ़ने दिया। अपनी गलती का एहसास कर खिलजी ने प्रभु के सामने झुककर पश्चाताप किया और घोषणा की - &quot;यह स्वामी सुल्तानों का सुल्तान है!&quot; तभी से इस दिव्य मूर्ति का नाम सुल्तान पार्श्वनाथ रखा गया।</p><p>भगवान पार्श्वनाथ की यह मूर्ति राजा संप्रति के काल की है। उस घटना के बाद सुल्तान पार्श्वनाथ की मूर्ति को सिद्धपुर स्थित श्री महावीर स्वामी जिनालय की ऊपरी मंजिल पर ले जाया गया। बाद की शताब्दियों में कई श्रद्धेय आचार्यों ने मूर्ति की दिव्यता के बारे में लिखा और इस तीर्थ को भगवान पार्श्वनाथ के 108 शानदार तीर्थों की सूची में शामिल किया गया। समय के साथ सिद्धपुर का आर्थिक महत्व कम होता गया और जैन पालनपुर व पाटन जैसे समृद्ध केंद्रों में चले गए, जिससे मंदिर जीर्ण-शीर्ण हो गया। आचार्य श्री राजेंद्र सूरीश्वरजी महाराज ने मंदिर ट्रस्ट को मुख्य राजमार्ग पर एक भव्य नया मंदिर बनाने की सलाह दी और वर्षों की मेहनत के बाद 29 नवंबर 2017 को आचार्य विजय राजशेखर सूरीश्वरजी महाराज के मार्गदर्शन में सिद्धपुर में नए मंदिर का कार्य संपन्न हुआ।</p><p>बाहरी इलाके में राष्ट्रीय राजमार्ग पर स्थित एक भव्य मंदिर में अन्य मूर्तियों के साथ श्री सुल्तान पार्श्वनाथ की मूर्ति को फिर से स्थापित किया गया।</p><p>अन्य मन्दिर: यहां 2 मंदिर हैं।</p><p>कला और मूर्तिकला के कार्य: सिद्धपुर उत्तर गुजरात का एक प्राचीन ऐतिहासिक शहर है। प्राचीन काल में यह हिंदुओं का एक बहुत प्रसिद्ध तीर्थस्थल था जिसे &#x27;मातृगया&#x27; के रूप में जाना जाता था। सेठ धरनाशाह द्वारा निर्मित रणकपुर (त्रिलोक्य दीपक प्रसाद या धर्म विहार) का प्रसिद्ध मंदिर, अलिंगदेव द्वारा निर्मित &#x27;चौमुख विहार&#x27; मंदिर पर आधारित था। मंदिर बहुत सुंदर और कलात्मक रूप से निर्मित थे।</p><p>दिशानिर्देश: सिद्धपुर रेल और सड़क मार्ग से अच्छी तरह से जुड़ा हुआ है। मंदिर से सिद्धपुर का रेलवे स्टेशन 3 किलोमीटर की दूरी पर है। सिद्धपुर से मेत्रन तीर्थ 13 किलोमीटर की दूरी पर है और तरंगा तीर्थ 45 किलोमीटर की दूरी पर है। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं, यहाँ 3 उपाश्रय हैं।</p><p>शास्त्र: सुल्तान पार्श्वनाथ का उल्लेख &#x27;सिद्धपुर चैत्य परिपाटी&#x27; में, &#x27;तीर्थमाला&#x27; में, &#x27;365 श्री पार्श्व जिन नाममाला&#x27; में, &#x27;शंखेश्वर पार्श्वनाथ छंद&#x27; में, &#x27;108 नाम गर्हित श्री पार्श्वनाथ स्तवन&#x27; में, &#x27;पार्श्वनाथ चैत्यपरिपाटी&#x27; आदि में किया गया है।</p><p>स्तुति: बादशाहो ना बादशाह छे तेथी ज ते मुलतान छे, सहू भान भूलीने समयनुं तुझ भक्तिमां गुलतान छे, छे सिद्धपुर मंडन प्रभु जे सिद्धि देता भव्यने। &#x27;श्री सुल्तान प्रभु पार्श्वने भावे करूं हुं वंदना...&#x27;</p><p>जाप मंत्र: &#x27;ॐ ही अर्ह श्री मनोरंजन पार्श्वनाथाय नमः&#x27;</p><p>ट्रस्ट: श्री सिद्धपुर श्वेतांबर जैन मुर्तिपुजक संघ, पोस्ट: सिद्धपुर, जिला: पाटन, गुजरात। मोबाइल: 09429891850।</p><p>पुरुषादानीय अर्हत पार्श्वनाथ चरित्र भाग-1 (भगवान पार्श्वनाथ का जीव माता वामादेवी की कोख में): उस काल और समय में पुरुषादानीय अर्हत पार्श्व ग्रीष्म ऋतु की प्रथम मास, प्रथम पक्ष अर्थात फागण माह की कृष्ण पक्ष के फागण वद ४ के दिन बीस सागरोपमना आयुष वाले प्राणत नामक देव की आयु पूर्ण कर दिव्य आहार, दिव्य जन्म, दिव्य शरीर छोड़कर तुरंत च्यवन करके इस जम्बूद्वीप में भारतवर्ष की वाराणसी नगरी में अश्वसेन राजा की रानी वामादेवी की कुक्षी में रात को मध्य रात्रि के समय विशाखा नक्षत्र के योग में गर्भ में च्यवन हुआ था।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-037\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री मनोरंजन पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-041\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री दोहला पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucid