sdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_9939.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>41. श्री वाडी पार्श्वनाथ</p><p>मूलनायक: श्वेत रंग की पद्मासन मुद्रा में लगभग 73 सेंटीमीटर ऊँची भगवान श्री वाडी पार्श्वनाथ की सुंदर और उच्च कलात्मक नक्काशीदार परिकर युक्त मूर्ति। वाडी पार्श्वनाथ की चौमुखी मूर्तियाँ भी यहाँ विराजमान हैं।</p><p>तीर्थ: यह पाटन में झवेरीवाड़ी में है।</p><p>ऐतिहासिकता: यह एक प्राचीन मंदिर है। पाटन गुजरात की प्राचीन राजधानी थी। भीम-मन्त्री के वंशज श्री कुंवर श्रेष्ठी ने इस मंदिर का निर्माण किया और वी.सं. 1652 में आचार्य श्री जिनचंद्रसूरिजी के पूज्य हाथों से स्थापित किया। ऐसा माना जाता है कि पार्श्वनाथ की यह मूर्ति वाडीपुर मंदिर से लाई गई थी और इस मंदिर में स्थापित की गई थी। वाडीपुर में इस मूर्ति को &quot;अमिझरा पार्श्वनाथ&quot; के रूप में जाना जाता था। चूंकि यह मूर्ति वाडीपुर से लाई गई थी, इस लिए इस मूर्ति को वाडी पार्श्वनाथ के नाम से जाना जाता है। माना जाता है कि यह मूर्ति राजा संप्रति के काल की थी।</p><p>इस जिनालय की दीवार पर शिलालेख से यह तथ्य पुष्ट होता है कि इस जिनालय का निर्माण कुंवरजी ने, खरतरगच्छ के भीम-मन्त्री के वंशज, वी.सं.1652 में किया था। वी.सं. 1648 में हर्षविजयजी द्वारा रचित चैत्य पारिपाटी में वाडीपुर नामक गाँव में श्री अमीझरा पार्श्वनाथ का उल्लेख है। वाडीपुर गाँव पाटन के पास स्थित था। चार वर्षों के बाद, किसी अज्ञात कारण से शाह कुंवरजी ने इस मूर्ति को वाडीपुर से पाटन लाया और झवेरीवाड़ा में संरक्षित किया। यह अनुमान लगाया जा सकता है कि इस जिनालय का नाम वाडी पार्श्वनाथ के रूप में प्रचलित हुआ क्योंकि मूर्ति को वाडी गांव से लाया गया था। मंदिर के चार नक्काशीदार गर्भगृह हैं। श्री वाडी पार्श्वनाथ की 25 इंच चौमुखी मूर्ति मुख्य देवता के रूप में प्रतिष्ठित है। चारों दिशाओं में सुंदर नक्काशीदार संगमरमर के तोरण (मेहराब) हैं। मंदिर में 20 धातु की मूर्तियाँ भी हैं। वि.सं. 1439 की श्री जिनचंद्रसूरि की एक धातु की मूर्ति और एक क्वार्ट्ज़ मूर्ति भी है। ऊपरी मंजिल पर चार गर्भगृहों के साथ एक गर्भगृह है, जिसमें श्री आदिश्वर की 23 इंच की मूर्ति को मुख्य भगवान के रूप में प्रतिष्ठित किया गया है। प्राचीन पुस्तकों से हमें पता चलता है कि यह जिनालय पूरे विश्व में प्रसिद्ध था। श्री कुंवर श्रेष्ठी ने यहां एक पौषधशाला भी बनवाई थी। इस मंदिर का नवीनीकरण वि.सं.1964 में किया गया था।</p><p>अन्य मंदिर: यहाँ पर नारंगा पार्श्वनाथ का मंदिर है।</p><p>कला और मूर्तिकला के कार्य: यह विक्रम युग की 17वीं शताब्दी में निर्मित एक बहुत प्राचीन मंदिर है। मन्दिर में दीवार पर संस्कृत में आचार्य श्री उदयसंतसूरिजी से आचार्य श्री जिनचंद्रसूरिजी के लिए शुरू होने वाले खरतरगच्छ के सभी आचार्यों के नामों का उल्लेख है। एक उल्लेख कुंवर श्रेष्ठी और उनके परिवार का भी है, जिन्होंने इस खूबसूरत मंदिर का निर्माण किया। रंगमंडप बहुत विशाल (...)</p><p>(पृष्ठ का यह भाग श्री वाडी पार्श्वनाथ मंदिर, पाटन के विवरण की निरंतरता है।) मंदिर के विशाल गुंबद के नीचे, वाद्य यंत्रों पर नर्तकियों के चित्र उकेरे हैं। रंगमंडप कांच की खिड़कियों के साथ बहुत आकर्षक लगता है। रंगमंडप के खंभे भी मूर्तियों से सजे हैं। नक्काशी असाधारण और बहुत कलात्मक है।</p><p>इस जिनालय का पहला संदर्भ श्री प्रेमविजयजी द्वारा वि.स. 1655 में रचित &quot;365 श्री पार्श्वजिन नाममाला&quot; में मिलता है। इसलिए यह कहा जा सकता है कि यह जिनालय वि.स. 1655 के पूर्व का निर्मित है। कवि नयासुंदर द्वारा रचित श्री शंखेश्वर पार्श्वनाथ छंद में इसका संदर्भ है। वि.स. 1729 में हर्षविजय द्वारा रचित पाटन चैत्य पारिपाटी में चौमुखी वाडी पार्श्वनाथ का उल्लेख है।</p><p>दिशानिर्देश: पाटन सड़क और रेल द्वारा अच्छी तरह से जुड़ा हुआ है। पाटन से चारुप तीर्थ 10 कि.मी. दूर है। यहां बस और निजी वाहन उपलब्ध हैं।</p><p>शास्त्र: &quot;श्री पार्श्वनाथ छंद&quot;, &quot;108 नाम गर्भित श्री पार्श्वनाथ स्तवन&quot;, &quot;365 श्री पार्श्वनाम माला&quot;, &quot;पाटन चैत्य पारिपाटी&quot;, &quot;श्री पाटन जिनालय स्तुति&quot; आदि में वाडी पार्श्वनाथ का उल्लेख किया गया है।</p><p>स्तुति: वाडी पूरेथी आविया, ने पाटनमां विराजीया, मुझ हृदय कमले आवशो, तो कर्म शत्रु नाशीया, वरसावो करुणा अम पर भव दावानले दाजिया, &quot;श्री वाडी पार्श्व ने भावे करूँ हुं वंदना&quot;</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हं श्री वाडी पार्श्वनाथाय नमः&quot;</p><p>ट्रस्ट: श्री वाडी पार्श्वनाथ श्वेतांबर जैन तीर्थ, झवेरीपाड़ो, पोस्ट: पाटन, जिला: पाटन - 384295, राज्य: उत्तर गुजरात। फोन: 02766-222969। इस जिनालय का संचालन शेठ धर्मचंद अभयचंद की फर्म द्वारा किया जाता है।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-055\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Tankala Parshvanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-059\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Naranga Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" st