ject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_14198.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 89 - श्री करेडा पार्श्वनाथ</p><p>मूलनायक: काले रंग की पद्मासन मुद्रा में 29 इंच ऊंची व 27 इंच चौड़ी भगवान श्री करेडा पार्श्वनाथ की ऊँची मूर्ति है। मूर्ति के सिर के ऊपर 9 नाग के फणों का एक छत्र है।</p><p>तीर्थ: यह भूपालसागर शहर के केंद्र में है।</p><p>ऐतिहासिकता: इस तीर्थ की प्राचीनता का सही प्रमाण उपलब्ध नहीं है। वर्तमान जिणोद्धार के समय एक प्राचीन स्तंभ प्राप्त हुआ, जिस पर सं. ५५ का लेख उत्कीर्ण है, इससे यह प्रतीत होता है कि यह तीर्थ विक्रम के पूर्व काल का होगा। वि.संवत ८६१ में श्री खिमसिंह शाह ने भव्य जिनालय का निर्माण करवाया था। आचार्य श्री जयानंद सुरीश्वरजी के शुभ हस्ते पारसनाथ भगवान की प्रतिमा की प्रतिष्ठा की गई थी। वि.सं. १०३९ में भट्टारक आचार्य श्री यशोभद्रसूरीश्वरजी द्वारा श्री पार्श्वनाथ भगवान की प्रतिमा प्रतिष्ठा होने का भी उल्लेख मिलता है। सं. १३२६ चैत्र कृष्ण सोमवती अमावस्य के दिन महारावल श्री चाचिगदेव द्वारा यहाँ श्री पार्श्वनाथ भगवान के मंदिर की सेवा-पूजा निमित्त कुछ धनराशि अर्पण करने का उल्लेख है। भमती में कुछ मूर्तियों पर वि.सं. १३०३, १३४१ व १४९६ के लेख उत्कीर्ण हैं। सभा मण्डप के उपरी भाग में एक मस्जिद की आकृति बनी हुई थी; कहा जाता है कि जब अकबर बादशाह यहाँ आया, तब यह आकृति इसलिए बनवायी गई ताकि मुसलमान आक्रमणकारी ऐसे सुन्दर चमत्कारिक मंदिर का नाश न करें। गुर्वावली में उल्लेखनुसार मांडवगढ़ के महामंत्री श्री पेथडशाह ने भी श्री पार्श्वनाथ भगवान के मंदिर का यहाँ निर्माण करवाया था। मांडवगढ़ के महामंत्री श्री पेथडशाह के पुत्र श्री झांझन शाह वि.सं. १३४० में जब २० आचार्य भगवंत व अनेक साधू साध्वियों के साथ श्री शत्रुंजयगिरी का छ: रिपालित यात्रा संघ लेकर गये थे, उस समय यहाँ आये और श्री पार्श्वप्रभु के मंदिर का जिणोद्धार प्रारंभ करके सात मंजिल का मंदिर बनवाने का उल्लेख है, लेकिन आज उस भव्य मंदिर का पता नहीं है। वर्तमान मंदिर सं. १०३९ का निर्मित माना जाता है। प्रभु प्रतिमा पर वि.सं. १६५६ का लेख उत्कीर्ण है, हो सकता है जिणोद्धार के समय यह प्रतिमा प्रतिष्ठित करवाई गयी हो। इस मंदिर का हाल ही में पुनः जिणोद्धार होकर वि.सं. २०३३ माघ शुक्ल १३ के शुभ दिन आचार्य श्री सुशीलसूरीश्वरजी के सुहस्ते इस प्राचीन प्रभु-प्रतिमा की पुनः प्रतिष्ठा संपन्न हुई। बावन जिनालय से युक्त यह मंदिर अत्यंत ही मनोहर है और विद्वान भट्टारक आचार्य श्री यशोभद्रसूरीश्वरजी द्वारा प्रतिष्ठित माना जाता है। अकबर बादशाह के यहाँ दर्शनार्थ आने का उल्लेख है। मांडवगढ़ के महामंत्री श्री पेथडीशाह के पुत्र मंत्री झांझन शाह, आचार्य श्री धर्मघोषसूरीश्वरजी आदि अनेक आचार्यगणों के साथ जैन इतिहास में उल्लेखनीय शत्रुंजय यात्रासंघ लेकर यहाँ उपसर्ग हरणार श्री पार्श्वप्रभु की प्रतिमा के दर्शनार्थ आये, तब संघपति का तिलक यहीं हुआ था। वर्तमान प्रतिमा भी अति ही चमत्कारी व उपसर्ग-हरनारी है। प्रतिवर्ष प्रभु के जन्म कल्याणक पौष कृष्णा १० के दिन मेला लगता है, जब हजारों नर-नारी प्रभु भक्ति में भाग लेते हैं। उस दिन सूर्य देव की किरण प्रतिमाजी पर आती हैं।</p><p>एक साथ पांच प्रतिष्ठाएँ: संडेरक गच्छ के महान आचार्य श्री यशोभद्रसूरीश्वरजी म. अत्यंत ही प्रभावशाली महान पुरुष थे। उनके जीवन में अनेक चमत्कारी घटनाएँ घटी हैं। श्री करेड़ा तीर्थ की प्रतिष्ठा के प्रसंग पर बनी एक चमत्कारी घटना का जिक्र &quot;प्रबंध पंचशती&quot; ग्रन्थ में उपलब्ध है। पू. आचार्य भगवंत आघाटपुर में बिराजमान थे, उस समय करहेटपुर, कविलाणपुर, संयभरिपुर, मंडोरपुर तथा भेससनपुर में भव्य जिन प्रसाद तैयार हो चुके थे। उन पांचों नगरों के संघ अपने-अपने जिनालयो की प्रतिष्ठा के मुहरत लेने के लिए आचार्य भगवंत के पास आए। आचार्य भगवंत ने पांचो मंदिरों की प्रतिष्ठा हेतु एक ही मुहरत प्रदान किया, और सभी के आश्चर्य के बीच चार वक्रीय रूप धारण कर पूज्य सूरिदेव ने पांचो जिनमंदिरो की एक ही मुहरत में प्रतिष्ठा संपन्न की।</p><p>अन्य मंदिर: वर्तमान में कोई अन्य मंदिर नहीं हैं।</p><p>कला और मूर्तिकला के कार्य: यहाँ कई खंडहर देखे जा सकते हैं जहाँ से प्राचीन कला का आनंद लिया जा सकता है। यदि शोध कार्य उचित तरीके से किया जाए, तो प्रामाणिक इतिहास के कई विवरण प्राप्त करना संभव है। इस मंदिर की विशेषता है कि मुलनायक प्रतिमा के ऊपर दोहरा शिखर ध्वजा है।</p><p>दिशानिर्देश: भूपालसागर का निकटतम रेलवे स्टेशन 1 किमी की दूरी पर है। यह स्थान चितौड़-उदयपुर मार्ग पर चितौड़ से 56 किमी की दूरी पर है। बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;तीर्थमाला&quot;, &quot;श्री शंखेश्वर पार्श्वनाथ छंद&quot;, &quot;श्री भटेव पार्श्वनाथ स्तवन&quot;, &quot;श्री गोडीजी पार्श्वनाथ स्तवन&quot;, &quot;श्री पार्श्वनाथ नाममाला&quot;, &quot;श्री पार्श्वनाथ चैत्यपारीपाटी&quot; आदि में किया गया है। वी.स. 1521 में श्री शुभशील गणी द्वारा लिखित &quot;प्रबन्ध पंचशति&quot; में मूर्ति की स्थापना के दौरान हुए चमत्कारों का उल्लेख है। श्री करेडा पार्श्वनाथ की एक मूर्ति मुम्बई के सांताक्रूज़ में कलीकुंड पार्श्वनाथ मंदिर में, १०८ पार्श्वनाथ भक्ति विहार तीर्थ और जीरावाला तीर्थ में भी है।</p><p>Praise: Hey Nath Jeenoddhar Jhanjhan Minister Taron Karavata, Tari Stuti Thi Devkrit Prefix Sahu Doore Thata Che Naam Taru Ehvu Jaane Karmane Pade Korda. &quot;Shri Kareda Parshva Ne Bhave Karoon Hum Vandana&quot;</p><p>Chant Mantra: “Om Hree Arham Shri Kareda Parshvanathaya Namah”</p><p>Trust: Shri Jain Shwetambar Murtipujak Shri Kareda Parshwanathji Teerth Pedhi, Bhupalsagar: 312052, District: Chittorgarh, Rajasthan State, India. Phone: 01476-84233, Mobile-07073224862.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-109\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Chanda Parshvanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-111\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Ravana Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto m