\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"कला और मूर्तिकला के कार्य: यहाँ की मूर्ति की कला का एक विशेष महत्व है। शिखर पर मूर्तिकला का एक असाधारण चित्रण प्रस्तुत करती है। वी.सं.1707 में एक कलात्मक परिकर बनाया गया था। स्तंभों पर किए गए कलात्मक कार्य देखने लायक हैं।\\\"}]\\n21:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"दिशानिर्देश: रानी, निकटतम रेलवे स्टेशन, 3 किलोमीटर की दूरी पर है और फालना 20 किलोमीटर की दूरी पर है। बस सेवा और निजी वाहन आसानी से उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं। यहां एक जैन बोर्डिंग स्कूल है।\\\"}]\\n22:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"children\\\":\\\"शास्त्र: \\\\\\\"श्री सुंदरेश्वर पार्श्वनाथ छंद\\\\\\\" में, \\\\\\\"श्री भटेव पार्श्वनाथ स्तवन\\\\\\\" में, \\\\\\\"विक्रम चरित्र पंचमंड\\\\\\\" में, \\\\\\\"श्री सुंदर पार्श्व पंचमण्ड\\\\\\\" में, \\\\\\\"आनंद सुंदर ग्रंथ\\\\\\\" में, \\\\\\\"चैत्यपारीपाटी\\\\\\\", \\\\\\\"तीर्थमाला\\\\\\\" आदि में इस मंदिर का उल्लेख किया गया है। जिरावाला तीर्थ में और मुंबई के सांताक्रूज में कलिकुंड पार्श्वनाथ मंदिर में वरकाना पार्श्वनाथ की मूर्ति है।\\\"}]\\n23:[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"children\\\":\\\"स्तुति: वरकाणा नगरे शोभता वरगंध हस्ति सभा प्रभु, विनवी रहा आ भक्त तारा कां नवी रिजता विभु, जगमातने जग दाता तू जगनाथ ए तुझ नामना। \\\\\\\"श्री वरकाणा पार्श्व ने भावे करूँ हुं वंदना।\\\\\\\"\\\"}]\\n24:[\\\"$\\\",\\\"p\\\",\\\"15\\\",{\\\"children\\\":\\\"जाप मंत्र: ॐ ह्री अर्हम् श्री वरकाणा पार्श्वनाथाय नमः।\\\"}]\\n25:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"children\\\":\\\"ट्रस्ट: श्री वरकाना पार्श्वनाथ जैन श्वेतांबर तीर्थ पेढ़ी, वरकाणा: 306601, जिला: पाली, राजस्थान राज्य, भारत। फोन: 02934-222257, मोबाइल: 7426923363।\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/tirtha/$d$slug/__PAGE__":"","/tirtha/$d$slug":"","/tirtha":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/tirtha/layout,_N_T_/tirtha/[slug]/layout,_N_T_/tirtha/[slug]/page,_N_T_/tir