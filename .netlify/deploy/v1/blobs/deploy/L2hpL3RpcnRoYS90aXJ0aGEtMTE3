,\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"96. श्री अवंती पार्श्वनाथ\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"मूलनायक: काले रंग की पद्मासन मुद्रा में 37 इंच ऊंची व 30 इंच चौड़ी भगवान श्री अवंति पार्श्वनाथ की मूर्ति। मूर्ति के सिर के ऊपर 7 नाग फणों की छतरी है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"तीर्थ: यह क्षिप्रा नदी के पास उज्जैन शहर में है। मंदिर 2,300 साल पुराना है।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"ऐतिहासिकता: इस शहर का प्राचीन नाम अवंतिका, पुष्करणी और विशाला था। यह मालवा की प्राचीन राजधानी थी। राजा सुधन्वा के शासनकाल के दौरान इस शहर को उज्जैन कहा जाने लगा। राजा संप्रति, जिन्होंने आचार्य आर्यसुहातिसुरी की सलाह पर 1,25,000 जैन मंदिरों का निर्माण करवाया, 1,25,00,000 जैन तीर्थंकर मूर्तियों को स्थापित किया और 36,000 जैन मंदिरों का जीर्णोद्धार कराया, इस शहर को गौरवान्वित किया। एक शुभ दिन नलिनी गुल्म-विमान में से एक भाग्यशाली देवात्मा का आयुष्य पूर्ण हुआ और भद्रा सेठानी की कुक्षि में उस देवात्मा का अवतरण हुआ। उसी समय भद्रा माता ने शुभ स्वप्न देखा। धीरे-धीरे समय व्यतीत होने लगा और एक शुभ दिन भद्रा सेठानी ने एक अत्यंत ही तेजस्वी पुत्र-रत्न को जन्म दिया। बालक का नामकरण किया गया - अवंतीसुकुमाल! धीरे-धीरे अवंतीसुकुमाल बड़ा होने लगा। यौवन के प्रांगण में प्रवेश करने के साथ ही उसने पुरुषों की समस्त 72 कलाओं में निपुणता हासिल कर ली, इतना ही नहीं धर्मकला में भी वह निपुण हुआ। देवांगनाओं जैसी 32 नवयौवना कन्याओं के साथ उसका पाणिग्रहण हुआ।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"एक बार आर्य-सुहस्ती महाराज पृथ्वीतल को पावन करते हुए आचार्य आर्यसुहातिसुरी अपने शिष्यों के साथ उज्जैन आए और भद्रा सेठानी के वंशलशाला में ठहरे। रात्रि के समय आचार्य भगवंत नलिनी गुल्म विमान अध्ययन का पुनरावर्तन करने लगे। उस समय अवंतीसुकुमाल पास ही के भवन में बैठा हुआ अपनी पत्नियों के साथ वार्ता-विनोद कर रहा था। आचार्य भगवंत की स्वाध्याय-ध्वनि के शब्द अवंतीसुकुमाल के कानों में गिरे और वह सोचने लगा, \\\\\\\"अहो! आचार्य भगवंत स्वाध्याय का वर्णन कर रहे हैं... वह दृश्य तो मैंने कहीं देखा है\\\\\\\" - इस प्रकार विचार करते हुए उसे तत्काल जातिस्मरण ज्ञान उत्पन्न हो हुआ। उसे अपना पूर्व भव प्रत्यक्ष दिखाई देने लगा।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"उसे लगा, \\\\\\\"अहो! गत भव में मैं इसी नलिनी गुल्म विमान में देव के रूप में था। वहां के सुख और यहाँ के सुख में कितना बड़ा अंतर है। वहां के सुख मेरु-तुल्य हैं, तो यहाँ के सुख सरसों जितने...\\\\\\\" (पृष्ठ यहीं अगले पृष्ठ पर अधूरा रह जाता है, कथा आगे चलती है)।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"(कथा-प्रसंग) अवंतीसुकुमाल यह विचार कर उसी समय आचार्य भगवंत के पास आकर अत्यंत विनयपूर्वक बोले, \\\\\\\"हे भगवंत! आप जिस नलिनीगुल्म विमान का वर्णन कर रहे हो, तो क्या आप उस विमान में से आ रहे हैं?\\\\\\\" आचार्य भगवंत ने कहा, \\\\\\\"नहीं, हम तो श्रुत (शास्त्र) के बल से उस विमान का वर्णन कर रहे हैं।\\\\\\\" अवंतीसुकुमाल बोले, \\\\\\\"प्रभो! मैं उसी देवविमान से च्यवकर आया हूँ - जातिस्मरण ज्ञान से मुझे उस विमान के सुख प्रत्यक्ष दिखाई दे रहे हैं...अब मुझे यहाँ के सुख तुच्छ प्रतीत हो रहे हैं। अतः मैं यहाँ रहने में समर्थ नहीं हूं, वहां पुनः जाने के लिए मैं दीक्षा लेना चाहता हूँ, आप मुझे दीक्षा प्रदान करें।\\\\\\\"\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"आचार्य भगवंत ने कहा, \\\\\\\"महानुभाव! लोहे के चने चबाना सरल है किन्तु संयम का पालन दुष्कर है।\\\\\\\" अवंतीसुकुमाल ने कहा, \\\\\\\"प्रभो! प्रव्रज्या ग्रहण करने के लिए मेरा मन अत्यंत उत्कंठित है...मैं दीर्घकाल तक संयम पालन करने में असमर्थ हूँ, अतः दीक्षा अंगीकार कर तुरंत ही अनशन व्रत स्वीकार कर लूंगा, जिससे अल्पकाल के कष्टों से ही मेरा कार्य सिद्ध हो जाएगा।\\\\\\\" गुरुदेव ने कहा कि यदि दीक्षा ग्रहण करने की इच्छा है, तो अपनी माता व पत्नियों की सम्मति लेकर आ जाओ। अवंतीसुकुमाल ने जाकर अपनी माता व पत्नियों से बात की, परन्तु अनुमति न मिलने पर उन्होंने स्वयं ही दीक्षा अंगीकार कर ली।\\\"}],\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\",\\\"$L30\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items