1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11637.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>58. Shri Chorwadi Parshwanath</p><p>Athamno Darvajo, Chorwad, Taluka: Veraval, District: Junagadh.</p><p>Main Deity: A white-stone idol of Shri Chorwadi Parshwanath, 23 inches tall and 19 inches wide, in the padmasana posture.</p><p>Location: This temple is in Athamno Darvajo in the village of Chorwad, in Junagadh district.</p><p>History: Chorwad is an ancient village in the Junagadh district of Saurashtra. This pilgrimage site of Chorwadi Parshwanath predates the 15th century, as it is mentioned in the Tirthmala composed by Shri Jaysagar Upadhyay in V.S. 1487, in which he records having made a pilgrimage to Shri Chorwadi Parshwanath. The present temple was built by the Jain Sangh in V.S. 1529. This idol is very ancient and powerful. It is known, after the village of Chorwad, as Shri Chorwadi Parshwanath. This idol is also identified as Shri Chintamani Parshwanath. As the idol has a smiling countenance, this form of Parshwanath is also known as &quot;Hasmukh Parshwanath&quot; (&quot;the smiling one&quot;). This temple is managed by the Shri Mangroli Jain Sangh.</p><p>Directions: This temple is 7 kilometers from Chorwad railway station. Girnar Tirth, Barej Tirth, and Mangrol Tirth are all nearby. Mangrol Tirth (Shri Navpallav Parshwanath) is 18 km from here, and Prabhas Patan Tirth is 27 km away. There is an upashraya here.</p><p>Scripture References: Chorwadi Parshwanath is mentioned in &quot;Tirthmala,&quot; &quot;Shashwat Tirthmala,&quot; &quot;365 Shri Parshva Jin Nammala,&quot; &quot;Shri Bhagwan Parshwanath Stavan,&quot; &quot;Shri Parshwanath Nathwala,&quot; &quot;Shri 108 Parshwanath Chhand,&quot; &quot;135 Nam Garbhit Shri Parshwanath Stavan,&quot; and others. An image of Chorwadi Parshwanath is also present at Jiravala Tirth and at the Kalikund Parshwanath Temple in Santacruz, Mumbai.</p><p>Hymn of Praise: He who dispels delusion (moha) yet wears a smile upon his face; he who is seated in Chorwad yet drives away the thief of attachment; O smiling one of Chorwad, all obey your command. &quot;With loving devotion I bow to Shri Chorwadi Parshwa.&quot; O smiling one, you have come to your court; we have been robbed by the thief of karma - what more is there to say? O son of Vama, beloved of Chorwad, save me from the thief of delusion; at the feet of &quot;Chorwadi&quot; Parshwa, I offer my body, mind, and wealth forever.</p><p>Chanting Mantra: Om Hrim Arham Shri Chorwadi Parshwanathaya Namah.</p><p>Trust: Shri Chorwadi Parshwanath Shwetambar Jain Temple, Athamno Darvajo, Post: Chorwad, Taluka: Veraval, District: Junagadh, Saurashtra, State: Gujarat - 362250, India. Phone: 02870-288774, Mobile: 9723566614 (priest).</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-076\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Dokadiya Parshwanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-078\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Navpallav Parshwanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/40e0f9pufs6g4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])<