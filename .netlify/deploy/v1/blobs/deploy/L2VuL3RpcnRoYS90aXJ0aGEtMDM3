xt/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8834.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 30 - श्री मनोरंजन पार्श्वनाथ, स्टेशन रोड, मेहसाणा।</p><p>मुलनायक:- सफेद रंग की पद्मासन मुद्रा में लगभग 69 सेंटीमीटर ऊँची मूर्ति भगवान श्री मनोरंजन पार्श्वनाथ की है।</p><p>तीर्थ:- यह मंदिर मेहसाणा शहर में है।</p><p>ऐतिहासिकता:- यह एक प्राचीन शहर है जो वि.स. 12-13वीं शताब्दी में मेहसाजी चावड़ा द्वारा स्थापित किया गया था। कल्याण पार्श्वनाथ का मंदिर सबसे पहले मेहसाणा में था। 14-15वीं शताब्दी में मुस्लिमों के आक्रमण के कारण पार्श्वनाथ की इस मूर्ति को विनाश से बचाने के लिए छुपा दिया गया था और विसनगर के एक मंदिर में यह स्थापित की गई थी।</p><p>मनोरंजन पार्श्वनाथ नाम के पीछे एक कहानी है। राजा मेहसाजी की कोई संतान नहीं थी और वे एक वारिस चाहते थे। एक जैन आचार्य ने उनसे भगवान पार्श्वनाथ से प्रार्थना करने को कहा। मेहसाजी ने गहरी आस्था के साथ भगवान पार्श्वनाथ की मूर्ति के सामने प्रार्थना की, उसकी प्रार्थनाएँ पूरी हुईं और एक बेटा पैदा हुआ। बहुत खुशी में उन्होंने मूर्ति का नाम &quot;मनोरंजन पार्श्वनाथ&quot; रखा। मनोरंजन पार्श्वनाथ की यह मूर्ति राजा संप्रति के काल की है। पहले मेहसाणा में दो मंदिर थे, एक मनोरंजन पार्श्वनाथ और दूसरा सुमतिनाथ भगवान का। वि.स. 1920 में एक नया दो मंजिला मंदिर बनाया गया और इन दोनों मूर्तियों को इस मंदिर में प्रतिष्ठित किया गया। मेहसाणा जैनियों का एक बहुत प्रसिद्ध तीर्थस्थल है।</p><p>श्री सिमन्धर स्वामी (महाविदेहक्षेत्र का विहरमान तीर्थंकर) का एकमात्र मंदिर अहमदाबाद-दिल्ली राष्ट्रीय राजमार्ग पर है। श्री सिमन्धर स्वामी की विशाल मूर्ति की ऊंचाई 3.68 मीटर है और इसे वि.स. 2028 में आचार्य श्री कैलाशसागरसूरीजी द्वारा स्थापित किया गया था।</p><p>अन्य मंदिर:- यहां 15 अन्य मंदिर हैं।</p><p>कला और मूर्तिकला के कार्य: यह एक बड़ा दो मंजिला मंदिर है, जो बहुत कलात्मक और खूबसूरती से निर्मित है।</p><p>दिशानिर्देश: मेहसाणा का रेलवे स्टेशन एक जंक्शन है। यह सड़क मार्ग से अच्छी तरह से जुड़ा हुआ है। यहां टैक्सी और बस सेवाएं उपलब्ध हैं। शंखेश्वर, मुंजपुर, पाटन, चारुप, कम्बोई, चणाश्मा, शंकालपुर, रातेज जैसे तीर्थस्थान मेहसाणा जिले में आते हैं। धर्मशाला और भोजनशाला शहर में उपलब्ध हैं। यहाँ कई उपाश्रय, ज्ञानभंडार और पाठशाला हैं।</p><p>धर्मशाला और भोजनशाला की सुविधाएं सीमन्धर स्वामी मंदिर में भी उपलब्ध हैं। मेहसाणा की श्री यशोविजयजी संस्कृत पाठशाला बहुत प्रसिद्ध है, जिसने जैन धर्म को विधिकार पंडित आदि बहुत योगदान दिया है।</p><p>शास्त्र: इस मंदिर का उल्लेख &quot;तीर्थमाला&quot;, &quot;श्री शंखेश्वर पार्श्वनाथ छंद&quot;, &quot;पार्श्वनाथ चैत्यपरिपाटी&quot; में, &quot;श्री 108 नामगर्भित पार्श्वनाथ स्तवन&quot; में आदि में किया गया है। &quot;कमल विजय रास&quot; श्री हेमविजयगणी द्वारा यहाँ वी.स. 1661 में लिखा गया था। एक मूर्ति मनोरंजन पार्श्वनाथ की करेड़ा पार्श्वनाथ तीर्थ में भी है।</p><p>स्तुति: भवदुःखखंडना नाथ निरंजन मनोरंजन हे प्रभु!, हे वामानंदन त्रिजगवंदन शीतलचंदन हे विभु!, महेशाजी राजा आपनुं पूजन करी मनरंजना, श्री मनोरंजन प्रभु पर सोने भावे करूं हूं वंदना, &quot;श्री &quot;मनोरंजन&quot; प्रभु पार्श्वने भावे करूं हुं वंदना...&quot;</p><p>जाप मंत्र: &quot;ॐ ह्री अर्ह श्री &quot;मनोरंजन&quot; पार्श्वनाथाय नमः&quot;</p><p>ट्रस्ट: श्रीमनोरंजन पार्श्वनाथ जैन देरासर, स्टेशन रोड, मेहसाणा-384001, जिला: मेहसाणा, उत्तर गुजरात, भारत। फोन: 02762-221253।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-035\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Kalyan Parshvanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-039\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Sultan Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div>