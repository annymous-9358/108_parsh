\\\",\\\"5\\\",{\\\"children\\\":\\\"अलचपुर नगर के चंद्रवंशी राजा श्रीपाल कुष्ठ रोग से पीड़ित थे, बीमारी ठीक करने के सभी उपाय विफल रहे। एक दिन राजा शहर से बाहर गए, प्यास लगने पर एक कुआं देखकर उसके पानी से हाथ, पैर और चेहरा धोया और पानी पीकर सो गए। सुबह उठकर देखा कि उनके हाथ, पैर और चेहरे की कोढ़ की बीमारी ठीक हो गई है। यह कुएं के पानी का चमत्कार जानकर राजा कुएं के पास आए और स्नान किया, वे अपनी बीमारी से पूरी तरह ठीक हो गए। राजा के प्रार्थना करने पर देव प्रकट हुए और बताया कि यह चमत्कार भगवान पार्श्वनाथ की मूर्ति के कारण है जो कुएँ के अंदर है। राजा ने देव से मूर्ति देने को कहा, राजा की भक्ति देखकर धर्मेन्द्र देव प्रसन्न हुए और मूर्ति देकर बताया कि उसे कुएं से बाहर कैसे लाना है। अगले दिन देव के निर्देशों के अनुसार मूर्ति को कुएं से निकाल लिया गया।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"राजा ने मूर्ति को एक रथ में रखा जिसे दो नवजन्मे (7 दिन की आयु के) बछड़ों द्वारा खींचा गया। कुछ दूर जाने के बाद राजा ने पीछे मुड़कर देखा कि रथ आ रहा है या नहीं, जैसे ही राजा ने पीछे मुड़कर देखा, रथ तुरंत रुक गया। मूर्ति को अंतरिक्ष में ही छोड़कर रथ वापस चला गया। मूर्ति को ले जाने का बहुत प्रयास किया गया लेकिन मूर्ति नहीं चली और एक पेड़ के नीचे अंतरिक्ष में खड़ी हो गई। कहा जाता है कि मूर्ति जमीन से 7 हाथ ऊपर थी, एक घोड़े की पीठ पर सवार व्यक्ति और एक महिला सिर पर पानी का बर्तन लेकर मूर्ति के नीचे से जा सकते थे। इसीलिए इस मूर्ति को \\\\\\\"अंतरिक्ष पार्श्वनाथ\\\\\\\" के नाम से जाना जाता है। कलयुग के कारण अब मूर्ति के नीचे से केवल एक पतले कपड़े की जगह ही निकाली जा सकती है, आज भी मूर्ति अंतरिक्ष में है और जमीन को नहीं छूती। जैन संघ ने एक सुंदर मंदिर का निर्माण किया।\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"इस मंदिर में वि.सं. 1142 के माघ सुदी पांचम (5वें) दिन मालधारी आचार्य श्री अभय देव सुरीश्वरजी के शुभ हस्ते श्री अंतरिक्ष पार्श्वनाथ भगवान की मूर्ति प्रतिष्ठित की गई। राजा श्रीपाल ने वहां एक शहर बनाया नाम श्रीपुर रखा, जो आज शिरपुर के नाम से जाना जाता है। यह तीर्थ बहुत प्रसिद्ध हुआ, यह मंदिर कई बार पुनर्निर्मित किया गया। चमत्कार यहाँ होते रहते हैं। श्री भावविजय गणी ने अपनी दृष्टि खो दी थी और वे बहुत उदास थे, आचार्य श्री विजयदेवसूरिजी ने उन्हें देवी पद्मावती से प्रार्थना करने को कहा। उनकी प्रार्थना से प्रसन्न होकर देवी प्रकट हुई और भगवान श्री अंतरिक्ष पार्श्वनाथ की पूजा करने को कहा। जैन संघ के साथ गणिवर्य अंतरिक्ष तीर्थ में आए और स्तोत्र पाठ करने पर उनकी आंखों की रोशनी लौट आई। गणिवर्य भवविजयजी के निर्देशों के तहत वि.सं. 1715 में चैत्र सुदी पांचम के दिन मूर्ति को फिर से प्रतिष्ठित किया गया था। हर साल एक मेला फाल्गुन के शुक्लपक्ष की 3 तीज और पौष मास के कृष्ण पक्ष के 10वें दिन लगता है।\\\"}],\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-134\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Girua Parshvanath\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/en/tirtha/tirtha-136\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"Shri Dukhbhanjan Parshvanath\\\"}],[\\\"$\\\",\\\"$L1c\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n21:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"mt-auto border-t border-sandstone-deep/60 py-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Original source: Rajendra Kumar Jain, Parshv Sadan, Parshv Nagar, Dungarpur\\\"}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"25:[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"children\\\":\\\"अन्य मंदिर: इस मंदिर के पास भगवान विघ्नहर पार्श्वनाथ का एक सुंदर कलात्मक मंदिर है।\\\"}]\\n26:[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"children\\\":\\\"कला और मूर्तिकला: यह मूर्ति बहुत प्राचीन, कलात्मक और शानदार है। भगवान श्री अंतरिक्ष पार्श्वनाथ की मूर्ति तहखाने में है, मूर्ति सुंदर और आकर्षक है।\\\"}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"children\\\":\\\"दिशानिर्देश: यह तीर्थ निकटतम रेलवे स्टेशन वाशिम 19 किलोमीटर की दूरी पर है और अकोला से 72 किलोमीटर दूरी पर है। शिरपुर गाँव से मालेगाँव हिंगोली-बालापुर मार्ग पर 11 किमी की दूरी पर है। बस सेवा और निजी वाहन उपलब्ध हैं। यहां धर्मशाला और भोजनशाला सुविधाएं उपलब्ध हैं, पास ही एक दिगंबर धर्मशाला भी है।\\\"}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"children\\\":\\\"Scriptures: Mention of Antriksh Parshvanath Lord in \\\\\\\"Vividh Tirtha Kalpa\\\\\\\", \\\\\\\"Prabandha Panchati\\\\\\\", \\\\\\\"Shri Antarik Parshvanath Chhand\\\\\\\", \\\\\\\"365 Shri Parshvanath Jin Nammala\\\\\\\", \\\\\\\"Shri Shankheshwar Parshvanath Chhand\\\\\\\", \\\\\\\"Shri Bhatev Parshvanath Stavan\\\\\\\", \\\\\\\"108 Namgarbhit Sri Godi Ji Parshvanath Stavan\\\\\\\", \\\\\\\"Shri Parshvanath Number Eulogy\\\\\\\", \\\\\\\"Sobhagya Mahavakya\\\\\\\", \\\\\\\"108 Nagarbhit Shri Parshvanath Stavan\\\\\\\", \\\\\\\"Antariksh Parshvanath Stotra\\\\\\\", \\\\\\\"Shri Parshvanath Namamala\\\\\\\", \\\\\\\"Teerthamala\\\\\\\", \\\\\\\"108 Name Verses of Shri Parshvanath Prabhu\\\\\\\" etc. Antriksh Parshvanath is also mentioned in the Marathi text \\\\\\\"Smriti Sthali\\\\\\\" written in the 14th century. The main temple of Shri Antriksh Parshvanath is in Shirpur, Maharashtra. The idol of Antriksh Parshvanath is in Jirawala Tirtha, Bhiladiaji Tirtha, Kalikund Parshvanath Temple in Santa Cruz, Mumbai, Sherisa Tirtha, Kesariyijinagar in Palitana, Shri Sambhavanath Temple in Karad and many other places in India.\\\"}]\\n29:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"children\\\":\\\"Praise: Khar dushane tujhe bharavya nirakhta naino hasne, Shirpur tano shirtaj tu antarikshma adhar wase, tu blind ne kar dekh to dekh mukti barna. \\\\\\\"Shri Antriksh Parshva Ne Bhave Karun Vandana\\\\\\\"\\\"}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"children\\\":\\\"Chant Mantra: “Om Hree Arham Shri Antriksh Parshvanathaya Namah”\\\"}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"children\\\":\\\"Trust: Shri Antarika Parshvanath Shwetambar Jain Tirtha, Sri Antarika Parshvanath Maharaj Sansthan, Post: Shirpur, Taluk: Malegaon, District: Washim - 444504, State: Maharashtra, India. Phone: 0754-234005, Mobile: 9158871999.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[lang]/tirtha/[slug]/layout,_N_T_/[lang]/tirtha/[slug]/page,_N_T_/en/tirtha/tirtha-135"},"segmentPaths":["/_tree","/_full","/$d$lang/tirtha/$d$slug/__PAGE__","/$d$lang/tirtha/$d$slug","/$d$lang/tirtha","/$d$lang","/_index","/_head"],"revalidate":60,"cacheControl":{"revalidate":60,"expire":31536000}}}