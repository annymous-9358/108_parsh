t%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_10109.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>43. श्री चम्पा पार्श्वनाथ</p><p>पता: सालरी वाडो, नारायणजी नो पाडो, गोलवाड, पोस्ट-पाटन-384236</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में परिकर युक्त 21 इंच ऊँची व 19 इंच चौड़ी श्री चम्पा पार्श्वनाथ भगवान की मूर्ति। मूर्ति के सिर के ऊपर 7 नाग के फण की छतरी है।</p><p>तीर्थ: यह पाटन में सालवी वाड़ा के गोलवाड़ शेरी में है।</p><p>ऐतिहासिकता: पाटन शहर की स्थापना वि.सं. 802 में वनराज चावड़ा द्वारा अहनिलपाटन के नाम से की गई थी। यह शहर चावड़ा राजाओं वनराज से सिद्धराज तक प्रसिद्ध रहा है। चावड़ा वंश के राजा जैन धर्म के पालक होने तथा इन राजाओं के मंत्रियों में जैन मंत्री होने के कारण यहाँ हमेशा जैन धर्म का विशेष विकास हुआ। महाराज कुमारपाल के समय तो जैन मंदिरों तथा साहित्य का बहुत ही सर्जन-लेखन हुआ था। महाराज कुमारपाल के समय कालिकाल सर्वज्ञ आचार्य भगवंत श्री हेमचन्द्रसूरी के पाटन शहर आगमन पर अठारहसो कोड़ीध्वज श्रेष्ठी स्वागत यात्रा में उपस्थित थे, इसी से अंदाज़ लगाया जा सकता है कि उस समय पाटन में जैन धर्म की कितनी ख्याति होगी। पाटन शहर अपने प्राचीन जैन मंदिरों के लिए बहुत प्रसिद्ध है। यह बहुत प्राचीन मंदिर महाराजा कुमारपाल के काल में निर्मित है। श्री चंपा पार्श्वनाथ की मूर्ति प्राचीन, प्रभावशाली और चमत्कारी है, जो माना जाता है कि राजा संप्रति के काल की है। एक समय पाटन में लाखों जैन रहते थे और यहां सैकड़ों जैन मंदिर थे। वि.सं. 1356 में मुस्लिम आक्रमण के बाद पाटन को नष्ट कर दिया गया और अधिकांश मंदिरों को नष्ट कर दिया गया था। वर्तमान में बहुत कम प्राचीन मंदिर बचे हैं, इसलिए यह मंदिर 14वीं शताब्दी से भी पुराना माना जाता है। वि.सं. 2043 में इस मंदिर का जिनोद्धार किया गया था। इस पार्श्वनाथ को चम्पा पार्श्वनाथ क्यों कहा जाता है, इसका नामकरण का कोई इतिहास या उल्लेख विवरण उपलब्ध नहीं है।</p><p>दिशानिर्देश: यह मंदिर पाटन रेलवे स्टेशन से 1.5 किमी की दूरी पर है। रेल और सड़क मार्ग से पाटन अच्छी तरह से जुड़ा हुआ है। यहां बस और निजी वाहन उपलब्ध हैं।</p><p>शास्त्र: श्री चंपा पार्श्वनाथ का उल्लेख संवत् 1648 में श्री ललितप्रभसूरी द्वारा रचित &quot;पाटन चैत्य पारिपाटी&quot; में, &quot;पाटन जिनालय स्तुति&quot; में, &quot;365 पार्श्व जिन नाममाला&quot; आदि में किया गया है। चंपा पार्श्वनाथ की एक मूर्ति पालिताना में समवसरण मंदिर में और 108 पार्श्व भक्ति विहार, शंखेश्वर में है।</p><p>स्तुति: जेम पुष्पमा चम्पातणा फूल श्रेष्ठ नाथ गणाय, तेम सृष्टिमा सहु देवोमा तु देवाधिदेव मनाय, तु दिव्य हे, तु भव्य हे, श्रद्धेयने तु ध्येय हे। श्री &quot;चंपा&quot; पार्श्व ने भावे करूं हूं वंदना।</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम् श्री चंपा पार्श्वनाथय नमः&quot;</p><p>ट्रस्ट: श्री चंपा पार्श्वनाथ श्वेतांबर जैन मंदिर, सालवी वाडा, नारायणजी नो पाडो, गोलवाड़ शेरी, मु.पोस्ट: पाटन-384265, जिला: पाटन, उत्तर गुजरात, भारत। फोन: 02766-223604, मोबाइल नं-09898493122।</p><p>(पृष्ठ के अंत में गुजरात के जैन तीर्थों को दर्शाने वाला एक नक्शा &quot;गुजरातना जैन तीर्थों नो नक्शो&quot; भी दिया गया है, जिसमें पाटन क्षेत्र के आस-पास के प्रमुख जैन तीर्थ स्थान अंकित हैं।)</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-059\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Naranga Parshvanath</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/en/tirtha/tirtha-061\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">Shri Mahadeva Parshvanath</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>Original source: Rajendra 