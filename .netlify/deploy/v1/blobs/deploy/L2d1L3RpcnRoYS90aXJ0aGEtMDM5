bkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_8902.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>108 पार्श्वनाथ में से 31 - श्री सुल्तान पार्श्वनाथ</p><p>मूलनायक: सफेद रंग की पद्मासन मुद्रा में लगभग 63 सेंटीमीटर ऊंची भगवान श्री सुल्तान पार्श्वनाथ की मूर्ति है।</p><p>तीर्थ: यह सिद्धपुर के पास मेहसाणा-पालनपुर हाइवे पर सुजापुरा, तुलसी रेस्टोरेंट के सामने है।</p><p>ऐतिहासिकता: सरस्वती नदी के पश्चिमी तट पर बसा सिद्धपुर प्राचीन काल में श्रीस्थल के नाम से जाना जाता था। वी.स. 1184 में सिद्धराज जयसिंह ने 24 छोटे मंदिरों से घिरे एक सुंदर मंदिर का निर्माण किया, जिसे &quot;सिद्धविहार&quot; (&quot;राजविहार&quot; के नाम से भी) कहा गया। उसी समय उनके मंत्री अलिंगदेव ने &quot;चौमुख विहार&quot; नामक एक और मंदिर बनवाया और उसमें भगवान पार्श्वनाथ की मूर्ति स्थापित की। माना जाता है कि यह मूर्ति ही सुल्तान पार्श्वनाथ की है। 16वीं-17वीं शताब्दी में सिद्धपुर में 5 जैन मंदिर और 190 तीर्थंकरों की मूर्तियाँ थीं। इन 5 मंदिरों के मूलनायक श्री नेमिनाथ, श्री सुपार्श्वनाथ, श्री महावीरस्वामी, श्री चंद्रप्रभस्वामी और श्री पार्श्वनाथ भगवान थे। वर्ष 1299 में राजपूताना में रणथंभौर और चित्तौड़ पर विजय प्राप्त करने के बाद दिल्ली के सुल्तान अलाउद्दीन खिलजी 14,000 घुड़सवार सेना और 20,000 पैदल सेना के साथ गुजरात की राजधानी अनहिलवाड़ पाटन पर हमला करने के रास्ते में, कस्बों और मंदिरों को लूटता हुआ, सरस्वती नदी के तट पर स्थित सिद्धपुर पहुंचा।</p><p>धनी शहर की भव्यता देखकर सेना ने मंदिरों में तोड़फोड़ शुरू कर दी। सेना को भोजक (भक्ति गायकों) का एक समूह श्री पार्श्वनाथ भगवान को समर्पित एक प्राचीन मंदिर की रक्षा करते हुए मिला। जब पता चला कि यह 11वीं शताब्दी में सिद्धराज के मंत्री अलिंगदेव द्वारा निर्मित जैन मंदिर था, तो मूर्तिपूजा से नफरत करने वाले खिलजी ने मंदिर को पूरी तरह नष्ट करने का फैसला किया। भोजक ने बार-बार प्रार्थना कर नरसंहार रोकने की भीख मांगी, फिर अलाउद्दीन खिलजी के पास पहुंचकर मूर्ति को नष्ट न करने का अनुरोध किया क्योंकि यह केवल पत्थर की मूर्ति नहीं बल्कि स्वयं भगवान थी। अहंकारी सुल्तान ने भक्तों को देवत्व का प्रमाण दिखाने या मूर्ति के विनाश का गवाह बनने को कहा। भोजक ने शाम को मंदिर में सुल्तान को बुलाकर भगवान के सामने घी से भरे 99 दीपक रखे और भक्ति भजन गाना शुरू किया। जैसे राग चरम पर पहुंचा, अचानक ठंडी हवाएं गर्म हो गईं, खिलजी के माथे पर पसीना आ गया और अंधकार में एक दिव्य प्रकाश चमका, सभी 99 दीपक एक-एक करके स्वयं जलने लगे। फिर भी मूर्ति नष्ट करने के लिए जैसे ही खिलजी ने तलवार खींची, एक फणवाला नागदेवता प्रकट हुआ और उसे एक कदम भी आगे नहीं बढ़ने दिया। अपनी गलती का एहसास कर खिलजी ने प्रभु के सामने झुककर पश्चाताप किया और घोषणा की - &quot;यह स्वामी सुल्तानों का सुल्तान है!&quot; तभी से इस दिव्य मूर्ति का नाम सुल्तान पार्श्वनाथ रखा गया।</p><p>भगवान पार्श्वनाथ की यह मूर्ति राजा संप्रति के काल की है। उस घटना के बाद सुल्तान पार्श्वनाथ की मूर्ति को सिद्धपुर स्थित श्री महावीर स्वामी जिनालय की ऊपरी मंजिल पर ले जाया गया। बाद की शताब्दियों में कई श्रद्धेय आचार्यों ने मूर्ति की दिव्यता के बारे में लिखा और इस तीर्थ को भगवान पार्श्वनाथ के 108 शानदार तीर्थों की सूची में शामिल किया गया। समय के साथ सिद्धपुर का आर्थिक महत्व कम होता गया और जैन पालनपुर व पाटन जैसे समृद्ध केंद्रों में चले गए, जिससे मंदिर जीर्ण-शीर्ण हो गया। आचार्य श्री राजेंद्र सूरीश्वरजी महाराज ने मंदिर ट्रस्ट को मुख्य राजमार्ग पर एक भव्य नया मंदिर बनाने की सलाह दी और वर्षों की मेहनत के बाद 29 नवंबर 2017 को आचार्य विजय राजशेखर सूरीश्वरजी महाराज के मार्गदर्शन में सिद्धपुर में नए मंदिर का कार्य संपन्न हुआ।</p><p>શ્રી સુલતાન પાર્શ્વનાથની મૂર્તિ અન્ય મૂર્તિઓ સાથે બહારના ભાગે નેશનલ હાઈવે પર સ્થિત એક ભવ્ય મંદિરમાં પુનઃસ્થાપિત કરવામાં આવી હતી.</p><p>અન્ય મંદિરોઃ અહીં 2 મંદિરો છે.</p><p>કલા અને શિલ્પના કાર્યો: સિદ્ધપુર ઉત્તર ગુજરાતનું એક પ્રાચીન ઐતિહાસિક શહેર છે. પ્રાચીન સમયમાં તે &#x27;માતૃગયા&#x27; તરીકે ઓળખાતા હિન્દુઓ માટે ખૂબ જ પ્રખ્યાત તીર્થસ્થાન હતું. શેઠ ધરનાશાહ દ્વારા બંધાયેલ રાણકપુરનું પ્રસિદ્ધ મંદિર (ત્રૈલોક્ય દીપક પ્રસાદ અથવા ધર્મ વિહાર) અલિંગદેવ દ્વારા બંધાયેલા &#x27;ચૌમુખ વિહાર&#x27; મંદિર પર આધારિત હતું. મંદિરો ખૂબ જ સુંદર અને કલાત્મક રીતે બાંધવામાં આવ્યા હતા.</p><p>દિશા-નિર્દેશો: સિદ્ધપુર રેલ અને માર્ગ દ્વારા સારી રીતે જોડાયેલ છે. મંદિરથી સિદ્ધપુર રેલ્વે સ્ટેશન 3 કિલોમીટરના અંતરે છે. સિદ્ધપુરથી મેત્રાણ તીર્થ 13 કિલોમીટરના અંતરે છે અને તારંગા તીર્થ 45 કિલોમીટરના અંતરે છે. અહીં ધર્મશાળા અને ભોજનશાળાની સુવિધાઓ ઉપલબ્ધ છે, ત્યાં 3 પેટા આશ્રયસ્થાનો છે.</p><p>શાસ્ત્ર: સુલતાન પાર્શ્વનાથનો ઉલ્લેખ &#x27;સિદ્ધપુર ચૈત્ય પરિપતિ&#x27;માં, &#x27;તીર્થમાલા&#x27;માં, &#x27;365 શ્રી પાર્શ્વ જિન નમલા&#x27;માં, &#x27;શંખેશ્વર પાર્શ્વનાથ છંદ&#x27;માં, &#x27;108 નામ ગર્હિત શ્રી પાર્શ્વનાથ સ્તવન&#x27;, &#x27;પાર્શ્વનાથ ચૈત્યપતિ&#x27; વગેરેમાં કરવામાં આવ્યો છે.</p><p>સ્તુતિ: તમે જગતના રાજા છો, મુલતાનમાં છો તે તું જ છે, તારી ભક્તિ સમયે, મને સિદ્ધપુર મંડન પ્રભુની સફળતા આપનાર તું જ છે. &#x27;હું શ્રી સુલતાન પ્રભુ પાર્શ્વને ભાવેને નમન કરું છું...&#x27;</p><p>મંત્રનો જાપ કરો: &#x27;ઓમ હી અર્હ શ્રી મનોરંજન પાર્શ્વનાથાય નમઃ&#x27;</p><p>ટ્રસ્ટ: શ્રી સિદ્ધપુર શ્વેતાંબર જૈન મૂર્તિપૂજક સંઘ, પોસ્ટ: સિદ્ધપુર, જિલ્લો: પાટણ, ગુજરાત. મોબાઈલ: 09429891850.</p><p>પુરુષદાનીય અર્હત પાર્શ્વનાથ ચરિત્ર ભાગ-1 (માતા વામાદેવીના ગર્ભમાં ભગવાન પાર્શ્વનાથનો જીવ): તે સમયે અને સમયે, પુરૂષદાનીય અર્હત પાર્શ્વ, ઉનાળાના પહેલા મહિનાના ફાગણ વદ 4ના દિવસે, પ્રથમ પખવાડિયું એટલે કે ફાગણ મહિનાના કૃષ્ણ પક્ષને પ્રજ્ઞાચક્ષુ નામની પ્રજ્ઞાચક્ષુ તરીકે ઓળખવામાં આવે છે. સાગરોપમના આયુષે, દિવ્ય અન્ન, દિવ્ય જન્મ, દિવ્ય શરીરનો ત્યાગ કરીને તરત જ આ જમદ્વીપમાં ભારતવર્ષની ભૂમિનું સેવન કર્યું. વારાણસી શહેરમાં, ચ્યવનનો જન્મ વિશાખા નક્ષત્રના સંયોગમાં મધ્યરાત્રિના સમયે રાજા અશ્વસેનની રાણી વામાદેવીના ગર્ભમાં થયો હતો.</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-037\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી મનોરંજન પાર્શ્વનાથ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/gu/tirtha/tirtha-041\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">શ્રી દોહલા પાર્શ્વનાથ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-4 w-4\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></nav></div></main><footer class=\"mt-auto border-t border-sandstone-deep/60 py-8\"><div class=\"mx-auto max-w-6xl px-5 font-ui text-xs text-ink-soft flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between\"><p>१०८ पार्श्वनाथ तीर्थ दर्शन — श्री पार्श्वनाथ भगवान के तीर्थों का डिजिटल संकलन</p><p>મૂળ સ્રોત: રાજેન્દ્ર કુમાર જૈન, પાર્શ્વ સદન, પાર્શ્વ નગર, ડુંગરપુર</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/40e0f9pufs6g4.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_