ps%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11114.jpeg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=https%3A%2F%2Fiiudzezqkqtqcxbkssdq.supabase.co%2Fstorage%2Fv1%2Fobject%2Fpublic%2Ftirtha-images%2Fimg_11114.jpeg&amp;w=3840&amp;q=75\"/></div></div><article class=\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\"><p>52. श्री शंखला पार्श्वनाथ</p><p>मूलनायक: मूलनायक शांतिनाथ भगवान हैं। श्री भगवान शांतिनाथ के दाईं तरफ उच्च काले रंग की पद्मासन मुद्रा में 27 इंच ऊँची व 19 इंच चौड़ी भगवान श्रीशंखला पार्श्वनाथ की मूर्ति है। मूर्ति के सिर पर 7 नागफण का एक छत्र है।</p><p>तीर्थ: यह शंखलपुर गाँव के केंद्र, पाटीदार महाजन के मोहल्ले में है।</p><p>ऐतिहासिकता: संभलपुर एक प्राचीन और बहुत समृद्ध शहर था। राजा लखमन ने इसकी स्थापना की थी और इसका नाम सालखनपुर रखा गया। 14वीं और 17वीं शताब्दी के बीच जैन समुदाय इस शहर पर अपना एकाधिकार रखते थे। वे धनी, धार्मिक और समृद्ध थे। इस अवधि के दौरान जैनों के 2 सुंदर मंदिर, भगवान शांतिनाथ और भगवान पार्श्वनाथ, का निर्माण मांडवगढ़ के मंत्री पेथडशाह ने करवाया था। मंदिर नष्ट हो गए (कारण ज्ञात नहीं) लेकिन भगवान की मूर्तियों की सुरक्षा के लिए उन्हें छिपाकर रखा गया था। वि.सं. 1848 में एक लुटेरा रातेज से तीर्थंकरों की 2 मूर्तियों को चुराकर शंखलपुर आ गया। एक जैन श्रावक ने उससे ये मूर्तियाँ खरीदीं। उन्होंने एक मूर्ति अपने पास रखी और दूसरी मूर्ति तुवद गाँव के जैन संघ को दे दी। उन्होंने मंदिर बनाने के लिए एक पुरानी खंडहर वाली जगह खरीद ली। उस जगह की खुदाई करते समय भूमि से उन्हें तीर्थंकरों व देवी-देवता की कई मूर्तियाँ, मंदिर के शिखर और कई अन्य मंदिरों के खण्डहर मिले जो नष्ट हो गए थे। यहाँ से कई मूर्तियों को कदमगिरी तीर्थ पर ले जाया गया और कई अन्य मंदिरों में भी। इससे पता चलता है कि इस गाँव में कई जैन मंदिर थे जिन्हें नष्ट कर दिया गया था और उनकी मूर्तियों को सुरक्षा के लिए छिपाकर रखा गया था। 3 शिखर वाला एक नया मंदिर बनाया गया और शांतिनाथ भगवान की मूर्ति को वि.सं. 1905 में जेठ वद महीने के 8वें दिन मूलनायक के रूप में स्थापित किया गया। हर साल इस दिन ध्वज फहराया जाता है।</p><p>यहां स्थापित भगवान पार्श्वनाथ की प्राचीन और प्रभावशाली मूर्ति को गाँव के नाम से &quot;शंखला पार्श्वनाथ&quot; के नाम से जाना जाता है। मंदिर बहुत ही चमत्कारी और प्रभावशाली है। मंदिर के तहखाने में एक नवखण्डा पार्श्वनाथ की मूर्ति है जो बहुत ही चमत्कारी और शानदार है। कई बार नवखण्डा पार्श्वनाथ की मूर्ति के ऊपर केसर का लेप किया हुआ पाया जाता है। कई बार, जब कोई भक्त मंदिर में प्रवेश करता है तो उसे एक सुंदर खुशबू आ रही होती है, और खोजने पर पाया जाता है कि मूर्ति के सामने सुगंध से भरे सुंदर फूलों की वर्षा हुई होती है। कई बार शाम के दौरान आरती की घंटी अपने आप बजती है और घंटी की धुन दूर-दूर तक सुनाई देती है। एक बार एक चकोर चांदी का सिक्का नवखण्डा पार्श्वनाथ की मूर्ति के पास मिला था। यहां ऐसे चमत्कार होते रहते हैं। कई सालों से एक &quot;अखंड दीपक&quot; नवखंडा पार्श्वनाथ की मूर्ति के सामने रखा जाता है। यहाँ तीर्थंकरों की 25 से अधिक मूर्तियाँ हैं, जो सभी प्राचीन, सुंदर और आकर्षक हैं।</p><p>दिशानिर्देश: बेचराज़ी रेलवे स्टेशन से शंखलपुर 2 किमी की दूरी पर है। हाल ही में शंखलपुर एक फ्लैग स्टेशन बन गया है। यहाँ 2 उपाश्रय हैं। रातेज, शंखेश्वर, भोयानी तीर्थ यहाँ से पास में हैं।</p><p>शास्त्र: शंखला पार्श्वनाथ का उल्लेख &quot;तीर्थमाला&quot;, &quot;108 नाम गर्भित श्री गोड़ीजी पार्श्वनाथ स्तवन&quot;, &quot;गुरुवली&quot;, &quot;108 नाम गर्भित श्री संकेश्वर पार्श्वनाथ छंद&quot;, &quot;कोचर विहारी रास&quot; आदि में किया गया है। शंखला पार्श्वनाथ की एक मूर्ति जीरवाला तीर्थ में और मुंबई के सांताक्रूज़ में कलीकुंड पार्श्वनाथ मंदिर में है।</p><p>स्तुति: हे नाथ हसतु मुख तमारू, निरखतां मूँज पीड़ा टळे, छो साथ अक्षयपद प्रदाता, तुज थकी मुझ भव कटे, हे देवा राज्य विशाल तमारू, शिवनगरनु आपजो। &quot;श्री शँखला पार्श्व ने भावे करूं हुं वंदना&quot;</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम् श्री शँखला पार्श्वनाथाय नमः&quot;</p><p>ट्रस्ट: श्री शंखला पार्श्वनाथ श्वेतांबर जैन तीर्थ, पाटीदार महाजन की गली, डाक: शंखलपुर, स्टेशन: बेचराज़ी, तालुक: चनाश्मा, जिला: मेहसाणा, राज्य: गुजरात-384210, भारत। फोन: 02734-284408।</p><p>पार्श्वनाथ भगवान की स्तुति: श्री शंखेश्वर पार्श्वप्रभु समरुं, अरिहंत अनंत नुं ध्यान धरुं; जिणागम अमृत पान करुं, शासनदेवी सवि विध्न हरुं। राजेन्द्र कुमार जैन का जय जिनेन्द्र।</p><p>53. श्री गाडलीया पार्श्वनाथ</p><p>पता: मु.पो.-मंडल, तालुका-वीरमगाम-382130, ज़िला अहमदाबाद</p><p>मूलनायक: 10 इंच ऊंची व 6.25 इंच चौड़ी सुन्दर परिकर-युक्त सफ़ेद भगवान श्री गाडालिया पार्श्वनाथ की मूर्ति पद्मासन मुद्रा में है। मूर्ति के सिर के ऊपर नाग के 7 फणों की छतरी है।</p><p>तीर्थ: यह मंडल गाँव के केंद्र में गाँधीवास में है।</p><p>ऐतिहासिकता: मंडल एक प्राचीन गाँव है जिसका ऐतिहासिक महत्व है। यह महान मंत्री वस्तुपाल व तेजपाल का जन्मस्थान है जो जैन धर्म में अपने योगदान के लिए बहुत जाने जाते हैं। उनके द्वारा गुजरात में कई मंदिरों का निर्माण किया गया था। माउंटआबू के पास विश्व प्रसिद्ध दिलवाड़ा मंदिर भी उन्हीं के द्वारा बनाया गया था। उनके द्वारा साढ़े बारह छ:री-पालित महासंघ यात्रा शत्रुंजय महातीर्थ तक ले गए थे। प्राचीन काल में यह जैनियों के सबसे प्रसिद्ध और पवित्र तीर्थों में से एक, श्री गाडलिया पार्श्वनाथ के नाम से जाना जाता था।</p><p>कई अलग-अलग नाम जैसे &quot;गालिया पार्श्वनाथ&quot;, &quot;गरालिया पार्श्वनाथ&quot; आदि प्राचीन स्तवनों में इस पार्श्वनाथ को &quot;गदर, गादारी और गराडिया पार्श्वनाथ&quot; के रूप में संदर्भित किया गया है। इस प्रतिमा का पद्मासन (गाडी) गाल्ली (गाड़े) के आकार का होने से प्रभु गाडलिया पार्श्वनाथ के नाम से प्रख्यात है।</p><p>मंडल गाँव वस्तुपाल तेजपाल की जन्मभूमि भी है। आधी-व्याधि के विष के निवारण के लिए गारुडी मंत्र समान होने से यह प्रतिमा गारड़िया पार्श्वनाथ के नाम से भी प्रसिद्ध है। इस प्राचीन, आकर्षक, प्रभावशाली और चमत्कारी मूर्ति की महिमा अनंत है। यह मूर्ति राजा संप्रति काल की है। वर्तमान मंदिर वि.सं. 1875 के आसपास बनाया गया था। प्रति वर्ष माघ मास के शुक्लपक्ष के 5वें दिन ध्वजा फहराई जाती है।</p><p>दिशानिर्देश: यहां का निकटतम रेलवे स्टेशन विरगाम 25 किलोमीटर की दूरी पर है। यहां से शंखेश्वर पार्श्वनाथ 35 किलोमीटर की दूरी पर है। यहां धर्मशाला और भोजनशाला की व्यवस्था है परन्तु भोजनशाला हेतु पूर्व में सुचित करना होगा।</p><p>शास्त्र: श्री गाडलिया पार्श्वनाथ का उल्लेख वि.सं. 1665 में श्री प्रेमविजयजी द्वारा रचित &quot;365 श्री पार्श्वजिन नाममाला&quot; में तथा संवत 1656 के आसो वद 9 मंगलवार को कवि नयसुन्दर द्वारा रचित &quot;श्री शंखेश्वर पार्श्वनाथ छंद&quot; में किया गया है।</p><p>स्तुति: मांडल मंडल प्रभु! मुझ आत्मा अजवालजो, को गारूड़ी मंत्र फूकिने मोहविष उतारजो, जे दुर्गति पंथे जतु मुझ गाडु पाछु वालता। &quot;श्री गाडलिया पार्श्व ने भावे करूं हुं वंदना&quot;</p><p>जाप मंत्र: &quot;ॐ ह्री अर्हम् श्री गाडलिया पार्श्वनाथाय नमः&quot;</p><p>ट्रस्ट: श्री गाडलिया पार्श्वनाथ श्वेतांबर जैन तीर्थ, पोस्ट: मांडल, ता. वीरमगाम, जिला: अहमदाबाद। मोबाइल: 9898422903/7600584235।</p><p>आनंद, प्रेम व करुणा के महासागर: विश्वशांति के मूलाधार, समाधि के परम साधक, आनंद, प्रेम व करुणा के महासागर। घाती चतुष्क का क्षय कर समस्त तीर्थंकर परमज्योति स्वरूप बनते हैं, अष्टमहाप्रातिहार्य की शोभा के वे स्वामी बनते हैं। जब वे धरती पर चलते हैं तब नवनीत समान नव सुवर्ण पद्म उनके चरणारविंद के अधोभाग में स्थापित हो जाते हैं। वायु भी अनुकुल होकर उन्हें परम शाता अर्पण करती है। पक्षीगण भी इस महाज्योति की प्रदक्षिणा करते हैं। प्रकृति की महासत्ता के इस सम्राट की सेवा में समस्त ऋतु एक ही साथ उपस्थित हो जाती हैं। इस प्रचंड प्रभावी मूर्ति के समक्ष करोड़ों देवी-देवता उपस्थित हो जाते हैं। उनके आगमन से गगनमंडल आच्छादित हो जाता है। जिस प्रकार तीर्थंकरों का ऐश्वर्य समान होता है उसी प्रकार गुणों का पूर्णत्व भी समान होता है, परंतु आदेय नाम कर्म की प्रबलता के कारण तेईसवें तीर्थपति श्री पार्श्वनाथ स्वामी अन्य तीर्थंकरों से भिन्न हैं। अतः आगम शास्त्रों में श्री पार्श्वनाथ प्रभु के लिए पुरुषादानीय इस विशेषण का विनियोग सुविदित है। अज्ञानकष्ट करते कमठयोगी की धूनी से अर्धजले सर्प को निकाल कर पार्श्वकुमार ने नवकार मंत्र द्वारा उसे अद्भुत समाधि प्रदान की। इसी कारण धरणेन्द्र बनी वह दिव्य आत्मा अपने परमोपकारी परमात्मा के प्रभाव की वृद्धि की व्यासंगी बनी है। श्री पार्श्वनाथ शासन की सैंकड़ों साध्वियाँ अब देवी रुप से परमात्मा के प्रभाव के लिए सदैव यत्नशील हैं, ऐसी मान्यता है। कारण कुछ भी हो, एक सत्य स्पष्ट है - श्री पार्श्वनाथस्वामी के प्रति सब के मन में विशेष आकर्षण है। भारत के सर्वाधिक जिनालयों में मूलनायक के पद पर श्री पार्श्वनाथस्वामी बिराजमान हैं। प्राचीनतम तीर्थ एवं बिंब भी पार्श्वनाथ प्रभु के ही ज्यादा हैं। श्री शंखेश्वर पार्श्वनाथ, श्री स्थंभन पार्श्वनाथ, श्री चारुप पार्श्वनाथ, श्री अजाहरा पार्श्वनाथ आदि बिंबों की गणना विद्यमान प्राचीन बिंबों में होती है। आज भी भारतभर के श्री पार्श्वनाथ प्रभु के सैंकड़ों जिनालयों में रात्रि के समय दैवी नृत्य, संगीत एवं वाद्यसंगीत की ध्वनि सुनाई देती है। अनेक जिनालयों में प्रायः अमीवृष्टि, अमीझरन, केसरवृष्टि, सुगंधव्याप्ति आदि चमत्कारों का अनुभव होता है।</p><p>तीर्थंकर पार्श्वनाथ तो एक ही हैं, परंतु विभिन्न स्थानों पर बिराजमान उनके बिंबों की विविध प्रभावकता के अनुरुप उनके विविध नाम प्रचलित हुए हैं। कई नामों का आश्रयस्थान प्रभाव है, तो कई नामों का आधार मूर्ति की मनोहारिता है। अनेक प्राचीन ग्रंथों, काव्यों, तीर्थकल्पों एवं छंद, रास, स्तोत्र, स्तवनों में भी श्री पार्श्वनाथस्वामी के विविध नाम प्राप्त होते हैं। पार्श्वनाथस्वामी के शताधिक तीर्थ आज भी उपलब्ध हैं। भिन्न भिन्न 108 पार्श्वनाथ प्रभु की प्रतिकृति, प्रभाव एवं विस्तृत इतिहास आज भी उपलब्ध है। दस भव की मोक्षयात्रा में पद-पद पर खड़ी विकट परिस्थिति में भी समाधि रसायन द्वारा आत्मा को कलुषित बनने से रोकने के हेतु समाधि के परम साधक का यह कवच सब जीवों के लिए समाधि प्रदाता बनें।</p><p>54. श्री शेरीसा पार्श्वनाथ (आरंभ)</p><p>मूलनायक: काले रंग की पद्मासन मुद्रा में लगभग 165 सेमी ऊँची भगवान श्री शेरीसा पार्श्वनाथ की मूर्ति है। यह मूर्ति एक ही पत्थर से बनाई गई है।</p><p>तीर्थ: यह शेरिसा गाँव में है।</p><p>ऐतिहासिकता: यह मंदिर 12वीं शताब्दी का है। भगवान शेरिसा पार्श्वनाथ की इस सुंदर और रमणीय मूर्ति की उत्पत्ति के पीछे एक बहुत ही दिलचस्प कहानी है। शेरिसा गांव की प्राकृतिक सुंदरता को देखकर आचार्य श्री देवेंद्रसूरीश्वरजी को बहुत खुशी हुई और उन्हें लगा कि यह स्थान आध्यात्मिक प्रयासों के लिए सही है। अपने दिव्य ज्ञान के द्वारा उन्होंने गाँव में जमीन के नीचे एक विशाल पत्थर पड़ा देखा और सोचा कि भगवान की एक सुंदर मूर्ति उस पत्थर से उकेरी जा सकती है। इसलिए उन्होंने तीन दिनों के उपवास (अठ्ठम तप) से देवी पद्मावती की उपासना की। देवी पद्मावती उनके सामने प्रकट हुईं और उन्हें मूर्ति बनाने हेतु संकेत दिए। तदनुसार सोपारक गांव के एक अंधे मूर्तिकार को बुलाया गया। इस अंधे मूर्तिकार ने पत्थर से सूर्यास्त के बाद एक सुंदर मूर्ति को तराशना शुरू कर दिया, जो जमीन के नीचे से मिला था। सूर्योदय से पहले पार्श्वनाथ की एक मनोरम मूर्ति को एक ही रात में उकेरा गया। उसी रात आचार्यजी ने अपनी दिव्य शक्तियों द्वारा अयोध्या से तीर्थंकरों की चार अन्य मूर्तियों को लाने के बारे में सोचा। तीन मूर्तियाँ सूर्योदय से पहले शेरिसा के पास पहुँचीं और एक मूर्ति धरासेनक गाँव में स्थापित की गई। तीर्थंकरों की चौबीस मूर्तियों को शेरिसा के पास लाया गया, और कुमारपाल महाराजा को भी इस मंदिर के लिए एक आकर्षक मूर्ति मिली। इन सभी मूर्तियों को आचार्य श्री देवेंद्रसूरीश्वरजी ने एक विशाल मंदिर में स्थापित किया। अंधे मूर्तिकार द्वारा नक्काशी की गई मूर्ति को &quot;शेरिसा पार्श्वनाथ&quot; के रूप में जाना जाता है। पार्श्वनाथ की मूलनायक मूर्ति डांवांडोल हो रही थी, इसलिए यह &quot;लोढ़न पार्श्वनाथ&quot; के रूप में भी जानी जाती है। आचार्य की दिव्य शक्तियों से मूर्ति ने डांवाडोल होना बंद कर दिया और दृढ़ रही। 13वीं शताब्दी में महामंत्री तेजपाल ने इस मंदिर में दो देवकुलिकाएँ बनवाईं, जिनमें से एक में परिकर सहित नेमिनाथ भगवान की मूर्ति स्थापित की गई (विवरण आगे के पृष्ठों में जारी है)।</p></article><nav class=\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\"><a class=\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-071\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री शंखेश्वरा पार्श्वनाथ</span></a><a class=\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\" href=\"/hi/tirtha/tirtha-073\"><span class=\"max-w-[10rem] truncate sm:max-w-xs\">श्री शेरिसा पार्श्वनाथ</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\