peg\\\",\\\"alt\\\":\\\"શ્રી લોઢણ પાર્ષ્વનાથ फोटो 3\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}],[\\\"$\\\",\\\"div\\\",\\\"1c5d589c-c2ac-49ce-a185-e7e4f3328922\\\",{\\\"className\\\":\\\"relative overflow-hidden rounded-sm bg-sandstone-deep/30 aspect-square\\\",\\\"children\\\":[\\\"$\\\",\\\"$L25\\\",null,{\\\"src\\\":\\\"https://iiudzezqkqtqcxbkssdq.supabase.co/storage/v1/object/public/tirtha-images/img_6002.jpeg\\\",\\\"alt\\\":\\\"શ્રી લોઢણ પાર્ષ્વનાથ फोटो 4\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(min-width: 640px) 33vw, 50vw\\\",\\\"className\\\":\\\"object-cover\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"prose-none space-y-4 font-body text-[1.05rem] leading-[1.85] text-ink\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"મૂળનાયક: શ્રી શીતલનાથ ભગવાનના મંદિરના તહખાણામાં હાઇબ્લેક રંગના પાષાણની અર્ધ પદ્માસન મુદ્રામાં ૪૧ ઇંચ ઊંચી અને ૩૩ ઇંચ પહોળી ભગવાન શ્રી લોઢણ પાર્ષ્વનાથની મૂર્તિ છે. મૂર્તિના સિર ઉપર ૭ નાગના ફણની છત્રી છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"તીર્થ: આ દાભોઇ શહેરમાં શામળાજી ની શેરીમાં છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"ऐतिहासिकता: આ શાનદાર અને કલાત્મક મૂર્તિનો ઇતિહાસ ખૂબ જ રસપ્રદ છે. સાગરદત્ત શ્રેષ્ઠી વ્યવસાય કરવા માટે પોઠી (બેલ) પર સામાન ભરીને એક ગામથી બીજા ગામ જતા હતા. એકવાર જ્યારે તે દરભાવતી શહેરમાં આવ્યા અને ચાતુર્માસ શરૂ થયા પછી અહીં રોકાયા. તેમણે તીર્થંકર પરમાત્માની પૂજા કર્યા પછી જ ભોજન કરવાનો સંકલ્પ લીધો હતો. આથી, તેમની માતાની સલાહ પર, તેમણે બાલુથી બનેલા પાર્શ્વનાથ ભગવાનની આકર્ષક મૂર્તિ મેળવી અને તેને પોતાના ઘરના મંદિરમાં સ્થાપિત કરી. તે મોટી આસ્થા અને ભક્તિથી દરરોજ આ મૂર્તિની પૂજા કરતા હતા. ચાતુર્માસ પૂર્ણ થયા પછી, તેને પોતાના ગૃહનગર પાછા ફરવું પડ્યું, આથી તેમણે આ મૂર્તિને શહેરના મધ્યમાં એક કૂવામાં પધરાવી દીધી. થોડા વર્ષો પછી, સાગરદત્ત ફરીથી વ્યવસાય માટે દરભાવતી આવ્યા. મધ્યરાત્રિમાં તેમને એક સપનું આવ્યું, જ્યાં એક દિવ્ય વાણીએ તેને ભગવાન પાર્શ્વનાથની મૂર્તિને તે કૂવામાંથી બહાર કાઢવા કહ્યું જ્યાં તેણે તેને મૂક્યું હતું. સવારે, તેમણે જૈન સમુદાયના લોકોને મૂર્તિને કૂવામાંથી બહાર કાઢવામાં મદદ કરવા કહ્યું.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"children\\\":\\\"એક યુવા અવિવાહિત છોકરી (કુંવારી કન્યા) દ્વારા ધાગે સાથે જોડાયેલી એક છલનીમાં મૂર્તિને કૂવામાંથી સફળતાપૂર્વક ઉપાડી લેવામાં આવી હતી. મૂર્તિને એક બળદગાડીમાં મૂકવામાં આવી હતી, કોઈએ બળદગાડીનું માર્ગદર્શન કર્યું નહોતું અને ગાડી આગળ વધવા લાગી. તે નક્કી કરવામાં આવ્યું કે મંદિર ત્યાં બનાવવામાં આવશે જ્યાં ગાડી રોકાશે. બળદગાડીના રોકાતા સ્થાન પર એક મંદિર બનાવવામાં આવ્યું હતું અને તેમાં મૂર્તિ સ્થાપિત કરવામાં આવી હતી. રેતીમાંથી બનેલી આ મૂર્તિ લાંબા સમય સુધી ગહના પાણીમાં રહી હતી પરંતુ રેતીનો એક પણ કણો નીકળ્યો નહોતો અને મૂર્તિ લોખંડની જેમ સખત થઈ ગઈ હતી, તેથી આ મૂર્તિને \\\\\\\"લોઢણ પાર્ષ્વનાથ\\\\\\\" તરીકે ઓળખવામાં આવે છે. આ મૂર્તિ 600 વર્ષથી વધુ જૂની છે. આ મંદિરનું છેલ્લું વિક્રમ સંવત 1990માં પુનઃનિર્માણ કરવામાં આવ્યું હતું. જેમ કે ભગવાન પાર્ષ્વનાથની મૂર્તિ રેતી (વેલુ)થી બનેલી છે, તેથી મૂર્તિને \\\\\\\"શ્રી વેલુ પાર્ષ્વનાથ\\\\\\\" નામથી પણ ઓળખવામાં આવે છે. મહોપાધ્યાય શ્રી યશોવિજયજી મ.સા. વિ.સં. 1743માં આ જ નગરીમાં હતા. આ એક ખૂબ જ ચમત્કારી મૂર્તિ છે\\\"}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"children\\\":\\\"ભગવાન શ્રી લોઢણ પાર્ષ્વનાથની આ પ્રભાવશાળી મૂર્તિના ચૈત્યવંદનને મોટી આસ્થા અને ભક્તિથી કરનાર એક મહિલા ધરણેન્દ્ર દેવ (નાગદેવ)ના દર્શનથી ધન્ય થઈ ગઈ.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"5\\\",{\\\"children\\\":\\\"અન્ય મંદિર: નજીકમાં શામળા પાર્ષ્વનાથનું પ્રાચીન મંદિર છે. અહીં ૩ અન્ય મંદિરો છે. જેમ કે તેના પૂર્વે ૦૮માં શ્રી પ્રગટપ્રભાવી પાર્ષ્વનાથની માહિતી આપી હતી, તે પણ ડભોઈમાં શ્રીમાળી વાગમાં છે, તેથી અહીં ૧૦૮માંથી બે પાર્ષ્વનાથના દર્શન-પૂજનનું લાભ મળે છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"children\\\":\\\"કલા અને મૂર્તિકલાના કાર્ય: જોકે આ મૂર્તિ રેતીમાંથી બનેલી છે, પરંતુ તે લોખંડમાંથી બનેલી જેવી દેખાય છે. તેની કલાત્મકતા અદ્ભુત છે અને આંખને નયનમાં બસવાની છે.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"children\\\":\\\"दिशानिर्देश: નજીકનું રેલ્વે સ્ટેશન દાભોઇ છે, જે 2 કિલોમીટરના અંતરે આવેલું છે. દાભોઇ રેલ્વે સ્ટેશનથી વડોદરા 32 કિલોમીટરના અંતરે છે. વડોદરાથી છાણી તીર્થ (108 શ્રી વિમલ પાર્ષ્વનાથ) 8 કિમી દૂર છે. મણીલક્ષ્મી તીર્થથી છાણી 57 કિમી દૂર છે. બસો, ટેક્સી અને ઓટોરિક્ષા વાહનો અહીં ઉપલબ્ધ છે. ધર્મશાળા અને ભોજનશાળાની સુવિધાઓ અહીં ઉપલબ્ધ છે. પ્રાચીન કાળથી, દાભોઇ જૈનોના માટે એક મહાન કેન્દ્ર રહ્યું છે. અહીં ઘણા મંદિરો, ઉપાશ્રય, આયંબિલશાળા અને જ્ઞાનભંડાર છે. હેરાનો કિલ્લો-ભાગોળ અહીંનું એક ઐતિહાસિક મહત્વનું સ્થળ છે.\\\"}],\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"className\\\":\\\"mt-14 flex items-center justify-between border-t border-sandstone-deep/60 pt-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/gu/tirtha/tirtha-010\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L22\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15 18-6-6 6-6\\\",\\\"key\\\":\\\"1wnfg3\\\"}]],\\\"className\\\":\\\"lucide-chevron-left h-4 w-4\\\",\\\"aria-hidden\\\":true}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"શ્રી પ્રગટપ્રભાવી પાર્ષ્વનાથ\\\"}]]}],[\\\"$\\\",\\\"$L5\\\",null,{\\\"href\\\":\\\"/gu/tirtha/tirtha-012\\\",\\\"className\\\":\\\"group flex items-center gap-1.5 text-right font-ui text-sm text-ink-soft hover:text-maroon transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"max-w-[10rem] truncate sm:max-w-xs\\\",\\\"children\\\":\\\"શ્રી વિમલ પાર્ષ્વનાથ\\\"}],[\\\"$\\\",\\\"$L22\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\",\\\"key\\\":\\\"mthhwq\\\"}]],\\\"className\\\":\\\"lucide-chevron-right h-4 w-4\\\",\\\"aria-hidden\\\":true}]]}]]}]\\n21:[\\\