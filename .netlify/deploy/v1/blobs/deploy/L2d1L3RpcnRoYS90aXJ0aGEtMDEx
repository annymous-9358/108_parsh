આર્તધ્યાન વશ આયુષ્ય પૂર્ણ થતાં મરુભૂતિનો જીવ વિંધ્યાચલ પર્વતમાળામાં હાથીઓના સ્વામી યુથપતિ ગજરાજના રૂપમાં જન્મ લીધો. કમઠની પત્ની વરુણા મૃત્યુ પામી યુથપતિ ગજરાજની પ્રિય હતીની બની. બીજી તરફ રાજાને કમઠ દ્વારા પોતાના ભાઈ મરુભૂતિની હત્યાનો સમાચાર મળતાં રાજાને આ સ્વાર્થપરાયણ સંસારથી વૈરાગ્ય થયું અને રાજાએ મુનિ દીક્ષા લઈ સંયમ ગ્રહણ કરી વિંધ્યાચલ પર્વતમાળામાં જઈ ઉત્કૃષ્ટ સાધના કરવાનું શરૂ કર્યું. એક દિવસ જ્યારે રાજા (મુનિ) આ વિંધ્યાચલ પર્વતમાળામાં ધ્યાનમુદ્રામાં ઊભા હતા, ત્યારે મરુભૂતિનો જીવ જે ગજરાજ બનેલો હતો તે ત્યાં આવ્યો અને મુનિને ધ્યાનમુદ્રામાં જોઈ મરુભૂતિને જાતિસ\"])</script><script>self.__next_f.push([1,\"્મરણજ્ઞાન થયું. જાતિસ્મરણમાં પોતાના પૂર્વજન્મને સ્મરતાં ગજરાજે મુનિની પાસે શ્રાવક ધર્મને સ્વીકાર્યો.\\\"}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"children\\\":\\\"એકવાર વિંધ્યાચલના વનોમાં ભયંકર અગ્નિપ્રકોપ થયો જેમાં સારું વન બળવા લાગ્યું, ત્યારે ગજરાજ પોતાનું જીવન બચાવવા માટે એક સરોવરના પાણીમાં ઉતરી ઊભો રહ્યો.\\\"}]\\n2c:[\\\"$\\\",\\\"p\\\",\\\"14\\\",{\\\"children\\\":\\\"તે જ સમયે કમઠનો જીવ જે મરીને કુર્કટ જાતિનો સાપ બન્યો હતો, તે આકાશમાર્ગે જતાં તેની દૃષ્ટિ સરોવરમાં ઊભેલા ગજરાજ પર પડી; તેની દૃષ્ટિ ગજરાજ પર પડતાં જ કમઠના જીવને કુર્કટ સાપને વેર (દુષ્મની) ભાવ જાગૃત થયો અને ક્રોધવશ હાથીના માથે ડંક મારી દીધો. ડંકના ઝેરથી ગજરાજનું સંપૂર્ણ શરીર વિષમય બની ગયું પરંતુ ગજરાજે સમભાવપૂર્વક વેદના સહન કરી સમભાવમાં જ આયુષ્ય પૂર્ણ કર્યું (બીજો ભવ). ત્રીજો ભવ સહસ્ત્રાર દેવ - શ્રાવક ધર્મના પાલનની પ્રતિજ્ઞા કરવાથી અને સમભાવપૂર્વક રહીને આયુષ્ય પૂર્ણ કર્યાથી મરૂભૂતિનો જીવ આઠમાં દેવલોકમાં સહસ્ત્રાર નામનો દેવ ઉત્પન્ન થયો (ત્રીજો ભવ). આ મૂર્તિ સ્થળ ૦૮- શ્રી લોઢણ પાર્ષ્વનાથ પ્રભુ મંદિર, ડભોઈ (દરભાવતી)ના રૂપમાં ઓળખાય છે.\\\"}]\\n\"])</script></body></html>","rscData":"","segmentData":{"/_tree":"","/_full":"","/$d$lang/tirtha/$d$slug/__PAGE__":"","/$d$lang/tirtha/$d$slug":"","/$d$lang/tirtha":"","/$d$lang":"","/_index":"","/_head":""},"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tirtha/layout,_N_T_/[la